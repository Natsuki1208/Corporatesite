---
import '../styles/v2-site.css';
import '../styles/v2-enhancements.css';
import '../styles/v2-immersive-motion.css';
import '../styles/v2-brand-refinements.css';
import type { SiteLocale } from '../data/products';
import SiteHeader from '../components/v2/SiteHeader.astro';
import SiteFooter from '../components/v2/SiteFooter.astro';
interface Props { locale: SiteLocale; title: string; description: string; path?: string; current?: string }
const { locale, title, description, path = '', current = '' } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const prefix = locale === 'en' ? 'en/' : locale === 'zh-CN' ? 'zh-cn/' : '';
const siteRoot = new URL(base ? `${base}/` : '/', Astro.site);
const canonical = new URL(`${prefix}${path}`, siteRoot).href;
const zhTwUrl = new URL(path,siteRoot).href; const zhCnUrl=new URL(`zh-cn/${path}`,siteRoot).href; const enUrl=new URL(`en/${path}`,siteRoot).href;
---
<!doctype html><html lang={locale === 'en' ? 'en' : locale === 'zh-CN' ? 'zh-Hans' : 'zh-Hant'}><head>
  <meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="description" content={description}><meta name="theme-color" content="#f4f7f5">
  <title>{title}</title><link rel="canonical" href={canonical}><link rel="alternate" hreflang="zh-Hant" href={zhTwUrl}><link rel="alternate" hreflang="zh-Hans" href={zhCnUrl}><link rel="alternate" hreflang="en" href={enUrl}><link rel="alternate" hreflang="x-default" href={zhTwUrl}>
  <meta property="og:title" content={title}><meta property="og:description" content={description}><meta property="og:type" content="website">
  <link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml">
</head><body class="v2-body"><a class="v2-skip" href="#main">{locale === 'en' ? 'Skip to main content' : locale === 'zh-CN' ? '跳到主要内容' : '跳到主要內容'}</a><SiteHeader locale={locale} current={current} path={path}/><main id="main"><slot /></main><SiteFooter locale={locale}/>
<script>
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');
  if (!reduced.matches && 'IntersectionObserver' in window) { const observer = new IntersectionObserver((entries)=>entries.forEach((entry)=>{ if(entry.isIntersecting){ entry.target.classList.add('is-visible'); observer.unobserve(entry.target); }}),{threshold:.12}); document.querySelectorAll('.v2-reveal').forEach((node)=>observer.observe(node)); } else document.querySelectorAll('.v2-reveal').forEach((node)=>node.classList.add('is-visible'));
</script></body></html>
