<script>
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');
  const productScenes = [...document.querySelectorAll<HTMLElement>('[data-work-scene]')];
  const playProduct = (scene: HTMLElement) => {
    if (reduced.matches) return;
    scene.classList.remove('is-playing');
    void scene.offsetWidth;
    scene.classList.add('is-playing');
  };

  if (reduced.matches) productScenes.forEach((scene) => scene.classList.add('is-complete'));
  else {
    const sceneObserver = new IntersectionObserver((entries) => entries.forEach((entry) => {
      if (!entry.isIntersecting) return;
      playProduct(entry.target as HTMLElement);
      sceneObserver.unobserve(entry.target);
    }), { threshold: .3 });
    productScenes.forEach((scene) => sceneObserver.observe(scene));
  }
  document.querySelectorAll<HTMLButtonElement>('[data-replay]').forEach((button) => button.addEventListener('click', () => {
    const scene = button.closest<HTMLElement>('[data-work-scene]');
    if (scene) playProduct(scene);
  }));

  const cardObserver = new IntersectionObserver((entries) => entries.forEach((entry) => {
    if (!entry.isIntersecting) return;
    entry.target.classList.add('is-visible');
    cardObserver.unobserve(entry.target);
  }), { threshold: .25 });
  document.querySelectorAll<HTMLElement>('[data-card-motion]').forEach((card) => {
    if (reduced.matches) card.classList.add('is-visible'); else cardObserver.observe(card);
  });

  const hero = document.querySelector<HTMLElement>('[data-hero-motion]');
  const playHero = () => {
    if (!hero || reduced.matches) return;
    hero.getAnimations({ subtree:true }).forEach((animation) => animation.cancel());
    const inputs = [...hero.querySelectorAll<HTMLElement>('[data-hero-input]')];
    const modules = [...hero.querySelectorAll<SVGPathElement>('[data-hero-module]')];
    const paths = [...hero.querySelectorAll<SVGPathElement>('[data-hero-path]')];
    const bridge = hero.querySelector<SVGPathElement>('[data-hero-bridge]');
    const ring = hero.querySelector<HTMLElement>('[data-hero-ring]');
    const wordmark = hero.querySelector<HTMLElement>('[data-hero-wordmark]');
    const logoStage = hero.querySelector<HTMLElement>('.eh-logo-stage');
    const productInterface = hero.querySelector<HTMLElement>('[data-hero-interface]');
    const finalMessage = hero.querySelector<HTMLElement>('[data-hero-final]');
    inputs.forEach((input, index) => input.animate([
      { opacity:0, transform:'translateX(-14px)' },
      { opacity:1, transform:'translateX(0)', offset:.55 },
      { opacity:.22, transform:'translateX(52px)' }
    ], { duration:2600, delay:index * 130, fill:'forwards', easing:'cubic-bezier(.22,.61,.36,1)' }));
    modules.forEach((module, index) => module.animate([
      { opacity:0, transform:`translate(${index % 2 ? 24 : -24}px,${index < 2 ? -18 : 18}px) scale(.88)` },
      { opacity:1, transform:'translate(0,0) scale(1)' }
    ], { duration:900, delay:1500 + index * 180, fill:'forwards', easing:'cubic-bezier(.22,.61,.36,1)' }));
    paths.forEach((path, index) => path.animate(
      [{ strokeDashoffset:1 }, { strokeDashoffset:0 }],
      { duration:1450, delay:2550 + index * 180, fill:'forwards', easing:'cubic-bezier(.22,.61,.36,1)' }
    ));
    wordmark?.animate([{ opacity:0, transform:'translateY(8px)' }, { opacity:1, transform:'translateY(0)' }], { duration:700, delay:3650, fill:'forwards', easing:'ease-out' });
    ring?.animate([{ opacity:0, transform:'scale(.76)' }, { opacity:.72, transform:'scale(1)', offset:.35 }, { opacity:.16, transform:'scale(1.2)' }], { duration:1400, delay:3900, fill:'forwards', easing:'cubic-bezier(.22,.61,.36,1)' });
    bridge?.animate([{ strokeDashoffset:1 }, { strokeDashoffset:0 }], { duration:800, delay:4400, fill:'forwards', easing:'ease-in-out' });
    const compactHero = matchMedia('(max-width:560px)').matches;
    logoStage?.animate([{ transform:'translateX(0) scale(1)' }, { transform:`translateX(${compactHero ? 0 : -68}px) scale(${compactHero ? .72 : .76})` }], { duration:950, delay:4550, fill:'forwards', easing:'cubic-bezier(.22,.61,.36,1)' });
    productInterface?.animate([{ opacity:0, transform:'translateX(32px)' }, { opacity:1, transform:'translateX(0)' }], { duration:950, delay:5050, fill:'forwards', easing:'cubic-bezier(.22,.61,.36,1)' });
    finalMessage?.animate([{ opacity:0, transform:'translateY(10px)' }, { opacity:1, transform:'translateY(0)' }], { duration:850, delay:6900, fill:'forwards', easing:'ease-out' });
  };
  if (hero) {
    if (reduced.matches) hero.classList.add('is-static'); else playHero();
    hero.querySelector<HTMLButtonElement>('[data-hero-replay]')?.addEventListener('click', playHero);
  }
</script>
