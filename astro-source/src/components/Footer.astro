---
import type { Locale } from '../data/site';
interface Props { locale: Locale }
const { locale } = Astro.props;
const en = locale === 'en';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<footer class="site-footer"><div class="shell footer-grid">
  <div class="footer-brand"><img src={`${base}/images/elias-net-logo.svg`} alt="Elias Net" width="238" height="56"><p>{en ? 'Controlled AI for real work' : '把 AI 安全地接進企業工作'}</p></div>
  <nav aria-label={en ? 'Footer navigation' : '頁尾導覽'}><a href="#products">{en ? 'Products' : '產品'}</a><a href="#trust">{en ? 'Principles' : '理念'}</a><a href="#evidence">{en ? 'Evidence' : '證據'}</a><a href="#capabilities">{en ? 'Capabilities' : '能力'}</a><a href="#cases">{en ? 'Concept cases' : '概念案例'}</a><a href="#method">{en ? 'Approach' : '導入方法'}</a><a href="#contact">{en ? 'Start' : '開始規劃'}</a></nav>
  <p class="footer-note">{en ? 'Concept website for human review. No data is collected.' : '人工檢閱用概念網站，不蒐集任何資料。'}</p><small>© 2026 Elias Net. Concept demonstration.</small>
</div></footer>
