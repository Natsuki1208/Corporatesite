---
import type { Locale } from '../data/site';
import { copy } from '../data/site';
interface Props { locale: Locale; page?: 'home' | 'company' }
const { locale, page = 'home' } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const localePath = locale === 'en' ? 'en/' : locale === 'zh-CN' ? 'zh-cn/' : '';
const homePath = `${base}/${localePath}`.replace(/\/\/$/, '/');
const companyPath = `${homePath}company/`;
const homeLink = (hash: string) => `${homePath}${hash}`;
const links = page === 'company' ? [
  [companyPath, copy('公司首頁', 'Company', locale)],
  [homeLink('#leadership'), copy('領導與治理', 'Leadership', locale)],
  [homeLink('#products'), copy('五大產品領域', 'Five product domains', locale)],
  [homeLink('#trust'), copy('信任原則', 'Trust', locale)],
  [homeLink('#capabilities'), copy('技術能力', 'Technology', locale)],
  [homeLink('#contact'), copy('開始合作', 'Start a conversation', locale)]
] : [
  [companyPath, copy('關於公司', 'Company', locale)],
  [homeLink('#leadership'), copy('領導與治理', 'Leadership', locale)],
  [homeLink('#products'), copy('五大產品領域', 'Five product domains', locale)],
  [homeLink('#trust'), copy('信任原則', 'Trust', locale)],
  [homeLink('#capabilities'), copy('技術能力', 'Technology', locale)],
  [homeLink('#method'), copy('導入方法', 'Approach', locale)],
  [homeLink('#contact'), copy('開始合作', 'Start a conversation', locale)]
];
---
<footer class="site-footer">
  <div class="shell footer-grid">
    <div class="footer-brand">
      <img src={`${base}/images/elias-net-logo.svg`} alt="Elias Net" width="238" height="56">
      <p>{copy('一間由人負責、以 AI 協助工作的虛擬科技公司', 'A virtual technology company where people stay accountable and AI helps the work', locale)}</p>
      <span class="footer-status">{copy('虛擬公司／概念示範', 'VIRTUAL COMPANY / CONCEPT DEMO', locale)}</span>
    </div>
    <nav aria-label={copy('頁尾導覽', 'Footer navigation', locale)}>
      {links.map(([href,label]) => <a href={href}>{label}</a>)}
    </nav>
    <p class="footer-note">{copy('ELIAS NET 為虛擬科技公司建構與概念示範。頁面中的組織、人物角色、產品成熟度與案例，不代表真實公司聘任、真實客戶成果或真實人物參與。', 'ELIAS NET is a virtual technology company concept. Its organization, roles, product maturity and cases do not represent real employment, customer outcomes or participation by real people.', locale)}</p>
    <small>© 2026 Elias Net. {copy('虛擬科技公司概念示範。', 'Virtual technology company concept demonstration.', locale)}</small>
  </div>
</footer>
