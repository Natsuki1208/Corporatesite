---
import type { Locale } from '../data/site';
interface Props { locale: Locale }
const { locale } = Astro.props;
const en = locale === 'en';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<footer class="site-footer"><div class="shell footer-grid">
  <div class="footer-brand"><img src={`${base}/images/elias-net-logo.svg`} alt="Elias Net" width="238" height="56"><p>{en ? 'AI Innovation & Business Transformation Partner' : 'AI 創新與企業轉型夥伴'}</p></div>
  <nav aria-label={en ? 'Footer navigation' : '頁尾導覽'}><a href="#problems">{en ? 'Challenges' : '挑戰'}</a><a href="#innovation">{en ? 'AI partnership' : 'AI 夥伴'}</a><a href="#scenes">{en ? 'Applications' : '工作應用'}</a><a href="#capabilities">{en ? 'How we help' : '服務能力'}</a><a href="#cases">{en ? 'Concept cases' : '概念案例'}</a><a href="#method">{en ? 'Approach' : '導入方法'}</a><a href="#contact">{en ? 'Start together' : '開始規劃'}</a></nav>
  <p class="footer-note">{en ? 'Concept website for human review. No data is collected.' : '人工檢閱用概念網站，不蒐集任何資料。'}</p><small>© 2026 Elias Net. Concept demonstration.</small>
</div></footer>
