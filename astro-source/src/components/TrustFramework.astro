---
import type { Locale } from '../data/site';
import { copy, list } from '../data/site';
interface Props { locale: Locale }
const { locale } = Astro.props;
const principles = [
  [copy('可用','Useful',locale), copy('進入既有系統與真實工作流程。','Work inside existing systems and real workflows.',locale)],
  [copy('可控','Controlled',locale), copy('資料範圍、權限與人工核准清楚可見。','Make data scope, permissions and human approval visible.',locale)],
  [copy('可證明','Provable',locale), copy('保留來源、Trace、測試與驗收證據。','Preserve sources, traces, tests and acceptance evidence.',locale)]
];
const rules = list(['問題先於模型','證據先於自動化','高影響操作必須人工核准','只使用完成任務所需的資料','每次輸出與決策都可以追溯'], ['Problem before model','Evidence before automation','Human approval for high-impact actions','Minimum necessary data','Trace every output and decision'], locale);
---
<section id="trust" class="main-section trust-framework" data-section="trust" aria-labelledby="trust-title">
  <div class="shell trust-grid">
    <div class="trust-copy" data-reveal>
      <p class="section-index">{copy('公司理念', 'PRODUCT PRINCIPLES', locale)}</p>
      <h2 id="trust-title">{copy('企業需要的，不只是更會回答的 AI', 'Enterprise AI needs a more trustworthy way of working—not just better answers.', locale)}</h2>
      <p class="section-lead">{copy('AI 可以參與工作，但不能越過人的責任邊界。理念不是宣言，而是每個產品都必須具備的機制。', 'AI can participate in the work, but it must not cross the boundaries of human responsibility.', locale)}</p>
      <ol class="principle-list">{rules.map((rule,index) => <li><span>{String(index + 1).padStart(2,'0')}</span>{rule}</li>)}</ol>
    </div>
    <div class="control-layer" data-reveal>
      <p>{copy('ELIAS CONTROL LAYER｜共用治理底座', 'ELIAS CONTROL LAYER', locale)}</p>
      <div class="control-flow" role="img" aria-label={copy('核准資料依序通過 AI Agent、政策檢查、人工核准與稽核紀錄', 'Approved data flows through an AI agent, policy gate, human approval and audit record', locale)}>
        {list(['核准資料','AI Agent','政策檢查','人工核准','稽核紀錄'], ['Approved data','AI agent','Policy gate','Human approval','Audit record'], locale).map((item,index) => <span><i>{String(index + 1).padStart(2,'0')}</i><b>{item}</b></span>)}
      </div>
      <div class="trust-pillars">{principles.map(([name,copy]) => <article><h3>{name}</h3><p>{copy}</p></article>)}</div>
    </div>
  </div>
</section>
