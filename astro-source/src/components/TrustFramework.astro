---
import type { Locale } from '../data/site';
import { copy } from '../data/site';
interface Props { locale: Locale }
const { locale } = Astro.props;
const levels = [
  ['OBSERVE',copy('只觀察與整理','Observe and organize only',locale)],
  ['RECOMMEND',copy('提出方案，不執行','Recommend without execution',locale)],
  ['VERIFY',copy('執行預先允許的唯讀檢查','Run pre-approved read-only checks',locale)],
  ['AUTHORIZED ACTION',copy('人工核准後執行可復原任務','Run reversible tasks after human approval',locale)],
  ['HUMAN OVERRIDE',copy('隨時暫停、撤回或全面接管','Pause, revoke or take full control at any time',locale)]
];
---
<section id="control" class="main-section human-control" data-section="control" aria-labelledby="control-title">
  <div class="shell control-layout">
    <div class="control-intro" data-reveal><p class="section-index">ELIAS CONTROL / HUMAN COMMAND</p><h2 id="control-title">{copy('自主運作，不等於自主決定。','Autonomous operation is not autonomous authority.',locale)}</h2><p>{copy('ELIAS CONTROL 是三項產品共用的人類指揮與治理層，管理身分、權限、核准、任務限制、緊急停止與稽核紀錄。','ELIAS CONTROL is the shared command and governance layer for identity, access, authorization, mission limits, emergency stop and audit evidence.',locale)}</p><blockquote>{copy('每一項自主能力，都必須有可見的控制邊界。','Every autonomous capability needs a visible control boundary.',locale)}</blockquote></div>
    <ol class="authority-levels" data-reveal>{levels.map(([name,description],index) => <li class:list={{ authorization:index === 3, override:index === 4 }}><span>0{index + 1}</span><div><strong>{name}</strong><p>{description}</p></div></li>)}</ol>
  </div>
</section>
