---
import type { Locale } from '../data/site';
import { capabilities, copy, list, text } from '../data/site';
import '../styles/capabilities.css';
interface Props { locale: Locale }
const { locale } = Astro.props;
const en = locale === 'en';
const moduleLabels = list(['問題','體驗','資料','AI 協助','工具','治理'], ['WORK PROBLEM','EXPERIENCE','DATA','AI HELP','TOOLS','GOVERNANCE'], locale);
const pathLabels = list(['真實工作問題','核准資料','AI 協助','人的確認','可追蹤結果'], ['REAL WORK PROBLEM','APPROVED CONTEXT','AI ASSISTANCE','HUMAN REVIEW','TRACEABLE RESULT'], locale);
const labels = en ? {
  value:'VALUE', risk:'RISK', first:'FIRST USE CASE', human:'OUR TEAM', index:'INDEX',
  task:'TASK', assist:'AI ASSIST', review:'OUR REVIEW', connect:'CONNECT', document:'DOC',
  scope:'SCOPE', access:'ACCESS CHECK', record:'RECORD'
} : {
  value:copy('價值','VALUE',locale), risk:copy('風險','RISK',locale), first:copy('優先場景','FIRST USE CASE',locale), human:copy('我們','OUR TEAM',locale), index:copy('知識索引','INDEX',locale),
  task:copy('任務','TASK',locale), assist:copy('AI 協助','AI ASSIST',locale), review:copy('由我們確認','OUR REVIEW',locale), connect:copy('整合層','CONNECT',locale), document:copy('文件','DOC',locale),
  scope:copy('資料範圍','SCOPE',locale), access:copy('權限檢查','ACCESS CHECK',locale), record:copy('稽核紀錄','RECORD',locale)
};
---
<section id="capabilities" class="main-section solutions light-section capabilities-semantic" data-section="capabilities" aria-labelledby="capabilities-title">
  <div class="shell">
    <header class="section-heading" data-reveal data-gsap="section-heading">
      <p class="section-index">{copy('核心能力', 'CAPABILITIES', locale)}</p>
      <h2 id="capabilities-title">{copy('從一個工作問題，到一個有責任的 AI 工作方式', 'From one work problem to an AI-enabled way of working with accountability.', locale)}</h2>
      <p>{copy('先把問題說清楚，再把 AI 放在適合的位置：能整理、能提醒、能建議，但重要決定仍由人確認。', 'First make the work problem clear, then place AI where it helps: organize, flag and suggest—while people review important decisions.', locale)}</p>
    </header>

    <div class="capability-path" data-capability-path data-reveal aria-label={copy('從真實工作問題到可追蹤結果的五步路徑', 'A five-step path from a real work problem to a traceable result', locale)}>
      {pathLabels.map((label,index) => <div class="capability-path-step"><span>0{index + 1}</span><strong>{label}</strong>{index < pathLabels.length - 1 && <i aria-hidden="true">→</i>}</div>)}
    </div>

    <div class="capability-assembly" role="img" data-capability-assembly data-reveal aria-label={copy('一個工作問題經過核准資料、AI 協助與人的確認，形成可追蹤的工作方式', 'A work problem moves through approved context, AI assistance and human review to form a traceable way of working', locale)}>
      <canvas class="semantic-particles" data-particle-stage="capabilities" aria-hidden="true"></canvas>
      <div class="assembly-source" data-assembly-source><small>{copy('從這裡開始', 'START WITH', locale)}</small><strong>{copy('一個工作問題', 'One work problem', locale)}</strong><i aria-hidden="true"></i></div>
      <div class="assembly-system">
        <svg class="assembly-paths" viewBox="0 0 600 260" preserveAspectRatio="none" aria-hidden="true">
          <path data-assembly-path d="M8 130 C78 130 66 54 142 54 H252 C306 54 294 130 350 130" />
          <path data-assembly-path d="M8 130 C78 130 66 206 142 206 H252 C306 206 294 130 350 130" />
          <path data-assembly-path d="M350 130 C420 130 438 130 592 130" />
        </svg>
        <div class="assembly-modules" aria-hidden="true">
          {moduleLabels.map((label,index) => <span data-assembly-node style={`--module-index:${index}`}>{label}</span>)}
        </div>
        <svg class="assembly-core kinetic-ai-core" data-assembly-core data-core-phase="understand" viewBox="0 0 180 150" aria-hidden="true">
          <g class="core-signal" data-core-signal><path d="M4 75 H36"/><circle cx="12" cy="75" r="3"/><circle cx="28" cy="75" r="3"/></g>
          <g class="core-letter-a" data-core-a><path class="core-a-left" d="M48 120 L78 28"/><path class="core-a-right" d="M78 28 L108 120"/><path class="core-a-bar" d="M61 82 H96"/></g>
          <g class="core-letter-i" data-core-i><path class="core-i-top" d="M122 30 H164"/><path class="core-i-stem" d="M143 30 V120"/><path class="core-i-bottom" d="M122 120 H164"/></g>
          <g class="core-branches" data-core-branches><path d="M62 78 L35 52 H18"/><path d="M94 78 L118 56 H136"/><path d="M78 28 V12"/><circle cx="18" cy="52" r="3"/><circle cx="136" cy="56" r="3"/><circle cx="78" cy="12" r="3"/></g>
          <g class="core-output" data-core-output><path d="M164 75 H178"/><circle cx="174" cy="75" r="4"/></g>
        </svg>
        <button class="core-replay" type="button" data-core-replay>{copy('重播工作路徑', 'Replay the working path', locale)}</button>
      </div>
      <div class="assembly-result" data-assembly-result><small>{copy('最後形成', 'FORM', locale)}</small><strong>{copy('有責任的 AI 工作方式', 'An accountable AI-enabled way of working', locale)}</strong><i aria-hidden="true"></i></div>
    </div>

    <div class="solution-grid">
      {capabilities.map((item) => (
        <article class={`solution-card solution-${item.id}`} data-solution-card data-capability-id={item.id}>
          <div class="solution-top"><b>{text(item.name,locale)}</b></div>
          <div class="capability-visual" data-capability-visual aria-hidden="true">
            <canvas class="semantic-particles" data-particle-stage={`capability-${item.id}`}></canvas>
            {item.id === 'strategy' && <svg viewBox="0 0 360 180" vector-effect="non-scaling-stroke">
              <g class="scene-options" data-cap-group><circle data-cap-node cx="38" cy="32" r="9"/><circle data-cap-node cx="38" cy="72" r="9"/><circle data-cap-node cx="38" cy="112" r="9"/><circle data-cap-node cx="38" cy="152" r="9"/><circle data-cap-node cx="95" cy="55" r="9"/><circle data-cap-node cx="95" cy="130" r="9"/></g>
              <path data-cap-path d="M54 32 C112 32 122 68 180 68 M54 72 H180 M54 112 H180 M54 152 C112 152 122 112 180 112"/>
              <g class="evaluation-axis"><line x1="180" y1="38" x2="180" y2="142"/><line x1="158" y1="90" x2="218" y2="90"/><text x="187" y="49">{labels.value}</text><text x="187" y="137">{labels.risk}</text></g>
              <path data-cap-path d="M218 90 H278"/><g data-cap-result class="semantic-result"><circle cx="306" cy="90" r="25"/><circle cx="306" cy="90" r="8"/><text x="306" y="132">{labels.first}</text></g>
            </svg>}
            {item.id === 'experience' && <svg viewBox="0 0 360 180" vector-effect="non-scaling-stroke">
              <g data-cap-node class="person-node"><circle cx="35" cy="67" r="13"/><path d="M16 105 C18 82 52 82 54 105"/></g><path data-cap-path d="M56 78 H100"/><g data-cap-node class="ai-node"><path d="M120 49 H178 L198 78 L178 107 H120 L100 78 Z"/><text x="149" y="83">AI</text></g>
              <path data-cap-path d="M198 78 C226 78 226 45 250 45 H292 M198 78 C226 78 226 129 250 129 H292"/><g data-cap-result class="assist-result"><rect x="292" y="25" width="50" height="40" rx="6"/><path d="M304 45 L315 55 L332 35"/></g><g data-cap-result class="human-result"><circle cx="317" cy="129" r="22"/><path d="M309 129 H325 M317 121 V137"/><text x="317" y="164">{labels.human}</text></g>
            </svg>}
            {item.id === 'data' && <svg viewBox="0 0 360 180" vector-effect="non-scaling-stroke">
              <g class="documents"><g data-cap-node transform="translate(18 18)"><path d="M0 0 H48 L60 12 V48 H0 Z"/><path d="M48 0 V12 H60"/><text x="8" y="39">S1</text></g><g data-cap-node transform="translate(18 67)"><path d="M0 0 H48 L60 12 V48 H0 Z"/><path d="M48 0 V12 H60"/><text x="8" y="39">S2</text></g><g data-cap-node transform="translate(18 116)"><path d="M0 0 H48 L60 12 V48 H0 Z"/><path d="M48 0 V12 H60"/><text x="8" y="39">S3</text></g></g>
              <path data-cap-path d="M80 42 C112 42 108 90 142 90 M80 91 H142 M80 140 C112 140 108 90 142 90"/><g data-cap-node class="knowledge-index"><rect x="142" y="49" width="76" height="82" rx="8"/><circle cx="165" cy="72" r="7"/><circle cx="195" cy="72" r="7"/><circle cx="180" cy="104" r="7"/><path d="M170 76 L177 98 M190 76 L183 98 M172 72 H188"/><text x="180" y="122">{labels.index}</text></g>
              <path data-cap-path d="M218 90 H258"/><g data-cap-result class="answer-card"><rect x="258" y="35" width="84" height="110" rx="8"/><path d="M274 60 H327 M274 79 H321 M274 98 H311"/><circle cx="278" cy="124" r="6"/><text x="292" y="128">S1 · S3</text></g>
            </svg>}
            {item.id === 'agent' && <svg viewBox="0 0 360 180" vector-effect="non-scaling-stroke">
              <g data-cap-node class="task-node"><rect x="14" y="64" width="58" height="52" rx="6"/><path d="M28 80 H58 M28 94 H50"/><text x="43" y="135">{labels.task}</text></g><path data-cap-path d="M72 90 H116"/><g data-cap-node class="agent-node"><circle cx="148" cy="90" r="32"/><text x="148" y="86">AI</text><text x="148" y="103">{copy('協助', 'ASSIST', locale)}</text></g>
              <rect class="responsibility-boundary" x="102" y="25" width="154" height="130" rx="12"/><g class="tool-nodes"><rect data-cap-node x="205" y="40" width="34" height="26" rx="4"/><rect data-cap-node x="205" y="77" width="34" height="26" rx="4"/><rect data-cap-node x="205" y="114" width="34" height="26" rx="4"/></g>
              <path data-cap-path d="M180 90 H205 M239 90 H276"/><g data-cap-result class="review-node"><path d="M306 58 L338 90 L306 122 L274 90 Z"/><text x="306" y="87">{copy('我們', 'OUR', locale)}</text><text x="306" y="101">{copy('確認', 'REVIEW', locale)}</text></g><g class="locked-tool"><rect x="286" y="16" width="40" height="26" rx="4"/><path d="M298 16 V10 C298 2 314 2 314 10 V16"/></g>
            </svg>}
            {item.id === 'integration' && <svg viewBox="0 0 360 180" vector-effect="non-scaling-stroke">
              <g class="isolated-systems"><g data-cap-node><rect x="16" y="22" width="58" height="38" rx="5"/><text x="45" y="46">CRM</text></g><g data-cap-node><rect x="16" y="71" width="58" height="38" rx="5"/><text x="45" y="95">ERP</text></g><g data-cap-node><rect x="16" y="120" width="58" height="38" rx="5"/><text x="45" y="144">{labels.document}</text></g></g>
              <path data-cap-path d="M74 41 C110 41 100 90 134 90 M74 90 H134 M74 139 C110 139 100 90 134 90"/><g data-cap-node class="integration-layer"><rect x="134" y="34" width="72" height="112" rx="10"/><path d="M152 60 H188 M152 90 H188 M152 120 H188"/><text x="170" y="137">{labels.connect}</text></g>
              <path data-cap-path d="M206 90 H266 C294 90 294 52 326 52 M266 90 C294 90 294 128 326 128"/><g data-cap-result class="workflow-results"><circle cx="332" cy="52" r="13"/><circle cx="332" cy="128" r="13"/><path d="M326 52 L331 57 L339 47 M326 128 L331 133 L339 123"/></g><path class="recovery-path" d="M325 146 C244 174 122 174 45 158"/>
            </svg>}
            {item.id === 'governance' && <svg viewBox="0 0 360 180" vector-effect="non-scaling-stroke">
              <g data-cap-node class="data-scope"><rect x="12" y="56" width="60" height="68" rx="8"/><path d="M25 76 H59 M25 92 H59 M25 108 H49"/><text x="42" y="143">{labels.scope}</text></g><path data-cap-path d="M72 90 H106"/><g data-cap-node class="permission-node"><path d="M140 56 L174 90 L140 124 L106 90 Z"/><text x="140" y="87">{copy('權限', 'ACCESS', locale)}</text><text x="140" y="101">{copy('檢查', 'CHECK', locale)}</text></g>
              <path data-cap-path d="M174 90 H210"/><g data-cap-result class="human-approval"><circle cx="238" cy="90" r="28"/><text x="238" y="87">{copy('我們', 'OUR', locale)}</text><text x="238" y="101">{copy('確認', 'REVIEW', locale)}</text></g><path data-cap-path d="M266 90 H292"/><g data-cap-result class="audit-record"><rect x="292" y="52" width="56" height="76" rx="6"/><path d="M304 72 H336 M304 88 H336 M304 104 H326"/><text x="320" y="143">{labels.record}</text></g><path class="improvement-loop" d="M320 128 C320 166 140 174 42 124"/>
            </svg>}
          </div>
          <h3>{text(item.headline,locale)}</h3><p>{text(item.summary,locale)}</p>
          <button id={`capability-toggle-${item.id}`} type="button" class="solution-toggle" aria-expanded="false" aria-controls={`capability-detail-${item.id}`} data-solution-toggle><span>{copy('看完整使用方式', 'See the full working path', locale)}</span><i aria-hidden="true">＋</i></button>
          <div id={`capability-detail-${item.id}`} class="solution-detail" role="region" aria-labelledby={`capability-toggle-${item.id}`} hidden><dl><div><dt>{copy('現在的阻力', 'Current friction', locale)}</dt><dd>{text(item.problem,locale)}</dd></div><div><dt>{copy('我們如何協助', 'How we help', locale)}</dt><dd>{text(item.assistance,locale)}</dd></div><div><dt>{copy('最後形成', 'What this enables', locale)}</dt><dd>{text(item.outcome,locale)}</dd></div></dl></div>
        </article>
      ))}
    </div>
  </div>
</section>
