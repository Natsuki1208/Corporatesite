---
import type { Locale } from '../data/site';
import { copy } from '../data/site';
import { governanceItems, text } from '../data/site';
import '../styles/kinetic-ai.css';
interface Props { locale: Locale }
const { locale } = Astro.props;
const steps = [
  { label:copy('需求','Need',locale), word:copy('理解需求','UNDERSTAND',locale), title:copy('看見真正需要改變的工作','See the work that needs to change',locale), copy:copy('把企業需求、知識、資料與工具帶回同一個清楚視野。','Bring needs, knowledge, data and tools into one clear view.',locale) },
  { label:copy('脈絡','Context',locale), word:copy('建立脈絡','CONNECT',locale), title:copy('串起問題周圍的脈絡','Connect the context around it',locale), copy:copy('AI 先理解核准資訊與工作情境，再提出可以採取的下一步。','AI relates approved information and workflow context before suggesting a next step.',locale) },
  { label:copy('我們確認','Our review',locale), word:copy('等待確認','PAUSE',locale), title:copy('重要決定，我們來做','We make the important decisions',locale), copy:copy('AI 負責整理與說明；涉及風險、權限或影響時，由我們選擇如何繼續。','AI prepares and explains. We choose what moves forward when risk, access or consequences matter.',locale) },
  { label:copy('成果','Outcome',locale), word:copy('形成成果','ENABLE',locale), title:copy('工作，我們和 AI 一起完成','We complete the work together with AI',locale), copy:copy('我們的決定與 AI 的協助一起回到工作流程，範圍與紀錄依然清楚。','Our decision and AI assistance move forward together, with the boundary and record intact.',locale) }
];
---
<div class="perspective-path case-governance" data-reveal>
  <header><p class="section-index">{copy('AI 工作路徑', 'HOW WE MOVE FORWARD', locale)}</p><h3>{copy('AI 協助準備，我們掌握方向', 'AI prepares the work. We choose the direction.', locale)}</h3><p>{copy('AI 串起資訊並準備下一步；涉及風險、權限或實際影響的選擇，仍由我們掌握。', 'AI connects information and prepares the next step. We keep the choices that carry risk, access or real-world consequences.', locale)}</p></header>
  <div class="ai-work-path" data-ai-change data-active-change="0">
    <div class="kinetic-workmark">
      <svg class="kinetic-workmark-svg" viewBox="0 0 620 360" aria-hidden="true">
        <g class="work-signal" data-work-signal><path d="M16 178 H112"/><circle cx="30" cy="178" r="4"/><circle cx="57" cy="178" r="4"/><circle cx="84" cy="178" r="4"/></g>
        <g class="work-a" data-work-a><path class="work-a-left" d="M132 288 L232 68"/><path class="work-a-right" d="M232 68 L332 288"/><path class="work-a-bar" d="M170 205 H295"/></g>
        <g class="work-i" data-work-i><path class="work-i-top" d="M374 76 H520"/><path class="work-i-stem" d="M447 76 V286"/><path class="work-i-bottom" d="M374 286 H520"/><path class="work-i-axis work-i-axis-left" d="M416 100 V266"/><path class="work-i-axis work-i-axis-right" d="M478 100 V266"/></g>
        <g class="work-context" data-work-context><path d="M168 200 C130 150 110 116 76 110"/><path d="M272 198 C314 148 340 114 372 106"/><path d="M232 70 V24"/><circle cx="76" cy="110" r="7"/><circle cx="372" cy="106" r="7"/><circle cx="232" cy="24" r="7"/></g>
        <g class="work-review" data-work-review><rect x="105" y="35" width="450" height="286" rx="12"/><path d="M535 62 V296"/><circle cx="535" cy="178" r="8"/></g>
        <g class="work-output" data-work-output><path d="M520 178 H598"/><circle cx="598" cy="178" r="9"/><path d="M588 178 L594 184 L606 170"/></g>
      </svg>
      <div class="kinetic-workmark-label"><span data-ai-change-word>{steps[0].word}</span></div>
      <div class="work-partner-legend" aria-hidden="true"><span>{copy('我們的判斷', 'OUR JUDGMENT', locale)}</span><span>{copy('AI 的協助', 'AI ASSISTANCE', locale)}</span></div>
      <button class="ai-work-replay" type="button" data-ai-change-replay data-replay-label={copy('重播完整流程', 'Replay the full path', locale)} data-pause-label={copy('暫停示範', 'Pause demonstration', locale)}>{copy('重播完整流程', 'Replay the full path', locale)}</button>
    </div>
    <div class="ai-work-copy" id="ai-change-panel" role="tabpanel" aria-labelledby="ai-change-tab-0"><p class="eyebrow">{copy('ELIAS NET · AI 工作路徑', 'ELIAS NET · AI CHANGE PATH', locale)}</p><p class="ai-work-kicker" data-ai-change-kicker>{steps[0].label}</p><h3 data-ai-change-title>{steps[0].title}</h3><p data-ai-change-copy>{steps[0].copy}</p></div>
    <div class="ai-work-tabs" role="tablist" aria-label={copy('AI 參與工作路徑', 'AI change path', locale)}>{steps.map((step,index) => <button id={`ai-change-tab-${index}`} type="button" role="tab" aria-controls="ai-change-panel" aria-selected={index === 0 ? 'true' : 'false'} tabindex={index === 0 ? '0' : '-1'} data-ai-change-tab data-kicker={step.label} data-word={step.word} data-title={step.title} data-copy={step.copy}>{step.label}</button>)}</div>
  </div>
  <details class="governance-details"><summary>{copy('展開技術與治理能力', 'View technical and governance capabilities', locale)}</summary><div>{governanceItems.map((item,index) => <article><span>0{index+1}</span><h4>{text(item.title,locale)}</h4><p>{text(item.copy,locale)}</p></article>)}</div><p class="technical-note">{copy('依應用評估 API、資料介面、權限控制、模型選擇、日誌與稽核、測試與版本管理，以及地端、雲端或混合架構。', 'Depending on the application: APIs, data interfaces, access control, model selection, logging, audit, testing, version management, and on-premises, cloud or hybrid architecture.', locale)}</p></details>
</div>
