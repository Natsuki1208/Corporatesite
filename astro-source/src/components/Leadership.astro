---
import type { Locale } from '../data/site';
import { copy } from '../data/site';
interface Props { locale: Locale }
const { locale } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const leaders = [
  {image:'elias-founder-chair.webp',role:copy('創辦人暨董事長','Founder & Executive Chair',locale),name:'Helena Vale',remit:copy('確立公司使命、長期責任與不可跨越的產品界線。','Sets the mission, long-term accountability and product boundaries that cannot be crossed.',locale)},
  {image:'elias-chief-executive.webp',role:copy('執行長','Chief Executive Officer',locale),name:'Adrian Mercer',remit:copy('負責產品、市場策略與每項承諾所需的交付證據。','Owns product and market strategy and the delivery evidence behind every commitment.',locale)},
  {image:'elias-chief-safety.webp',role:copy('首席安全與人類控制主管','Chief Human Control & Safety Officer',locale),name:'Daniel Kwan',remit:copy('獨立監督權限、停止、人工接管與重大事件審查。','Independently oversees access, stop controls, human override and major-incident review.',locale)}
];
---
<section id="leadership" class="main-section autonomy-leadership" data-section="leadership" aria-labelledby="leadership-title">
  <div class="shell">
    <header class="section-heading" data-reveal><p class="section-index">LEADERSHIP / ACCOUNTABILITY</p><h2 id="leadership-title">{copy('技術可以加速行動，責任不能交給技術。','Technology can accelerate action. It cannot inherit responsibility.',locale)}</h2><p>{copy('董事會與執行團隊共同界定產品方向、安全界線與部署原則；重大風險、醫療處置與關鍵任務保留明確的人類責任。','The board and executive team define product direction, safety boundaries and deployment principles. Human accountability remains explicit for risk, medical care and critical missions.',locale)}</p></header>
    <figure class="board-portrait" data-reveal><img src={`${base}/images/elias-leadership-board.webp`} alt={copy('ELIAS NET 董事會與核心執行團隊在明亮會議室合影','ELIAS NET board and core executive team in a bright meeting room',locale)} loading="lazy" width="1800" height="1013"><figcaption><strong>{copy('董事會與核心執行團隊','BOARD & CORE EXECUTIVE TEAM',locale)}</strong><span>{copy('公司方向・人類控制・獨立安全監督','Company direction · human command · independent safety oversight',locale)}</span></figcaption></figure>
    <div class="core-leaders">{leaders.map((leader) => <article data-reveal><img src={`${base}/images/${leader.image}`} alt={leader.role} loading="lazy" width="1200" height="900"><div><p>{leader.role}</p><h3>{leader.name}</h3><span>{leader.remit}</span></div></article>)}</div>
  </div>
</section>
