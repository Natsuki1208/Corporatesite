---
import type { Locale } from '../data/site';
import { workScenes, text } from '../data/site';
interface Props { locale: Locale }
const { locale } = Astro.props;
const en = locale === 'en';
---
<section id="scenes" class="main-section work-scenes" data-section="scenes" aria-labelledby="scenes-title">
  <div class="shell">
    <header class="section-heading" data-reveal><p class="section-index">{en ? 'APPLICATIONS' : '工作應用'}</p><h2 id="scenes-title">{en ? 'AI creates value in the work teams do every day.' : 'AI 的價值，發生在每天的工作裡'}</h2><p>{en ? 'Different roles need different kinds of support. AI organizes and prepares; we keep the decisions that matter.' : '不同工作，需要不同的協助方式。AI 負責整理與準備，重要決定由我們掌握。'}</p></header>
    <div class="scene-console" data-scene-console data-reveal>
      <div class="scene-tabs" role="tablist" aria-label={en ? 'Work roles' : '工作角色'}>{workScenes.map((scene,index) => <button type="button" id={`scene-tab-${scene.id}`} role="tab" aria-selected={index === 0 ? 'true' : 'false'} aria-controls={`scene-panel-${scene.id}`} tabindex={index === 0 ? '0' : '-1'} data-scene-tab>{text(scene.role,locale)}</button>)}</div>
      <div class="scene-stage" data-scene-stage data-scene-id={workScenes[0].id}>
        <div class="scene-visual elias-motion-stage" aria-hidden="true">
          <canvas class="semantic-particles" data-particle-stage="work-scenes"></canvas>
          <svg viewBox="0 0 560 390">
            <g class="scene-plot plot-service" data-scene-plot="service"><g class="scene-input"><rect x="30" y="50" width="94" height="34" rx="15"/><rect x="58" y="102" width="118" height="34" rx="15"/><rect x="24" y="154" width="136" height="34" rx="15"/></g><path class="scene-route" d="M176 119 C230 119 218 190 274 190"/><g class="scene-ai"><circle cx="298" cy="190" r="42"/><text x="298" y="197">AI</text></g><path class="scene-route" d="M340 190 H392"/><g class="scene-review"><circle cx="416" cy="190" r="24"/><path d="M405 190 L414 199 L429 180"/></g><path class="scene-route" d="M440 190 H518"/><g class="scene-result"><rect x="466" y="148" width="70" height="84" rx="8"/><path d="M480 169 H522 M480 187 H512 M480 205 H522"/></g></g>
            <g class="scene-plot plot-operations" data-scene-plot="operations"><path class="scene-input" d="M20 192 H74 L94 150 L118 230 L144 176 L170 192 H214"/><circle class="scene-alert" cx="118" cy="230" r="8"/><path class="scene-route" d="M214 192 H262"/><g class="scene-ai"><path d="M262 148 H340 V236 H262 Z"/><path d="M278 174 H326 M278 194 H316 M278 214 H306"/></g><path class="scene-route" d="M340 192 H390"/><g class="scene-review"><path d="M416 164 L444 192 L416 220 L388 192 Z"/></g><path class="scene-route" d="M444 192 H532"/><g class="scene-result"><path d="M476 226 V178 M500 226 V152 M524 226 V190"/></g></g>
            <g class="scene-plot plot-admin" data-scene-plot="admin"><g class="scene-input"><path d="M28 60 H112 L128 76 V146 H28 Z"/><path d="M54 116 H152 L168 132 V202 H54 Z"/><path d="M78 174 H176 L192 190 V260 H78 Z"/></g><path class="scene-route" d="M192 194 H256"/><g class="scene-ai"><circle cx="294" cy="194" r="40"/><path d="M276 182 H312 M276 196 H304 M276 210 H316"/></g><path class="scene-route" d="M334 194 H390"/><g class="scene-review"><circle cx="416" cy="194" r="24"/><path d="M406 194 L414 202 L428 184"/></g><path class="scene-route" d="M440 194 H524"/><g class="scene-result"><path d="M476 154 H530 V236 H476 Z"/><path d="M488 174 H518 M488 192 H518 M488 210 H510"/></g></g>
            <g class="scene-plot plot-it" data-scene-plot="it"><g class="scene-input"><circle cx="54" cy="98" r="16"/><circle cx="108" cy="194" r="16"/><circle cx="54" cy="290" r="16"/><path d="M70 98 C138 98 128 178 212 178 M124 194 H212 M70 290 C138 290 128 210 212 210"/></g><g class="scene-ai"><circle cx="270" cy="194" r="44"/><circle cx="270" cy="194" r="12"/><path d="M270 150 V116 M226 194 H196 M314 194 H344"/></g><path class="scene-route" d="M314 194 H382"/><g class="scene-review"><rect x="382" y="158" width="70" height="72" rx="8"/><path d="M398 180 H436 M398 196 H426 M398 212 H436"/></g><path class="scene-route" d="M452 194 H532"/><g class="scene-result"><circle cx="514" cy="194" r="24"/><path d="M504 194 L512 202 L526 184"/></g></g>
            <g class="scene-plot plot-management" data-scene-plot="management"><g class="scene-input"><path d="M38 252 V176 M74 252 V130 M110 252 V196 M146 252 V88"/></g><path class="scene-route" d="M146 170 C214 170 202 194 246 194"/><g class="scene-ai"><path d="M246 148 H328 V240 H246 Z"/><path d="M264 214 L280 184 L296 200 L312 166"/></g><path class="scene-route" d="M328 194 H384"/><g class="scene-review"><path d="M412 164 L440 194 L412 224 L384 194 Z"/></g><path class="scene-route" d="M440 194 H530"/><g class="scene-result"><path d="M476 228 L530 174 M498 174 H530 V206"/></g></g>
            <g class="scene-plot plot-knowledge" data-scene-plot="knowledge"><g class="scene-input"><path d="M24 76 H104 L118 90 V144 H24 Z"/><path d="M54 166 H134 L148 180 V234 H54 Z"/><path d="M30 256 H110 L124 270 V324 H30 Z"/></g><path class="scene-route" d="M118 110 C190 110 184 176 238 176 M148 200 H238 M124 290 C190 290 184 212 238 212"/><g class="scene-ai"><circle cx="286" cy="194" r="44"/><circle cx="272" cy="180" r="6"/><circle cx="302" cy="180" r="6"/><circle cx="286" cy="210" r="6"/><path d="M277 184 L282 205 M297 184 L290 205 M278 180 H296"/></g><path class="scene-route" d="M330 194 H388"/><g class="scene-review"><circle cx="414" cy="194" r="24"/><path d="M404 194 L412 202 L428 184"/></g><path class="scene-route" d="M438 194 H526"/><g class="scene-result"><rect x="474" y="146" width="66" height="96" rx="8"/><path d="M488 168 H526 M488 186 H520 M488 204 H526"/><circle cx="492" cy="224" r="5"/></g></g>
          </svg>
          <div class="scene-legend"><span>{en ? 'WORK SIGNAL' : '工作訊號'}</span><span>{en ? 'AI ASSISTANCE' : 'AI 協助'}</span><span>{en ? 'OUR DECISION' : '我們決定'}</span><span>{en ? 'SHARED RESULT' : '共同成果'}</span></div>
        </div>
        {workScenes.map((scene,index) => <article id={`scene-panel-${scene.id}`} role="tabpanel" aria-labelledby={`scene-tab-${scene.id}`} data-scene-panel hidden={index !== 0}><p class="scene-role">{text(scene.role,locale)}</p><dl><div><dt>{en ? 'The challenge' : '現在遇到的問題'}</dt><dd>{text(scene.problem,locale)}</dd></div><div><dt>{en ? 'How AI can help' : 'AI 可以怎麼幫忙'}</dt><dd>{text(scene.assistance,locale)}</dd></div><div><dt>{en ? 'What stays with us' : '我們負責什麼'}</dt><dd>{text(scene.human,locale)}</dd></div><div><dt>{en ? 'What can improve' : '可以改善什麼'}</dt><dd>{text(scene.measure,locale)}</dd></div></dl></article>)}
      </div>
    </div>
  </div>
</section>
