---
import type { Locale } from '../data/site';
import { copy } from '../data/site';
import MissionSequence from './MissionSequence.astro';
interface Props { locale: Locale }
const { locale } = Astro.props;
---
<section id="hero" class="hero main-section" data-section="hero" data-gsap-hero aria-labelledby="hero-title">
  <div class="hero-backdrop" aria-hidden="true"></div>
  <div class="shell hero-grid">
    <div class="hero-copy">
      <p class="section-index">{copy('首頁', 'HOME', locale)}</p>
      <p class="brand-kicker">ELIAS NET · HUMAN-COMMANDED AUTONOMOUS SYSTEMS</p>
      <h1 id="hero-title">{copy('自主系統，由人類指揮。', 'Autonomous systems. Human command.', locale)}</h1>
      <p class="hero-lead">{copy('ELIAS NET 連結 AI、企業基礎設施與非武裝救援機器人，協助人們理解風險、協調應變並保護生命；任何高影響行動都必須先經人類授權。', 'ELIAS NET connects AI, enterprise infrastructure and unarmed rescue robotics to understand risk, coordinate response and protect life. Every high-impact action requires human authorization.', locale)}</p>
      <p class="hero-principle">{copy('可用・可控・可證明', 'Useful · Controlled · Provable', locale)}</p>
      <div class="cta-row"><a class="button primary" href="#products">{copy('查看產品系統', 'Explore product systems', locale)}</a><a class="button ghost" href="#control">{copy('了解人類控制', 'See human control', locale)}</a></div>
    </div>
    <div class="hero-mission"><MissionSequence locale={locale} /></div>
  </div>
  <div class="hero-statement shell"><span>{copy('感知全局。只在授權內行動。以保護生命為目的。', 'Sense the whole. Act within authority. Protect life.', locale)}</span></div>
</section>
