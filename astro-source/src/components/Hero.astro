---
import type { Locale } from '../data/site';
import { copy } from '../data/site';
import InnovationCore from './InnovationCore.astro';
interface Props { locale: Locale }
const { locale } = Astro.props;
---
<section id="hero" class="hero main-section" data-section="hero" data-gsap-hero aria-labelledby="hero-title">
  <div class="hero-backdrop" aria-hidden="true"></div>
  <div class="shell hero-grid">
    <div class="hero-copy">
      <p class="section-index">{copy('首頁', 'HOME', locale)}</p>
      <p class="brand-kicker" data-gsap-hero-item>ELIAS NET · {copy('企業 AI 產品與導入夥伴', 'CONTROLLED AI FOR REAL WORK', locale)}</p>
      <h1 id="hero-title" data-gsap-hero-item>{copy('把 AI 安全地接進企業每天的工作', 'Bring AI safely into everyday work.', locale)}</h1>
      <p class="hero-lead" data-gsap-hero-item>{copy('從知識查找、服務支援到 IT 事件分析，Elias Net 讓企業從一個可控、可驗證的流程開始導入 AI，不必一次替換既有系統。', 'From knowledge retrieval and service support to IT incident analysis, Elias Net starts with one controlled, verifiable workflow—without replacing every existing system.', locale)}</p>
      <p class="hero-audience" data-gsap-hero-item>{copy('適合重視權限、人工核准與成果可追溯的 IT、營運及服務團隊。', 'Built for IT, operations and service teams that need clear permissions, human approval and traceable outcomes.', locale)}</p>
      <p class="hero-principle" data-gsap-hero-item>{copy('可用・可控・可證明', 'Useful · Controlled · Provable', locale)}</p>
      <div class="cta-row" data-gsap-hero-item><a class="button primary" href="#products">{copy('查看產品', 'Explore products', locale)}</a><a class="button ghost" href="#method">{copy('規劃 Pilot', 'Plan a pilot', locale)} </a></div>
    </div>
    <div data-gsap-hero-visual><InnovationCore locale={locale} /></div>
  </div>
  <div class="hero-statement shell"><span>{copy('AI 參與工作，但不越過人的責任邊界。', 'AI participates in the work. People retain responsibility.', locale)}</span></div>
</section>
