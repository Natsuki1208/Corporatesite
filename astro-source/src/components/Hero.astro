---
import type { Locale } from '../data/site';
import InnovationCore from './InnovationCore.astro';
interface Props { locale: Locale }
const { locale } = Astro.props;
const en = locale === 'en';
---
<section id="hero" class="hero main-section" data-section="hero" aria-labelledby="hero-title">
  <div class="hero-backdrop" aria-hidden="true"></div>
  <div class="shell hero-grid">
    <div class="hero-copy" data-reveal>
      <p class="section-index">{en ? 'HOME' : '首頁'}</p>
      <p class="brand-kicker">ELIAS NET · {en ? 'CONTROLLED AI FOR REAL WORK' : '企業 AI 產品與導入夥伴'}</p>
      <h1 id="hero-title">{en ? 'Bring AI safely into everyday work.' : '把 AI 安全地接進企業每天的工作'}</h1>
      <p class="hero-lead">{en ? 'From knowledge retrieval and service support to IT incident analysis, Elias Net starts with one controlled, verifiable workflow—without replacing every existing system.' : '從知識查找、服務支援到 IT 事件分析，Elias Net 讓企業從一個可控、可驗證的流程開始導入 AI，不必一次替換既有系統。'}</p>
      <p class="hero-audience">{en ? 'Built for IT, operations and service teams that need clear permissions, human approval and traceable outcomes.' : '適合重視權限、人工核准與成果可追溯的 IT、營運及服務團隊。'}</p>
      <p class="hero-principle">{en ? 'Useful · Controlled · Provable' : '可用・可控・可證明'}</p>
      <div class="cta-row"><a class="button primary" href="#products">{en ? 'Explore products' : '查看產品'}</a><a class="button ghost" href="#method">{en ? 'Plan a pilot' : '規劃 Pilot'} </a></div>
    </div>
    <InnovationCore locale={locale} />
  </div>
  <div class="hero-statement shell"><span>{en ? 'AI participates in the work. People retain responsibility.' : 'AI 參與工作，但不越過人的責任邊界。'}</span></div>
</section>
