---
import type { Locale } from '../data/site';
import { adoptionStages, text } from '../data/site';
interface Props { locale: Locale }
const { locale } = Astro.props;
const en = locale === 'en';
---
<section id="method" class="main-section method light-section" data-section="method" aria-labelledby="method-title">
  <div class="shell">
    <header class="section-heading" data-reveal><p class="section-index">{en ? 'APPROACH' : '導入方法'}</p><h2 id="method-title">{en ? 'You do not have to change everything at once.' : '不必一次改變所有事'}</h2><p>{en ? 'Start with one focused workflow. Validate it before expanding. Every stage has a boundary and a human decision.' : '從小型場景開始，先驗證再擴大。每一階段都有明確邊界，重要決策由人掌握。'}</p></header>
    <div class="method-console" data-method-console data-reveal>
      <ol class="method-path" role="tablist" aria-label={en ? 'AI adoption journey' : 'AI 導入旅程'}>{adoptionStages.map((stage,index) => <li class={index === 0 ? 'active' : ''}><button id={`method-tab-${stage.id}`} type="button" role="tab" aria-selected={index === 0 ? 'true' : 'false'} aria-controls={`method-panel-${stage.id}`} tabindex={index === 0 ? '0' : '-1'} data-method-step={String(index)}><span>{String(index + 1).padStart(2,'0')}</span><b>{text(stage.name,locale)}</b></button></li>)}</ol>
      <div class="method-detail">{adoptionStages.map((stage,index) => <article id={`method-panel-${stage.id}`} role="tabpanel" aria-labelledby={`method-tab-${stage.id}`} data-method-panel hidden={index !== 0}><h3>{text(stage.name,locale)}</h3><dl><div><dt>{en ? 'What happens' : '本階段做什麼'}</dt><dd>{text(stage.action,locale)}</dd></div><div><dt>{en ? 'What you provide' : '客戶提供什麼'}</dt><dd>{text(stage.input,locale)}</dd></div><div><dt>{en ? 'What Elias Net delivers' : 'Elias Net 交付什麼'}</dt><dd>{text(stage.delivery,locale)}</dd></div><div><dt>{en ? 'Before moving on' : '進入下一階段前'}</dt><dd>{text(stage.check,locale)}</dd></div></dl></article>)}</div>
    </div>
    <div class="method-cta" data-reveal><a class="button primary" href="#contact">{en ? 'Plan the first AI opportunity' : '開始規劃第一個 AI 場景'}</a></div>
  </div>
</section>
