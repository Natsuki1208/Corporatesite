---
import type { Locale } from '../data/site';
import { copy } from '../data/site';
interface Props { locale: Locale }
const { locale } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const products = [
  { id:'netops', status:'LAB', image:'elias-netops.webp', name:'ELIAS NETOPS', title:copy('AI 網路與基礎設施協作平台','AI network & infrastructure operations',locale), buyer:copy('軟體訂閱・事件整合閘道・控制台・導入服務','Software subscription · event gateway · control console · integration',locale), description:copy('整合監控、日誌、資安與備份事件，建立事件脈絡、檢查順序與受控處理建議。','Correlate monitoring, logs, security and backup events into context, checks and controlled response recommendations.',locale), boundary:copy('目前聚焦事件關聯、唯讀檢查及人工核准後的可復原操作。','Focused on event correlation, read-only checks and reversible actions after human approval.',locale) },
  { id:'guardian', status:'CONCEPT', image:'elias-guardian.webp', name:'ELIAS GUARDIAN', title:copy('高風險環境設備協作平台','High-risk environment robotics platform',locale), buyer:copy('救援機器人・無人載具管理・邊緣控制站・任務支援','Rescue robotics · unmanned systems management · edge control station · mission support',locale), description:copy('協調非武裝機器人、無人載具與感測設備，支援搜索、巡檢、通訊中繼及物資運送。','Coordinate unarmed robots, unmanned vehicles and sensors for search, inspection, communications and supply delivery.',locale), boundary:copy('只定位於保護、搜索與救援；不自主選擇、追蹤或攻擊人類目標。','Designed only for protection, search and rescue—never autonomous selection, tracking or engagement of human targets.',locale) },
  { id:'medic', status:'CONCEPT', image:'elias-medic.webp', name:'ELIAS MEDIC', title:copy('醫療救援資訊協作平台','Medical rescue coordination platform',locale), buyer:copy('救援協調軟體・物資載具套件・交接介面・導入服務','Response software · supply vehicle kit · handoff interface · integration',locale), description:copy('彙整位置、生命徵象與救援資源，協助醫護與救援人員掌握現場、安排物資及交接資訊。','Bring together location, vital signals and resources to support clinical and rescue coordination.',locale), boundary:copy('不提供獨立診斷或自主分診；所有醫療決策由合格專業人員負責。','No independent diagnosis or autonomous triage; qualified professionals retain every medical decision.',locale) }
];
---
<section id="products" class="main-section autonomy-products" data-section="products" aria-labelledby="products-title">
  <div class="shell">
    <header class="section-heading" data-reveal>
      <p class="section-index">WHAT WE BUILD / {copy('我們提供的產品','PRODUCT SYSTEMS',locale)}</p>
      <h2 id="products-title">{copy('從數位基礎設施，到無法安全抵達的現場。','From digital infrastructure to places people cannot safely reach.',locale)}</h2>
      <p>{copy('三項產品共用 ELIAS CONTROL；客戶取得的不只是 AI 模型，而是軟體、控制設備、受控自主系統與導入服務。','Three products share ELIAS CONTROL. Customers receive software, control infrastructure, bounded autonomous systems and integration—not just a model.',locale)}</p>
    </header>
    <div class="autonomy-product-list">
      {products.map((product,index) => <article class={`autonomy-product product-${product.id}`} data-reveal>
        <div class="autonomy-product-media"><img src={`${base}/images/${product.image}`} alt={product.title} loading={index === 0 ? 'eager' : 'lazy'} width="1800" height="1100"><span>{product.status}</span></div>
        <div class="autonomy-product-copy"><p class="product-sequence">0{index + 1} / 03</p><h3>{product.name}</h3><h4>{product.title}</h4><p>{product.description}</p><div class="product-offer"><strong>{copy('客戶取得','WHAT CUSTOMERS GET',locale)}</strong><span>{product.buyer}</span></div><p class="product-boundary"><strong>{copy('控制界線','CONTROL BOUNDARY',locale)}</strong>{product.boundary}</p></div>
      </article>)}
    </div>
  </div>
</section>
