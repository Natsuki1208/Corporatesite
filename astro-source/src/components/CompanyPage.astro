---
import type { Locale } from '../data/site';
import { copy } from '../data/site';
import Header from './Header.astro';
import Footer from './Footer.astro';
interface Props { locale: Locale }
const { locale } = Astro.props;
const en = locale === 'en';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const principles = [
  { code: '01', name: copy('看懂', 'SEE', locale), body: copy('先理解人正在做什麼、問題卡在哪裡，不急著導入 AI。', 'Understand what people are doing and where work is stuck before introducing AI.', locale) },
  { code: '02', name: copy('深入', 'GO DEEPER', locale), body: copy('進入資料、流程、交接與決策斷點，找出表面看不見的問題。', 'Enter the authorized data, workflow, handoff and decision gaps that remain hidden at the surface.', locale) },
  { code: '03', name: copy('守住', 'PROTECT', locale), body: copy('守住資料、權限、人工核准與責任，不讓 AI 無限制越界。', 'Protect data, access, human approval and accountability instead of letting AI cross every boundary.', locale) },
  { code: '04', name: copy('證明', 'PROVE', locale), body: copy('留下來源、過程、結果與驗證，讓每次改變都可以回頭檢查。', 'Leave sources, steps, outcomes and checks so every change can be reviewed.', locale) }
];
const governance = [
  { code: '01', title: copy('先定義問題', 'FRAME THE WORK', locale), body: copy('說清楚要改善哪一段工作、誰會受到影響、什麼不能被改變。', 'Define the work to improve, who is affected and what must not change.', locale) },
  { code: '02', title: copy('確認資料', 'CHECK THE DATA', locale), body: copy('確認資料從哪裡來、誰能看、是否足夠，以及哪些內容必須排除。', 'Check where information comes from, who can see it, whether it is sufficient and what must be excluded.', locale) },
  { code: '03', title: copy('畫出界線', 'SET THE BOUNDARY', locale), body: copy('設定 AI 可以讀取、建議、整理或執行的範圍；重要動作先停下。', 'Set what AI may read, suggest, organize or do; pause before high-impact actions.', locale) },
  { code: '04', title: copy('實際測試', 'TEST THE RESULT', locale), body: copy('用真實工作情境挑戰假設，檢查答案、流程與例外情況。', 'Challenge assumptions with real work situations, checking answers, flows and exceptions.', locale) },
  { code: '05', title: copy('由人核准', 'AUTHORIZE THE ACTION', locale), body: copy('由有責任的人確認是否可以進入下一階段，並留下原因。', 'An accountable person decides whether the work can move forward and records why.', locale) },
  { code: '06', title: copy('持續觀察', 'MONITOR THE CHANGE', locale), body: copy('追蹤變更、事件與使用情況，知道何時要調整、暫停或退回。', 'Track changes, incidents and use so the team knows when to adjust, pause or roll back.', locale) }
];
const domains = [
  { code: '01', name: copy('醫療與照護支援', 'HEALTHCARE & CARE', locale), body: copy('整理核准的照護、研究與行政資訊，讓專業團隊更快看懂現況。', 'Organize approved care, research and administration information so professionals understand the situation sooner.', locale), engine: 'Knowledge Hub + Signal Studio' },
  { code: '02', name: copy('AI 防護與資料安全', 'AI PROTECTION & DATA SAFETY', locale), body: copy('讓企業知道 AI 能看什麼、能做什麼，並在高影響動作前停下。', 'Make clear what AI can see and do, with a pause before high-impact actions.', locale), engine: 'Ops Sentinel + Control Layer' },
  { code: '03', name: copy('關鍵任務與應變支援', 'CRITICAL MISSION & RESPONSE', locale), body: copy('集合現場資訊、資源與交接，支援重要團隊做出有人負責的決定。', 'Bring field information, resources and handoffs together for accountable decisions.', locale), engine: 'Workflow Orchestrator + Ops Sentinel' },
  { code: '04', name: copy('企業知識與服務協作', 'ENTERPRISE KNOWLEDGE & SERVICE', locale), body: copy('減少重複查找、整理與回覆，讓人把時間留給真正的判斷。', 'Reduce repetitive searching, sorting and replying so people can focus on judgment.', locale), engine: 'Knowledge Hub + Service Copilot' },
  { code: '05', name: copy('多模態資訊與全球應變', 'MULTIMODAL & GLOBAL SIGNAL', locale), body: copy('把文件、聲音、影像、表格與不同語言整理成可核對的重點。', 'Turn documents, audio, images, tables and languages into reviewable signals.', locale), engine: 'Signal Studio + Knowledge Hub' }
];
const milestones = [
  { year: '00', title: copy('公司成立', 'COMPANY FORMED', locale), body: copy('ELIAS NET 以「深入工作、守住責任」作為虛擬科技公司的起點。', 'ELIAS NET begins as a fictional technology company built to go deep into work while keeping responsibility visible.', locale) },
  { year: '01', title: copy('治理原則建立', 'GOVERNANCE DEFINED', locale), body: copy('創辦人、董事會與 QA／Grill 建立 Concept、Lab、Pilot、Production 的判定方式。', 'The founder, board and QA / Grill define gates for Concept, Lab, Pilot and Production.', locale) },
  { year: '02', title: copy('五大領域形成', 'FIVE DOMAINS MAPPED', locale), body: copy('把企業 AI 能力轉成醫療、AI 防護、任務支援、企業工作與全球訊號五個方向。', 'Enterprise AI capabilities become five domains: care, protection, mission support, enterprise work and global signals.', locale) },
  { year: '03', title: copy('從一個流程開始', 'START WITH ONE WORKFLOW', locale), body: copy('每一次 Pilot 都從一個可說清楚、可核准、可驗證的工作流程開始。', 'Every pilot begins with one workflow that can be explained, approved and verified.', locale) }
];
---
<a class="skip-link" href="#main">{en ? 'Skip to main content' : locale === 'zh-CN' ? '跳转到主要内容' : '跳到主要內容'}</a>
<Header locale={locale} page="company" />
<main id="main" class="company-page">
  <section id="company-hero" class="company-hero main-section" data-section="company-hero" data-company-hero aria-labelledby="company-title">
    <div class="company-hero-grid shell">
      <div class="company-hero-copy">
        <p class="section-index" data-company-hero-item>{copy('關於 ELIAS NET／公司檔案', 'ABOUT ELIAS NET / CORPORATE RECORD', locale)}</p>
        <p class="company-eyebrow" data-company-hero-item>{copy('虛擬科技公司／概念示範', 'FICTIONAL VIRTUAL TECHNOLOGY COMPANY / CONCEPT DEMO', locale)}</p>
        <h1 id="company-title" data-company-hero-item>{copy('深入企業工作的每一個斷點。', 'Go deep into the gaps inside real work.', locale)}</h1>
        <p class="company-lead" data-company-hero-item>{copy('ELIAS NET 不是一個孤立的 AI 工具，而是一間把 AI 帶進不同工作現場的虛擬科技公司。', 'ELIAS NET is not an isolated AI tool. It is a fictional technology company bringing AI into the places where real work happens.', locale)}</p>
        <p class="company-thesis" data-company-hero-item>{copy('讓 AI 看見脈絡、推動改變；但不越過人的責任。', 'Let AI see the context and move change forward—without crossing human responsibility.', locale)}</p>
      </div>
      <div class="company-hero-visual" data-company-hero-visual>
        <div class="company-portrait-frame"><img src={`${base}/images/team-founder-elias-ren.png`} alt={copy('ELIAS NET 虛構創辦人 Elias Ren 的寫實概念肖像', 'Photorealistic concept portrait of fictional ELIAS NET founder Elias Ren', locale)} width="1200" height="1500"></div>
        <div class="company-signal company-signal-a">{copy('FICTIONAL / ACCOUNTABLE', 'FICTIONAL / ACCOUNTABLE', locale)}</div>
        <div class="company-signal company-signal-b">{copy('SYSTEM // ONLINE', 'SYSTEM // ONLINE', locale)}</div>
      </div>
    </div>
    <div class="company-hero-statement shell"><span>{copy('表面看見問題，深入才看見斷點。', 'The surface shows the problem. Depth reveals the gap.', locale)}</span><span>25°02′ N / 121°33′ E</span></div>
  </section>

  <section id="company-mission" class="company-mission main-section light-section" data-section="company-mission" aria-labelledby="mission-title">
    <div class="shell">
      <header class="section-heading" data-reveal data-gsap="section-heading">
        <p class="section-index">{copy('公司使命／公開版本', 'CORPORATE MISSION / PUBLIC', locale)}</p>
        <h2 id="mission-title">{copy('把被忽略的問題逼近，讓改變留下證據。', 'Move closer to the overlooked problem. Leave evidence of the change.', locale)}</h2>
        <p>{copy('我們把人的工作、AI 的協助與企業的責任放在同一條路徑上。深入，不是越界；是把真正卡住的地方看清楚。', 'We put human work, AI assistance and enterprise accountability on one path. Going deep is not crossing a boundary—it is making the real blockage visible.', locale)}</p>
      </header>
      <div class="principle-grid">
        {principles.map((item) => <article data-company-card data-reveal><span>{item.code}</span><h3>{item.name}</h3><p>{item.body}</p></article>)}
      </div>
    </div>
  </section>

  <section id="company-founder" class="company-founder main-section" data-section="company-founder" aria-labelledby="founder-title">
    <div class="shell company-founder-grid">
      <div class="founder-file" data-company-card data-reveal>
        <p class="section-index">{copy('虛擬創辦人檔案', 'FICTIONAL FOUNDER FILE', locale)}</p>
        <div class="founder-file-head"><span>EN / 001</span><span>ELIAS NET</span></div>
        <div class="founder-file-mark" aria-hidden="true"><b>EN</b><i></i></div>
        <p class="founder-file-status">{copy('角色狀態：概念示範／非真實任職', 'ROLE STATUS: CONCEPT DEMO / NOT REAL EMPLOYMENT', locale)}</p>
      </div>
      <div class="founder-copy" data-reveal>
        <p class="eyebrow">{copy('FOUNDER’S VISION', 'FOUNDER’S VISION', locale)}</p>
        <h2 id="founder-title">{copy('科技的價值，不在於它能做多少，而在於它知道何時應該停下。', 'Technology is not measured by how much it can do, but by whether it knows when to stop.', locale)}</h2>
        <p>{copy('Elias Ren 是 ELIAS NET 的虛構創辦人暨執行董事長。他把公司建立在一個簡單問題上：如果 AI 要進入真正的工作，它是否能同時看見脈絡、尊重界線，並接受人的確認？', 'Elias Ren is the fictional founder and executive chair of ELIAS NET. He builds the company around one question: if AI enters real work, can it see context, respect boundaries and accept human review at the same time?', locale)}</p>
        <blockquote>{copy('讓 AI 先學會界線，再進入流程；讓人先保有責任，再擴大自動化。', 'Teach AI its boundaries before it enters the workflow. Keep human accountability before expanding automation.', locale)}</blockquote>
      </div>
    </div>
  </section>

  <section id="company-organization" class="company-organization main-section light-section" data-section="company-organization" aria-labelledby="organization-title">
    <div class="shell">
      <header class="section-heading" data-reveal data-gsap="section-heading">
        <p class="section-index">{copy('公司組織／權責地圖', 'COMPANY ORGANIZATION / ACCOUNTABILITY MAP', locale)}</p>
        <h2 id="organization-title">{copy('不是一群名字，而是一條有人負責的決策鏈。', 'Not a wall of names—a decision chain with accountable owners.', locale)}</h2>
        <p>{copy('ELIAS NET 讓創辦人、董事會、高階管理團隊、專業中心、產品領域與獨立驗收各自站在清楚的位置。', 'ELIAS NET gives the founder, board, executive team, professional centers, product domains and independent assurance a clear place in the company.', locale)}</p>
      </header>
      <div class="company-org-map" data-company-card data-reveal>
        <div class="org-layer org-company"><span>01</span><strong>{copy('ELIAS NET 虛擬科技公司', 'ELIAS NET VIRTUAL TECHNOLOGY COMPANY', locale)}</strong></div>
        <div class="org-connector" aria-hidden="true"></div>
        <div class="org-layer org-founder"><span>02</span><strong>{copy('創辦人暨執行董事長／Elias Ren', 'FOUNDER & EXECUTIVE CHAIR / Elias Ren', locale)}</strong></div>
        <div class="org-connector" aria-hidden="true"></div>
        <div class="org-layer org-board"><span>03</span><strong>{copy('虛擬董事會／治理委員會', 'VIRTUAL BOARD / GOVERNANCE COUNCIL', locale)}</strong><small>{copy('產品體驗／第一性原理／平台成長／企業信任', 'Product experience / first principles / platform growth / enterprise trust', locale)}</small></div>
        <div class="org-connector" aria-hidden="true"></div>
        <div class="org-split">
          <div class="org-layer"><span>04A</span><strong>CEO · COO · CTO</strong><small>{copy('方向／交付／技術', 'Direction / delivery / technology', locale)}</small></div>
          <div class="org-layer"><span>04B</span><strong>CIO · CPO · CBO</strong><small>{copy('資料／產品／市場', 'Data / product / market', locale)}</small></div>
        </div>
        <div class="org-connector" aria-hidden="true"></div>
        <div class="org-split org-bottom">
          <div class="org-layer"><span>05</span><strong>{copy('專業中心', 'PROFESSIONAL CENTERS', locale)}</strong><small>{copy('品牌／產品／AI／前端／資安／網路／維運', 'Brand / product / AI / frontend / security / network / operations', locale)}</small></div>
          <div class="org-layer org-assurance"><span>06</span><strong>{copy('獨立驗收／QA · Grill', 'INDEPENDENT ASSURANCE / QA · Grill', locale)}</strong><small>{copy('沒有證據，不進下一階段。', 'No evidence, no next stage.', locale)}</small></div>
        </div>
      </div>
    </div>
  </section>

  <section id="company-governance" class="company-governance main-section" data-section="company-governance" aria-labelledby="governance-title">
    <div class="shell">
      <header class="section-heading" data-reveal data-gsap="section-heading">
        <p class="section-index">{copy('治理協議／從意圖到監測', 'GOVERNANCE PROTOCOL / FROM INTENT TO MONITORING', locale)}</p>
        <h2 id="governance-title">{copy('每一次前進，都必須通過一個看得懂的閘門。', 'Every step forward passes through a gate people can understand.', locale)}</h2>
        <p>{copy('治理不是頁尾的免責聲明，而是產品、人物與公司每天做決定的方式。', 'Governance is not a disclaimer at the bottom of a page. It is how the company makes decisions every day.', locale)}</p>
      </header>
      <div class="company-governance-flow" data-company-timeline>
        <div class="company-governance-line" aria-hidden="true"><i></i></div>
        {governance.map((item,index) => <article data-company-card data-reveal style={`--i:${index}`}><span>{item.code}</span><h3>{item.title}</h3><p>{item.body}</p></article>)}
      </div>
    </div>
  </section>

  <section id="company-domains" class="company-domains main-section light-section" data-section="company-domains" aria-labelledby="domains-title">
    <div class="shell">
      <header class="section-heading" data-reveal data-gsap="section-heading">
        <p class="section-index">{copy('五大產品領域／公司矩陣', 'FIVE PRODUCT DOMAINS / COMPANY MATRIX', locale)}</p>
        <h2 id="domains-title">{copy('同一套責任制度，進入五種重要現場。', 'One accountability system for five places that matter.', locale)}</h2>
        <p>{copy('五大領域讓 ELIAS NET 像一間公司，而不是把同一個 AI 名稱重複貼在五張卡片上。', 'Five distinct domains make ELIAS NET feel like a company—not the same AI name repeated across five cards.', locale)}</p>
      </header>
      <div class="company-domain-grid">
        {domains.map((domain) => <article data-company-card data-reveal><div class="domain-card-head"><span>{domain.code}</span><span>ELIAS NET</span></div><h3>{domain.name}</h3><p>{domain.body}</p><small>{copy('核心引擎／', 'CORE ENGINES / ', locale)}{domain.engine}</small></article>)}
      </div>
    </div>
  </section>

  <section id="company-record" class="company-record main-section" data-section="company-record" aria-labelledby="record-title">
    <div class="shell">
      <header class="section-heading" data-reveal data-gsap="section-heading">
        <p class="section-index">{copy('虛擬公司紀錄／概念時間線', 'VIRTUAL COMPANY RECORD / CONCEPT TIMELINE', locale)}</p>
        <h2 id="record-title">{copy('用可追蹤的制度，承接一間公司的長期願景。', 'Carry a company’s long-term vision through a traceable record.', locale)}</h2>
        <p>{copy('這不是對真實營運歷史的聲稱，而是 ELIAS NET 目前的虛擬公司宇宙紀錄。', 'This is not a claim of real operating history. It is the current fictional record of the ELIAS NET company world.', locale)}</p>
      </header>
      <div class="company-record-list">
        {milestones.map((item,index) => <article data-company-card data-reveal style={`--i:${index}`}><span>{item.year}</span><div><h3>{item.title}</h3><p>{item.body}</p></div></article>)}
      </div>
    </div>
  </section>

  <section id="company-start" class="company-start main-section light-section" data-section="company-start" aria-labelledby="start-title">
    <div class="shell company-start-grid">
      <div data-reveal><p class="section-index">{copy('下一個工作現場', 'THE NEXT WORK ENVIRONMENT', locale)}</p><h2 id="start-title">{copy('先選一個值得深入的流程。', 'Choose one workflow worth going deeper into.', locale)}</h2><p>{copy('從一個能說清楚、能獲得授權、能留下證據的 Pilot 開始，讓 ELIAS NET 的理念在真正的工作裡被檢驗。', 'Start with one pilot that can be explained, authorized and evidenced, then let ELIAS NET be tested in real work.', locale)}</p></div>
      <a class="company-start-button" href={en ? `${base}/en/#contact` : locale === 'zh-CN' ? `${base}/zh-cn/#contact` : `${base}/#contact`} data-reveal><span>{copy('開始一段對話', 'START A CONVERSATION', locale)}</span><strong>→</strong></a>
    </div>
  </section>
</main>
<Footer locale={locale} page="company" />
