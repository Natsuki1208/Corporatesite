---
import type { SiteLocale } from '../../data/products';
import { simplify } from '../../data/simplified-map';
import RobotModelGrid from './RobotModelGrid.astro';
import CTA from './CTA.astro';
const { locale }=Astro.props as {locale:SiteLocale};
const base=import.meta.env.BASE_URL.replace(/\/$/,'');
const prefix=locale==='en'?`${base}/en/`:locale==='zh-CN'?`${base}/zh-cn/`:`${base}/`;
const t=(zh:string,en:string)=>locale==='en'?en:locale==='zh-CN'?simplify(zh):zh;
---
<div class="v2-ai-robots">
  <section class="v2-robot-hero">
    <img src={`${base}/images/v2/robot-models/care-arc-hc02.jpg`} alt={t('原創人工智慧機器人在明亮空間中準備協助人類','An original AI robot ready to assist people in a bright environment')} width="1800" height="1350"/>
    <div class="v2-robot-hero-shade" aria-hidden="true"></div>
    <div class="v2-shell v2-robot-hero-copy v2-reveal">
      <p class="v2-eyebrow">AI ROBOTICS / {t('人工智慧機器人','AI ROBOTS')}</p>
      <h1>{t('理解環境，與人一起行動。','Understand environments. Move forward with people.')}</h1>
      <p>{t('從居家生活到危險現場，AI 機器人提供協助，每個任務都由人設定、確認與停止。','From daily life to hazardous environments, AI robots assist while people set, confirm and stop every mission.')}</p>
      <CTA href="#models" label={t('查看產品型號','Explore models')} locale={locale}/>
    </div>
  </section>

  <section class="v2-section v2-robot-explainer"><div class="v2-shell v2-two-grid">
    <article class="v2-reveal"><p class="v2-eyebrow">UNDERSTAND</p><h2>{t('先理解需要，再提供剛好的協助。','Understand the need, then offer the right help.')}</h2><p>{t('感測器取得環境資訊，AI 整理情況並準備動作；人們隨時可以調整或停止。','Sensors capture the environment. AI organizes the situation and prepares an action, while people can adjust or stop it at any time.')}</p></article>
    <ol class="v2-robot-steps v2-reveal"><li><span>01</span><strong>{t('看見環境','Sense the environment')}</strong></li><li><span>02</span><strong>{t('理解需求','Understand the need')}</strong></li><li><span>03</span><strong>{t('準備協助','Prepare assistance')}</strong></li><li><span>04</span><strong>{t('由人確認行動','People confirm the action')}</strong></li></ol>
  </div></section>

  <section id="models" class="v2-section v2-robot-models"><div class="v2-shell">
    <header class="v2-section-head v2-reveal"><p class="v2-eyebrow">PRODUCT ARCHITECTURE + MODELS</p><h2>{t('兩個方向，六種任務型號。','Two directions. Six mission-focused models.')}</h2><p>{t('居家系列協助日常；救援系列協助專業人員掌握危險、運送物資。以下皆為概念機型。','The home series supports daily life. The rescue series helps professionals understand hazards and move supplies. All models shown are concepts.')}</p></header>
    <RobotModelGrid locale={locale}/>
  </div></section>

  <section class="v2-section v2-robot-trust"><div class="v2-shell v2-two-grid"><article><p class="v2-eyebrow">HUMAN CONTROL</p><h2>{t('任務、停止與接管權，都留在人手上。','People retain task, stop and takeover authority.')}</h2></article><article><p>{t('居家任務由使用者與家庭設定；救援任務由專業人員指揮。系統可以感測、回報與執行核准動作，但不會自行改變目標。','Users and families define home tasks; professional responders direct rescue missions. The system can sense, report and perform approved actions, but it does not change the objective on its own.')}</p><CTA href={`${prefix}safety/`} label={t('查看控制機制','Review control mechanisms')} locale={locale} secondary/></article></div></section>
</div>
