---
import type { SiteLocale } from '../../data/products';
interface Props { locale: SiteLocale; title?: string }
const { locale, title = locale === 'en' ? 'Permissions, human review and stop controls' : locale === 'zh-CN' ? '权限、人工确认与停止方式' : '權限、人工確認與停止方式' } = Astro.props;
---
<aside class="v2-safety" aria-labelledby="safety-notice-title">
  <p class="v2-eyebrow">{locale === 'en' ? 'CONTROL BOUNDARIES' : locale === 'zh-CN' ? '控制边界' : '控制界線'}</p>
  <h2 id="safety-notice-title">{title}</h2>
  <slot />
</aside>
