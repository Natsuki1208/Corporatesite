---
import type { ProductDefinition, SiteLocale } from '../../data/products';
import { simplify } from '../../data/simplified-map';
import { l, products } from '../../data/products';
import SafetyNotice from './SafetyNotice.astro'; import ProductPageLayout from './ProductPageLayout.astro'; import CTASection from './CTASection.astro';
import ResponsivePicture from './ResponsivePicture.astro';
import ProductMotionPrototype from './motion/ProductMotionPrototype.astro';
interface Props { product: ProductDefinition; locale: SiteLocale }
const { product, locale }=Astro.props; const base=import.meta.env.BASE_URL.replace(/\/$/,''); const prefix=locale==='en'?`${base}/en/`:locale==='zh-CN'?`${base}/zh-cn/`:`${base}/`; const t=(zh:string,en:string)=>locale==='en'?en:locale==='zh-CN'?simplify(zh):zh; const statusLabel=locale==='en'?(product.status==='概念'?'Concept':product.status==='原型'?'Prototype':product.status):locale==='zh-CN'?simplify(product.status):product.status;
const mediaUrl=(path:string)=>`${base}/${path}`;
const productPosition=products.findIndex((item)=>item.slug===product.slug);
const previousProduct=products[(productPosition-1+products.length)%products.length];
const nextProduct=products[(productPosition+1)%products.length];
---
<ProductPageLayout product={product} locale={locale} prefix={prefix}>
<ProductMotionPrototype product={product} locale={locale}/>
{product.media.secondary&&<section class="v2-product-evidence"><div class="v2-product-evidence-image"><ResponsivePicture desktop={mediaUrl(product.media.secondary.desktop)} mobile={mediaUrl(product.media.secondary.mobile)} alt={l(product.media.secondary.alt,locale)}/></div><div class="v2-product-evidence-copy v2-reveal"><p class="v2-eyebrow">{t('人與智慧系統並肩工作','PEOPLE AND INTELLIGENCE, SIDE BY SIDE')}</p><h2>{t('讓人工智能更好地陪伴人類，一起創造未來。','Artificial intelligence alongside people, creating the future together.')}</h2><p>{l(product.collaboration,locale)}</p></div></section>}
<section id="product-value" class="v2-product-programs"><div class="v2-shell"><header class="v2-programs-head"><div><p class="v2-eyebrow">{t('產品價值 / 01','PRODUCT VALUE / 01')}</p><h2>{t('從每天真正發生的問題開始。','Built around the work that actually happens.')}</h2></div><p>{l(product.problem,locale)}</p></header><div class="v2-program-grid">{product.values.map((item,index)=><article class="v2-program-card v2-reveal"><span>0{index+1}</span><h3>{l(item,locale)}</h3><p>{index===0?t('先把分散的資訊與問題整理清楚。','Bring scattered information and problems into focus.'):index===1?t('讓建議有來源、有脈絡，也更容易確認。','Make suggestions easier to understand and verify.'):t('人工智能準備協助，我們一起把下一步完成。','Artificial intelligence prepares support, and we complete the next step together.')}</p></article>)}</div></div></section>
<section id="product-capabilities" class="v2-product-chapter"><div class="v2-shell v2-product-chapter-grid"><div class="v2-chapter-title"><p class="v2-eyebrow">{t('一起工作的方式 / 02','HOW WE WORK TOGETHER / 02')}</p><h2>{t('人工智能準備協助，我們一起完成。','Artificial intelligence prepares support. People complete the work together.')}</h2></div><div><p class="v2-chapter-intro">{l(product.collaboration,locale)}</p><ol class="v2-capability-list">{product.capabilities.map((item,index)=><li><span>{String(index+1).padStart(2,'0')}</span><strong>{l(item,locale)}</strong></li>)}</ol></div></div></section>
<section class="v2-product-audience"><div class="v2-shell v2-product-audience-grid"><div><p class="v2-eyebrow">{t('適合的工作現場 / 03','WHERE IT FITS / 03')}</p><h2>{t('為真正要把事情完成的人而設計。','Designed for the people responsible for getting work done.')}</h2></div><ul>{product.audience.map((item,index)=><li><span>0{index+1}</span>{l(item,locale)}</li>)}</ul></div></section>
<section class="v2-section v2-dark"><div class="v2-shell v2-two-grid"><div><p class="v2-eyebrow">{t('合作默契 / 04','A TRUSTED WAY OF WORKING / 04')}</p><h2>{t('彼此有默契，陪伴才能走得長久。','Trust and understanding make lasting collaboration possible.')}</h2><p>{l(product.collaboration,locale)}</p></div><div><p class="v2-eyebrow">{t('資料與權限需求','DATA AND PERMISSIONS')}</p><p>{l(product.dataPermissions,locale)}</p></div></div></section>
<section id="product-safety" class="v2-section"><div class="v2-shell"><SafetyNotice locale={locale}><div class="v2-two-grid"><div><h3>{t('安心合作的設計','Designed for trusted collaboration')}</h3><ul class="v2-check-list">{product.safeguards.map((item)=><li>{l(item,locale)}</li>)}</ul></div><div><h3>{t('產品不會做什麼','What the product will not do')}</h3><ul class="v2-limit-list">{product.limitations.map((item)=><li>{l(item,locale)}</li>)}</ul></div></div></SafetyNotice></div></section>
<section class="v2-section v2-tint"><div class="v2-shell v2-two-grid"><div><p class="v2-eyebrow">{t('目前研發狀態','CURRENT STATUS')}</p><h2>{statusLabel}</h2><p>{l(product.statusNote,locale)}</p></div><div><p class="v2-eyebrow">{t('下一階段研發方向','NEXT RESEARCH STEP')}</p><p>{l(product.next,locale)}</p></div></div></section>
<nav class="v2-product-next" aria-label={t('瀏覽其他產品','Browse other products')}><a href={`${prefix}products/${previousProduct.slug}/`}><small>{t('上一項產品','Previous product')}</small><strong>← {previousProduct.name}</strong></a><a href={`${prefix}products/${nextProduct.slug}/`}><small>{t('下一項產品','Next product')}</small><strong>{nextProduct.name} →</strong></a></nav>
<div id="collaboration"><CTASection locale={locale} title={product.slug==='elias-home'?t('想優先收到 Elias Home 的消息？','Want early updates about Elias Home?'):l(product.cta,locale)} copy={product.slug==='elias-home'?t('登記預購意向，未來有新的研究、展示或產品規劃時，我們會優先通知。此登記不是正式訂單，也不收取款項。','Register pre-order interest for priority updates on research, demonstrations or product plans. This is not an order and no payment is collected.'):t('我們會先確認問題、資料或環境、限制與驗證方式，再決定適合的合作範圍。','We will first confirm the problem, data or environment, constraints and validation approach before defining the collaboration scope.')} href={`${prefix}contact/`} label={product.slug==='elias-home'?t('登記預購意向','Register pre-order interest'):l(product.cta,locale)}/></div></ProductPageLayout>
