---
import type { ProductDefinition, SiteLocale } from '../../data/products';
import { simplify } from '../../data/simplified-map';
import { l, products } from '../../data/products';
import SafetyNotice from './SafetyNotice.astro'; import ProductPageLayout from './ProductPageLayout.astro'; import CTASection from './CTASection.astro';
import ResponsivePicture from './ResponsivePicture.astro';
import ProductMotionPrototype from './motion/ProductMotionPrototype.astro';
interface Props { product: ProductDefinition; locale: SiteLocale }
const { product, locale }=Astro.props; const base=import.meta.env.BASE_URL.replace(/\/$/,''); const prefix=locale==='en'?`${base}/en/`:locale==='zh-CN'?`${base}/zh-cn/`:`${base}/`; const t=(zh:string,en:string)=>locale==='en'?en:locale==='zh-CN'?simplify(zh):zh; const statusLabel=locale==='en'?(product.status==='概念'?'Concept':product.status==='原型'?'Prototype':product.status):locale==='zh-CN'?simplify(product.status):product.status;
const mediaUrl=(path:string)=>`${base}/${path}`;
const hasHeroVideo=['elias-knowledge','elias-care','elias-flow','elias-ops','elias-home','elias-rescue'].includes(product.slug);
const storyTitle:Record<string,{zh:string;en:string}>={
  'elias-knowledge':{zh:'先找到依據，再放心使用答案。',en:'Find the source first, then use the answer with confidence.'},
  'elias-care':{zh:'資訊先整理，回覆仍有人的溫度。',en:'Organize the context while keeping the human touch.'},
  'elias-flow':{zh:'工作排清楚，團隊自然接得上。',en:'Clarify the work so the team can keep moving.'},
  'elias-ops':{zh:'線索集中後，更快看清真正影響。',en:'Bring the signals together and see the real impact faster.'},
  'elias-home':{zh:'先問清楚，再把需要送到身邊。',en:'Ask first, then bring the right help closer.'},
  'elias-rescue':{zh:'先回傳現場，再由救援團隊決定路線。',en:'Relay the scene first, then let responders choose the route.'}
};
const ambientLabel:Record<string,string>={
  'elias-knowledge':'TRUST STARTS WITH SOURCES',
  'elias-care':'EMPATHY GUIDES INTELLIGENCE',
  'elias-flow':'CLEAR WORK MOVES FORWARD',
  'elias-ops':'CLARITY BEFORE ACTION',
  'elias-home':'TECHNOLOGY WITHIN REACH',
  'elias-rescue':'HUMANS LEAD THE MISSION'
};
const evidenceTitle:Record<string,{zh:string;en:string}>={
  'elias-knowledge':{zh:'答案附上來源，團隊才放心使用。',en:'Answers earn trust when the source is visible.'},
  'elias-flow':{zh:'每一步都看得見，交接不用再猜。',en:'When every step is visible, handoffs stay clear.'},
  'elias-ops':{zh:'看清影響，團隊才能安心判斷。',en:'See the impact clearly, then decide with confidence.'},
  'elias-home':{zh:'協助融入日常，不打斷生活。',en:'Support that fits daily life without taking it over.'},
  'elias-rescue':{zh:'讓機器先進場，讓人掌握風險。',en:'Send the robot first so people can understand the risk.'}
};
const valueTitle:Record<string,{zh:string;en:string}>={
  'elias-knowledge':{zh:'可信答案，更快找到。',en:'Trusted answers, found faster.'},
  'elias-care':{zh:'更快回覆，也更一致。',en:'Faster replies. More consistent service.'},
  'elias-flow':{zh:'進度清楚，交接更順。',en:'Clear progress. Smoother handoffs.'},
  'elias-ops':{zh:'判斷更聚焦，處理更精準。',en:'Focused assessment. More precise response.'},
  'elias-home':{zh:'剛好的協助，不打擾生活。',en:'The right help without taking over daily life.'},
  'elias-rescue':{zh:'多一分現場資訊，少一分人員風險。',en:'More field insight. Less risk to responders.'}
};
const navigationGroup=product.family==='embodied'
  ? products.filter((item)=>item.family==='embodied')
  : ['elias-knowledge','elias-care'].includes(product.slug)
    ? products.filter((item)=>['elias-knowledge','elias-care'].includes(item.slug))
    : products.filter((item)=>['elias-flow','elias-ops'].includes(item.slug));
const productPosition=navigationGroup.findIndex((item)=>item.slug===product.slug);
const previousProduct=navigationGroup[(productPosition-1+navigationGroup.length)%navigationGroup.length];
const nextProduct=navigationGroup[(productPosition+1)%navigationGroup.length];
---
<ProductPageLayout product={product} locale={locale} prefix={prefix}>
{hasHeroVideo?<section id="product-story" class="v2-product-story-brief" data-ambient-label={ambientLabel[product.slug]}><div class="v2-shell v2-product-story-brief-grid"><div><p class="v2-eyebrow">{t('真人協作情境','LIVE HUMAN + AI COLLABORATION')}</p><h2>{t(storyTitle[product.slug].zh,storyTitle[product.slug].en)}</h2></div><div><p>{l(product.scenario,locale)}</p><ol><li>{t('看見情況','See the situation')}</li><li>{t('整理重點','Organize what matters')}</li><li>{t('由人決定','People decide')}</li></ol></div></div></section>:<ProductMotionPrototype product={product} locale={locale}/>}
{product.media.secondary&&<section class="v2-product-evidence"><div class="v2-product-evidence-image"><ResponsivePicture desktop={mediaUrl(product.media.secondary.desktop)} mobile={mediaUrl(product.media.secondary.mobile)} alt={l(product.media.secondary.alt,locale)}/></div><div class="v2-product-evidence-copy v2-reveal"><p class="v2-eyebrow">{t('人與智慧系統並肩工作','PEOPLE AND INTELLIGENCE, SIDE BY SIDE')}</p><h2>{t(evidenceTitle[product.slug].zh,evidenceTitle[product.slug].en)}</h2><p>{l(product.collaboration,locale)}</p></div></section>}
<section id="product-value" class="v2-product-programs"><div class="v2-shell"><header class="v2-programs-head"><div><p class="v2-eyebrow">{t('產品價值 / 01','PRODUCT VALUE / 01')}</p><h2>{valueTitle[product.slug]?t(valueTitle[product.slug].zh,valueTitle[product.slug].en):t('從真正需要改善的事開始。','Start with something worth improving.')}</h2></div><p>{l(product.problem,locale)}</p></header><div class="v2-program-grid">{product.values.map((item,index)=><article class="v2-program-card v2-reveal"><span>0{index+1}</span><h3>{l(item,locale)}</h3></article>)}</div></div></section>
<section id="product-capabilities" class="v2-product-chapter"><div class="v2-shell v2-product-chapter-grid"><div class="v2-chapter-title"><p class="v2-eyebrow">{t('一起工作的方式 / 02','HOW WE WORK TOGETHER / 02')}</p><h2>{product.family==='digital'?t('分工清楚，合作更順。','Clear roles make better work.'):t('人來指揮，系統協助。','People lead. The system assists.')}</h2></div><div><p class="v2-chapter-intro">{l(product.collaboration,locale)}</p><ol class="v2-capability-list">{product.capabilities.map((item,index)=><li><span>{String(index+1).padStart(2,'0')}</span><strong>{l(item,locale)}</strong></li>)}</ol></div></div></section>
<section class="v2-product-audience"><div class="v2-shell v2-product-audience-grid"><div><p class="v2-eyebrow">{t('適合誰 / 03','WHO IT HELPS / 03')}</p><h2>{t('為每天使用它的人而設計。','Designed for the people who use it every day.')}</h2></div><ul>{product.audience.map((item,index)=><li><span>0{index+1}</span>{l(item,locale)}</li>)}</ul></div></section>
<section class="v2-section v2-dark"><div class="v2-shell v2-two-grid"><div><p class="v2-eyebrow">{t('開始前先確認 / 04','BEFORE WE BEGIN / 04')}</p><h2>{t('先說清楚範圍，再安心開始。','Set a clear scope, then begin with confidence.')}</h2><p>{t('先確認誰會使用、要完成什麼，以及哪些步驟需要人員確認。','First confirm who will use it, what it should do and which steps need human review.')}</p></div><div><p class="v2-eyebrow">{t('需要的資料與權限','DATA AND PERMISSIONS')}</p><p>{l(product.dataPermissions,locale)}</p></div></div></section>
<section id="product-safety" class="v2-section"><div class="v2-shell"><SafetyNotice locale={locale}><div class="v2-two-grid"><div><h3>{t('讓人安心的設計','Designed for confidence')}</h3><ul class="v2-check-list">{product.safeguards.map((item)=><li>{l(item,locale)}</li>)}</ul></div><div><h3>{t('產品不會做什麼','What the product will not do')}</h3><ul class="v2-limit-list">{product.limitations.map((item)=><li>{l(item,locale)}</li>)}</ul></div></div></SafetyNotice></div></section>
<section class="v2-section v2-tint"><div class="v2-shell v2-two-grid"><div><p class="v2-eyebrow">{t('目前進度','CURRENT STATUS')}</p><h2>{statusLabel}</h2><p>{l(product.statusNote,locale)}</p></div><div><p class="v2-eyebrow">{t('接下來','WHAT COMES NEXT')}</p><p>{l(product.next,locale)}</p></div></div></section>
<nav class="v2-product-next" aria-label={t('瀏覽其他產品','Browse other products')}><a href={`${prefix}products/${previousProduct.slug}/`}><small>{t('上一項產品','Previous product')}</small><strong>← {previousProduct.name}</strong></a><a href={`${prefix}products/${nextProduct.slug}/`}><small>{t('下一項產品','Next product')}</small><strong>{nextProduct.name} →</strong></a></nav>
<div id="collaboration"><CTASection locale={locale} title={product.slug==='elias-home'?t('想優先收到 Elias Home 的消息？','Want early updates about Elias Home?'):product.slug==='elias-rescue'?t('想一起驗證專業救援情境？','Interested in validating a professional rescue scenario?'):t('想從一個真實工作問題開始？','Ready to start with a real work problem?')} copy={product.slug==='elias-home'?t('登記產品消息，未來有新的研究、展示或產品規劃時，我們會優先通知。此登記不是正式訂單，也不收取款項。','Register for product updates on future research, demonstrations or product plans. This is not an order and no payment is collected.'):product.slug==='elias-rescue'?t('帶著救援流程、環境限制與專業需求來交流，我們會先確認適合驗證的範圍。','Bring a rescue workflow, environmental constraints and professional needs. We will first define a responsible scope for validation.'):t('選一個流程或使用情境，我們會一起確認需求、資料、成功條件與適合的原型範圍。','Choose one workflow or use case. Together we will confirm the need, data, success criteria and a suitable prototype scope.')} href={`${prefix}contact/`} label={product.slug==='elias-home'?t('登記產品消息','Register for product updates'):product.slug==='elias-rescue'?t('討論救援研究','Discuss rescue research'):t('討論原型合作','Discuss a prototype collaboration')}/></div></ProductPageLayout>
