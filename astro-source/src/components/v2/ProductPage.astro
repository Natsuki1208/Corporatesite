---
import type { ProductDefinition, SiteLocale } from '../../data/products';
import { simplify } from '../../data/simplified-map';
import { l, products } from '../../data/products';
import SafetyNotice from './SafetyNotice.astro'; import ProductPageLayout from './ProductPageLayout.astro'; import CTASection from './CTASection.astro';
import ResponsivePicture from './ResponsivePicture.astro';
import ProductMotionPrototype from './motion/ProductMotionPrototype.astro';
interface Props { product: ProductDefinition; locale: SiteLocale }
const { product, locale }=Astro.props; const base=import.meta.env.BASE_URL.replace(/\/$/,''); const prefix=locale==='en'?`${base}/en/`:locale==='zh-CN'?`${base}/zh-cn/`:`${base}/`; const t=(zh:string,en:string)=>locale==='en'?en:locale==='zh-CN'?simplify(zh):zh; const statusLabel=locale==='en'?(product.status==='概念'?'Concept':product.status==='原型'?'Prototype':product.status):locale==='zh-CN'?simplify(product.status):product.status;
const mediaUrl=(path:string)=>`${base}/${path}`;
const hasHeroVideo=['elias-knowledge','elias-care','elias-flow','elias-ops','elias-home','elias-rescue'].includes(product.slug);
const storyTitle:Record<string,{zh:string;en:string}>={
  'elias-knowledge':{zh:'從一個提問，找到相關政策。',en:'Start with a question. Find the relevant policy.'},
  'elias-care':{zh:'從理解問題，到準備一則經過確認的回應。',en:'From understanding the question to preparing a reviewed response.'},
  'elias-flow':{zh:'從收到資料，到完成確認與交接。',en:'From receiving information to review and handoff.'},
  'elias-ops':{zh:'多項告警，放回同一事件脈絡。',en:'Put related alerts into one incident context.'},
  'elias-home':{zh:'先問清楚，再把需要送到身邊。',en:'Ask first, then bring the right help closer.'},
  'elias-rescue':{zh:'先回傳現場，再由救援團隊決定路線。',en:'Relay the scene first, then let responders choose the route.'}
};
const ambientLabel:Record<string,string>={
  'elias-knowledge':'TRUST STARTS WITH SOURCES',
  'elias-care':'EMPATHY GUIDES INTELLIGENCE',
  'elias-flow':'CLEAR WORK MOVES FORWARD',
  'elias-ops':'CLARITY BEFORE ACTION',
  'elias-home':'TECHNOLOGY WITHIN REACH',
  'elias-rescue':'HUMANS LEAD THE MISSION'
};
const evidenceTitle:Record<string,{zh:string;en:string}>={
  'elias-knowledge':{zh:'一起核對引用與文件版本。',en:'Review citations and document versions together.'},
  'elias-flow':{zh:'例外與處理紀錄，留給下一位接手。',en:'Keep exceptions and records clear for the next owner.'},
  'elias-ops':{zh:'團隊確認影響，再授權下一步。',en:'The team reviews the impact and authorizes the next step.'},
  'elias-home':{zh:'協助融入日常，不打斷生活。',en:'Support that fits daily life without taking it over.'},
  'elias-rescue':{zh:'讓機器先進場，讓人掌握風險。',en:'Send the robot first so people can understand the risk.'}
};
const valueTitle:Record<string,{zh:string;en:string}>={
  'elias-knowledge':{zh:'減少翻找，把時間留給判斷。',en:'Spend less time searching and more time assessing.'},
  'elias-care':{zh:'更快回覆，也更一致。',en:'Faster replies. More consistent service.'},
  'elias-flow':{zh:'進度清楚，交接更順。',en:'Clear progress. Smoother handoffs.'},
  'elias-ops':{zh:'判斷更聚焦，處理更精準。',en:'Focused assessment. More precise response.'},
  'elias-home':{zh:'剛好的協助，不打擾生活。',en:'The right help without taking over daily life.'},
  'elias-rescue':{zh:'多一分現場資訊，少一分人員風險。',en:'More field insight. Less risk to responders.'}
};
const navigationGroup=product.family==='embodied'
  ? products.filter((item)=>item.family==='embodied')
  : ['elias-knowledge','elias-care'].includes(product.slug)
    ? products.filter((item)=>['elias-knowledge','elias-care'].includes(item.slug))
    : products.filter((item)=>['elias-flow','elias-ops'].includes(item.slug));
const productPosition=navigationGroup.findIndex((item)=>item.slug===product.slug);
const relatedProduct=navigationGroup[(productPosition+1)%navigationGroup.length];
const collectionPath=product.family==='embodied'?'ai-robots/':['elias-knowledge','elias-care'].includes(product.slug)?'digital-intelligence/knowledge-service/':'digital-intelligence/operations-workflow/';
const collectionLabel=product.family==='embodied'?t('人工智慧機器人','AI Robotics'):['elias-knowledge','elias-care'].includes(product.slug)?t('知識與客服','Knowledge & Service'):t('系統與流程','Systems & Workflow');
const productInquiryTopic=product.family==='digital'?'ai':'other';
const productInquiryHref=`${prefix}contact/?topic=${productInquiryTopic}&product=${encodeURIComponent(product.slug)}#contact-form`;
---
<ProductPageLayout product={product} locale={locale} prefix={prefix}>
{hasHeroVideo
  ? <section id="product-story" class="v2-product-story-brief" data-ambient-label={ambientLabel[product.slug]}><div class="v2-shell v2-product-story-brief-grid"><div><p class="v2-eyebrow">{t('真人協作情境','LIVE HUMAN + AI COLLABORATION')}</p><h2>{t(storyTitle[product.slug].zh,storyTitle[product.slug].en)}</h2></div><div><p>{l(product.scenario,locale)}</p><ol><li>{t('看見情況','See the situation')}</li><li>{t('整理重點','Organize what matters')}</li><li>{t('由人決定','People decide')}</li></ol></div></div></section>
  : <ProductMotionPrototype product={product} locale={locale}/>
}
{product.media.secondary&&<section class="v2-product-evidence"><div class="v2-product-evidence-image"><ResponsivePicture desktop={mediaUrl(product.media.secondary.desktop)} mobile={mediaUrl(product.media.secondary.mobile)} alt={l(product.media.secondary.alt,locale)}/></div><div class="v2-product-evidence-copy v2-reveal"><p class="v2-eyebrow">{t('人與智慧系統並肩工作','PEOPLE AND INTELLIGENCE, SIDE BY SIDE')}</p><h2>{t(evidenceTitle[product.slug].zh,evidenceTitle[product.slug].en)}</h2></div></section>}
<section id="product-value" class="v2-product-programs"><div class="v2-shell"><header class="v2-programs-head"><div><p class="v2-eyebrow">{t('產品價值 / 01','PRODUCT VALUE / 01')}</p><h2>{valueTitle[product.slug]?t(valueTitle[product.slug].zh,valueTitle[product.slug].en):t('從真正需要改善的事開始。','Start with something worth improving.')}</h2></div><p>{l(product.problem,locale)}</p></header><div class="v2-program-grid">{product.values.map((item,index)=><article class="v2-program-card v2-reveal"><span>0{index+1}</span><h3>{l(item,locale)}</h3></article>)}</div></div></section>
<section id="product-capabilities" class="v2-product-chapter"><div class="v2-shell v2-product-chapter-grid"><div class="v2-chapter-title"><p class="v2-eyebrow">{t('一起工作的方式 / 02','HOW WE WORK TOGETHER / 02')}</p><h2>{product.family==='digital'?t('分工清楚，合作更順。','Clear roles make better work.'):t('人來指揮，系統協助。','People lead. The system assists.')}</h2></div><div><p class="v2-chapter-intro">{l(product.collaboration,locale)}</p><ol class="v2-capability-list">{product.capabilities.map((item,index)=><li><span>{String(index+1).padStart(2,'0')}</span><strong>{l(item,locale)}</strong></li>)}</ol></div></div></section>
<section class="v2-product-audience"><div class="v2-shell v2-product-audience-grid"><div><p class="v2-eyebrow">{t('適合誰 / 03','WHO IT HELPS / 03')}</p><h2>{t('適合哪些團隊與使用者？','Who is it for?')}</h2></div><ul>{product.audience.map((item,index)=><li><span>0{index+1}</span>{l(item,locale)}</li>)}</ul></div></section>
<section class="v2-section v2-dark"><div class="v2-shell v2-two-grid"><div><p class="v2-eyebrow">{t('開始前先確認 / 04','BEFORE WE BEGIN / 04')}</p><h2>{t('導入前，確認資料與權限。','Confirm data and permissions before adoption.')}</h2><p>{t('先確認誰會使用、要完成什麼，以及哪些步驟需要人員確認。','First confirm who will use it, what it should do and which steps need human review.')}</p></div><div><p class="v2-eyebrow">{t('需要的資料與權限','DATA AND PERMISSIONS')}</p><p>{l(product.dataPermissions,locale)}</p></div></div></section>
<section id="product-safety" class="v2-section"><div class="v2-shell"><SafetyNotice locale={locale}><div class="v2-two-grid"><div><h3>{t('讓人安心的設計','Designed for confidence')}</h3><ul class="v2-check-list">{product.safeguards.map((item)=><li>{l(item,locale)}</li>)}</ul></div><div><h3>{t('使用限制與注意事項','Limits and considerations')}</h3><ul class="v2-limit-list">{product.limitations.map((item)=><li>{l(item,locale)}</li>)}</ul></div></div></SafetyNotice></div></section>
<section class="v2-section v2-tint"><div class="v2-shell v2-two-grid"><div><p class="v2-eyebrow">{t('目前進度','CURRENT STATUS')}</p><h2>{statusLabel}</h2><p>{l(product.statusNote,locale)}</p></div><div><p class="v2-eyebrow">{t('接下來','WHAT COMES NEXT')}</p><p>{l(product.next,locale)}</p></div></div></section>
<nav class="v2-product-next" aria-label={t('瀏覽其他產品','Browse other products')}><a href={`${prefix}products/${relatedProduct.slug}/`}><small>{t('相關產品','Related product')}</small><strong>{relatedProduct.name} →</strong></a><a href={`${prefix}${collectionPath}`}><small>{t('返回產品線','Product line')}</small><strong>{collectionLabel} →</strong></a></nav>
<div id="collaboration"><CTASection locale={locale} title={product.slug==='elias-home'?t('想優先收到 Elias Home 的消息？','Want early updates about Elias Home?'):product.slug==='elias-rescue'?t('想一起驗證專業救援情境？','Interested in validating a professional rescue scenario?'):t('想把這項能力帶進現有工作？','Ready to bring this capability into your work?')} copy={product.slug==='elias-home'?t('可透過 Email 索取產品消息；未來有新的研究、展示或產品規劃時，我們會優先通知。這不是正式訂單，也不收取款項。','Request product updates by email about future research, demonstrations or product plans. This is not an order and no payment is collected.'):product.slug==='elias-rescue'?t('帶著救援流程、環境限制與專業需求來交流，我們會先確認適合驗證的範圍。','Bring a rescue workflow, environmental constraints and professional needs. We will first define a responsible scope for validation.'):t('可直接採用既有能力，也能依資料、權限與工作流程進行配置或客製整合。','Adopt established capabilities directly, or configure and integrate them around your data, permissions and workflows.')} href={productInquiryHref} label={product.slug==='elias-home'?t('前往聯絡頁','Go to contact page'):product.slug==='elias-rescue'?t('討論救援研究','Discuss rescue research'):t('討論導入方式','Discuss adoption')}/></div></ProductPageLayout>
