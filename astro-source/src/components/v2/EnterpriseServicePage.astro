---
import type { SiteLocale } from '../../data/products';
import { simplify } from '../../data/simplified-map';
import { enterpriseServices, type EnterpriseServiceSlug } from '../../data/enterprise-services';
import AmbientLightField from './AmbientLightField.astro';
import CTA from './CTA.astro';
interface Props { locale: SiteLocale; service: EnterpriseServiceSlug }
const { locale, service } = Astro.props;
const item = enterpriseServices[service];
const base=import.meta.env.BASE_URL.replace(/\/$/,'');
const prefix=locale==='en'?`${base}/en/`:locale==='zh-CN'?`${base}/zh-cn/`:`${base}/`;
const mediaName=service;
const videoUrl=`${base}/media/${mediaName}-service.mp4`;
const posterUrl=`${base}/images/v2/services/${mediaName}-service.jpg`;
const inquiryTopic=service.replace('elias-','');
const inquiryHref=`${prefix}contact/?topic=${inquiryTopic}&product=${encodeURIComponent(service)}#contact-form`;
const text=(copy:{zh:string;en:string})=>locale==='en'?copy.en:locale==='zh-CN'?simplify(copy.zh):copy.zh;
const t=(zh:string,en:string)=>locale==='en'?en:locale==='zh-CN'?simplify(zh):zh;
const story={
  'elias-build':{heading:t('這次要開發與交付什麼','What needs to be built and delivered'),steps:[t('需求與流程','Requirements'),t('介面與應用','Application'),t('測試與交付','Delivery')],note:t('從實際工作出發，將核心流程做成可測試的應用，再安排部署與維護。','Start with the workflow, build a testable application, then plan deployment and maintenance.')},
  'elias-data':{heading:t('哪些資料需要接起來','Which data needs connecting'),steps:[t('系統與檔案','Sources'),t('整理與核對','Quality checks'),t('報表與查詢','Reporting')],note:t('沿著資料來源追到報表，找出格式、品質與查詢速度的問題。','Trace data from its sources to reporting to identify format, quality and query performance issues.')},
  'elias-chain':{heading:t('哪些紀錄需要共同查驗','Which records need shared verification'),steps:[t('紀錄提供方','Contributors'),t('共享紀錄','Shared records'),t('授權查驗方','Authorized reviewers')],note:t('先定義誰提供紀錄、誰能查驗，以及更新權限，再評估是否適合採用區塊鏈。','Define who contributes records, who verifies them and who may update them before assessing blockchain fit.')}
}[service];
---
<section class="v2-enterprise-hero">
  <AmbientLightField variant={service==='elias-chain'?'violet':service==='elias-data'?'teal':'warm'} density="quiet"/>
  <div class="v2-shell v2-enterprise-hero-grid">
    <div>
      <p class="v2-eyebrow">{item.eyebrow}</p>
      <strong>{item.name}</strong>
      <h1>{text(item.headline)}</h1>
      <p>{text(item.intro)}</p>
      <div class="v2-actions v2-enterprise-hero-actions"><CTA href={inquiryHref} label={t('討論這項需求','Discuss this need')} locale={locale}/><CTA href="#engagement" label={t('查看合作方式','See how we work')} locale={locale} secondary/></div>
    </div>
    <figure class="v2-enterprise-media">
      <div class="v2-enterprise-video-frame">
        <video controls muted={true} playsinline preload="metadata" poster={posterUrl} aria-label={t(`${item.name} 服務情境影片`,`${item.name} service scenario video`)}>
          <source src={videoUrl} type="video/mp4"/>
        </video>
      </div>
      <figcaption><span>{t('服務方向','SERVICE DIRECTION')}</span><strong>{text(item.label)}</strong></figcaption>
    </figure>
  </div>
</section>

<section class:list={['v2-enterprise-content',`is-${service}`]}>
  <div class="v2-shell">
    <div class="v2-enterprise-section-head"><p class="v2-eyebrow">{t('01／適用情境','01 / USE CASES')}</p><h2>{text(item.fitHeading)}</h2></div>
    <div class="v2-enterprise-cards">{item.fit.map((copy,index)=><article><span>0{index+1}</span><p>{text(copy)}</p></article>)}</div>

    <div class="v2-enterprise-split">
      <div><p class="v2-eyebrow">{t('工作示意','HOW IT CONNECTS')}</p><h2>{story.heading}</h2><p>{story.note}</p><ol class="v2-service-map" aria-label={t('服務關係示意','Service relationship diagram')}>{story.steps.map(step=><li>{step}</li>)}</ol></div>
      <ol>{item.scope.map((copy,index)=><li><span>0{index+1}</span>{text(copy)}</li>)}</ol>
    </div>

    <div id="engagement" class="v2-enterprise-process">
      <header><p class="v2-eyebrow">{t('合作節奏','ENGAGEMENT FLOW')}</p><h2>{t('先確認範圍與驗收標準，再分階段交付。','Agree on scope and acceptance criteria, then deliver in stages.')}</h2></header>
      <div>{item.process.map((copy,index)=><article><span>{index+1}</span><p>{text(copy)}</p></article>)}</div>
    </div>

    <aside class="v2-enterprise-boundary"><strong>{t('範圍說明','SCOPE NOTE')}</strong><p>{text(item.boundary)}</p></aside>
    <div class="v2-actions"><CTA href={inquiryHref} label={t(`討論 ${item.name}`,`Discuss ${item.name}`)} locale={locale}/><CTA href={`${prefix}enterprise-digital-solutions/`} label={t('回到服務總覽','Back to service overview')} locale={locale} secondary/></div>
  </div>
</section>
