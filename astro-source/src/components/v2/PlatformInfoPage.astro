---
import type { SiteLocale } from '../../data/products';
import { simplify } from '../../data/simplified-map';
import AmbientLightField from './AmbientLightField.astro';
import CTA from './CTA.astro';
interface Props { locale:SiteLocale; page:'api'|'docs'|'pricing' }
const { locale,page }=Astro.props;
const base=import.meta.env.BASE_URL.replace(/\/$/,'');
const prefix=locale==='en'?`${base}/en/`:locale==='zh-CN'?`${base}/zh-cn/`:`${base}/`;
const t=(zh:string,en:string)=>locale==='en'?en:locale==='zh-CN'?simplify(zh):zh;
const apiItems=[
  ['knowledge','Knowledge API',t('讓核准知識能被搜尋、引用與追溯。','Search, cite and trace approved knowledge.')],
  ['care','Care API',t('把需求分類、回覆準備與人工確認接進服務流程。','Bring intent routing, response preparation and human review into service workflows.')],
  ['flow','Flow API',t('連接表單、任務、狀態與交接。','Connect forms, tasks, status and handoffs.')],
  ['ops','Ops API',t('整理事件訊號，協助團隊看見影響與處理順序。','Organize incident signals so teams can see impact and response order.')]
];
const docs=[
  [t('01｜定義問題','01 | Define the problem'),t('先確認使用者、工作流程與要改善的結果。','Confirm users, workflow and the result to improve.')],
  [t('02｜界定資料','02 | Bound the data'),t('只使用核准來源，說清楚權限、保存與責任。','Use approved sources with clear permissions, retention and ownership.')],
  [t('03｜設計人工確認','03 | Design human review'),t('在高影響輸出前安排確認、停止與回復。','Place review, stop and recovery before high-impact outputs.')],
  [t('04｜小範圍驗證','04 | Validate narrowly'),t('用一個情境測試價值、限制與整合成本。','Test value, limits and integration cost in one scenario.')]
];
const docDirections=[
  ['Knowledge API',t('從核准知識中搜尋答案，回傳來源與可追溯片段。','Search approved knowledge and return sources with traceable excerpts.')],
  ['Care API',t('理解服務需求、準備回覆，並在送出前保留人工確認。','Understand service requests, prepare responses and retain human review before sending.')],
  ['Flow API',t('建立任務、同步狀態並記錄每次交接。','Create tasks, synchronize status and record every handoff.')],
  ['Ops API',t('整理事件、影響與建議檢查順序，不直接執行高風險操作。','Organize incidents, impact and suggested checks without executing high-risk actions.')]
];
const docNav=[
  ['overview',t('文件概覽','Overview')],['quick-start',t('快速開始','Quick Start')],['api-map',t('能力地圖','Capability Map')],['request-example',t('請求示例','Request Example')],['human-review',t('人工確認','Human Review')],['responses',t('回應與錯誤','Responses & Errors')]
];
const plans=[
  [t('需求探索','DISCOVERY'),t('把問題說清楚','Clarify the problem'),t('一起確認使用者、現況、資料範圍與成功條件。','Define users, current work, data scope and success criteria together.')],
  [t('原型驗證','PROTOTYPE'),t('先用一個情境驗證','Validate one scenario first'),t('建立小範圍原型，測試價值、風險與操作方式。','Build a focused prototype to test value, risk and interaction.')],
  [t('系統整合','INTEGRATION'),t('把可行能力接進工作','Bring proven capability into work'),t('依確認範圍規劃介接、安全、部署與持續維運。','Plan integration, security, deployment and operations around an agreed scope.')]
];
const meta=page==='api'
  ? {eyebrow:'ELIAS API',title:t('四個 API 方向，讓智慧接進現有工作。','Four API directions for bringing intelligence into existing work.'),intro:t('目前為合作規劃方向。實際介面、權限與可用範圍，會依原型驗證結果確認。','These are collaboration directions. Interfaces, permissions and availability are confirmed through prototype validation.')}
  : page==='docs'
  ? {eyebrow:'DOCUMENTATION',title:t('先看懂如何整合，再開始驗證。','Understand the integration before validation begins.'),intro:t('用簡單步驟說清楚資料、權限、人工確認與驗證方式。','A clear path through data, permissions, human review and validation.')}
  : {eyebrow:'PLANS',title:t('先選合作階段，再評估範圍與費用。','Choose the collaboration stage, then define scope and cost.'),intro:t('我們不以固定售價掩蓋差異。費用依資料、整合、安全與驗證範圍評估。','We do not hide meaningful differences behind a fixed price. Cost follows data, integration, safety and validation scope.')};
---
{page!=='docs'&&<section class="v2-platform-hero"><AmbientLightField variant={page==='pricing'?'warm':'teal'}/><div class="v2-shell"><p class="v2-eyebrow">{meta.eyebrow}</p><h1>{meta.title}</h1><p>{meta.intro}</p><div class="v2-actions"><CTA href={`${prefix}docs/`} label={t('查看整合文件','Read documentation')} locale={locale} secondary/><CTA href={`${prefix}contact/`} label={t('洽談合作','Talk with us')} locale={locale}/></div></div></section>}

{page==='api'&&<section class="v2-platform-content"><div class="v2-shell"><header><p class="v2-eyebrow">CAPABILITY MAP</p><h2>{t('從一項能力開始。','Start with one capability.')}</h2></header><div class="v2-platform-card-grid">{apiItems.map(([id,title,copy],index)=><article id={id}><span>0{index+1}</span><h3>{title}</h3><p>{copy}</p><small>{t('合作規劃中','COLLABORATION DIRECTION')}</small></article>)}</div></div></section>}
{page==='docs'&&<section class="v2-docs-page"><div class="v2-docs-bar"><strong>ELIAS API</strong><span>{t('開發文件','DEVELOPER DOCUMENTATION')}</span><a href={`${prefix}api/`}>{t('API 概覽','API Overview')}</a><a href={`${prefix}pricing/`}>{t('合作方案','Plans')}</a></div><div class="v2-docs-layout"><aside class="v2-docs-sidebar"><p>{t('開始使用','GET STARTED')}</p><nav>{docNav.map(([id,label])=><a href={`#${id}`}>{label}</a>)}</nav><p>{t('合作與規範','COLLABORATION')}</p><a href="#status">{t('文件狀態','Document Status')}</a><a href={`${prefix}safety/`}>{t('信任與選擇','Trust & Choice')}</a></aside><main class="v2-docs-main"><section id="overview" class="v2-docs-welcome"><p>{meta.eyebrow}</p><h1>{t('開始了解 Elias API','Getting Started with Elias API')}</h1><p>{meta.intro}</p><div><a href="#quick-start">{t('查看快速開始','View Quick Start')} →</a><a href={`${prefix}contact/`}>{t('討論整合','Discuss Integration')} →</a></div></section><aside id="status" class="v2-docs-status"><strong>{t('示意文件｜非正式上線規格','ILLUSTRATIVE DOCUMENTATION | NOT A LIVE SPECIFICATION')}</strong><p>{t('以下端點、欄位與回應為合作原型示例，用於說明整合方式；正式規格、認證與服務等級將依驗證進度發布。','The endpoints, fields and responses below are prototype examples that explain the integration approach. Formal specifications, authentication and service levels will follow validation progress.')}</p></aside><section id="api-map" class="v2-docs-section"><p class="v2-docs-kicker">CAPABILITY MAP</p><h2>{t('選擇要接進工作的能力。','Choose the capability to bring into work.')}</h2><div class="v2-doc-direction-grid">{docDirections.map(([title,copy])=><article><h3>{title}</h3><p>{copy}</p><a href={`${prefix}api/#${title.split(' ')[0].toLowerCase()}`}>{t('查看能力方向','View capability')} →</a></article>)}</div></section><section id="quick-start" class="v2-docs-section"><p class="v2-docs-kicker">QUICK START</p><h2>{t('四步完成第一次整合評估。','Four steps to a first integration assessment.')}</h2><div class="v2-docs-grid">{docs.map(([title,copy])=><article><h3>{title}</h3><p>{copy}</p></article>)}</div></section><section id="request-example" class="v2-docs-section"><p class="v2-docs-kicker">REQUEST EXAMPLE</p><h2>{t('示意：向核准知識提出問題。','Example: query approved knowledge.')}</h2><p>{t('這段程式碼只展示預期結構，不能作為目前可呼叫的正式端點。','This code demonstrates the intended structure only. It is not a live endpoint.')}</p><div class="v2-code-panel"><header><span>POST</span><code>/v1/knowledge/query</code><small>{t('示意','EXAMPLE')}</small></header><pre><code>{`{
  "query": "What changed in the approved policy?",
  "source_scope": ["policy-library"],
  "response_mode": "cited-summary",
  "human_review": true
}`}</code></pre></div></section><section id="human-review" class="v2-docs-section"><p class="v2-docs-kicker">HUMAN REVIEW</p><h2>{t('把人的確認放進流程。','Build human review into the flow.')}</h2><div class="v2-doc-principles"><article><strong>01</strong><h3>{t('來源可見','Visible sources')}</h3><p>{t('回答附上來源與片段，讓使用者能回到原始內容確認。','Responses include sources and excerpts so people can verify the original context.')}</p></article><article><strong>02</strong><h3>{t('高影響先確認','Review high-impact output')}</h3><p>{t('對外回覆、正式更新與關鍵操作，必須等待指定人員確認。','External responses, official updates and critical actions wait for designated review.')}</p></article><article><strong>03</strong><h3>{t('保留停止與追蹤','Stop and trace')}</h3><p>{t('每項任務保留狀態、版本與停止點，方便檢查與回復。','Each task retains status, version and stop points for inspection and recovery.')}</p></article></div></section><section id="responses" class="v2-docs-section"><p class="v2-docs-kicker">RESPONSES & ERRORS</p><h2>{t('讓限制容易理解。','Make limits easy to understand.')}</h2><div class="v2-doc-table"><div><code>200</code><strong>{t('已準備結果','Result prepared')}</strong><span>{t('仍依 human_review 欄位決定是否等待確認。','May still wait for review based on human_review.')}</span></div><div><code>403</code><strong>{t('來源不在授權範圍','Source outside permission scope')}</strong><span>{t('不擴大搜尋範圍，回傳缺少的權限資訊。','Does not widen scope and returns the missing permission context.')}</span></div><div><code>422</code><strong>{t('任務需要更多資訊','More context required')}</strong><span>{t('說明缺少的欄位，不自行猜測高影響內容。','Explains missing fields rather than guessing high-impact content.')}</span></div></div></section></main></div></section>}
{page==='pricing'&&<section class="v2-platform-content"><div class="v2-shell"><header><p class="v2-eyebrow">ENGAGEMENT</p><h2>{t('三種開始方式。','Three ways to begin.')}</h2></header><div class="v2-plan-grid">{plans.map(([name,label,copy],index)=><article><span>0{index+1}</span><p>{label}</p><h3>{name}</h3><p>{copy}</p><strong>{t('依範圍評估','SCOPE-BASED')}</strong></article>)}</div></div></section>}
