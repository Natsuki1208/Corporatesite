---
import type { SiteLocale } from '../../data/products';
import { simplify } from '../../data/simplified-map';
import AmbientLightField from './AmbientLightField.astro';
import CTA from './CTA.astro';
interface Props { locale:SiteLocale; page:'api'|'docs'|'pricing' }
const { locale,page }=Astro.props;
const base=import.meta.env.BASE_URL.replace(/\/$/,'');
const prefix=locale==='en'?`${base}/en/`:locale==='zh-CN'?`${base}/zh-cn/`:`${base}/`;
const t=(zh:string,en:string)=>locale==='en'?en:locale==='zh-CN'?simplify(zh):zh;
const apiItems=[
  {id:'knowledge',title:t('知識檢索介接','Knowledge Retrieval'),copy:t('讓核准內容可被搜尋、引用與追溯。','Make approved content searchable, citable and traceable.'),input:t('輸入：問題、來源範圍','Input: query and source scope'),output:t('輸出：答案草稿、引用','Output: draft answer and citations'),gate:t('確認：來源與適用版本','Review: source and applicable version')},
  {id:'care',title:t('客服協作介接','Service Collaboration'),copy:t('整理需求與案件脈絡，準備可修改的回覆。','Organize requests and case context into an editable response.'),input:t('輸入：訊息、案件紀錄','Input: message and case history'),output:t('輸出：分類、摘要、草稿','Output: routing, summary and draft'),gate:t('確認：敏感內容與承諾','Review: sensitive content and commitments')},
  {id:'flow',title:t('流程任務介接','Workflow Tasks'),copy:t('建立任務、同步狀態，並留下交接紀錄。','Create tasks, sync status and preserve handoff records.'),input:t('輸入：表單、事件、規則','Input: form, event and rules'),output:t('輸出：任務、狀態、通知','Output: task, status and notification'),gate:t('確認：例外與關鍵更新','Review: exceptions and critical updates')},
  {id:'ops',title:t('事件脈絡介接','Incident Context'),copy:t('整理事件、影響與證據，協助團隊判斷順序。','Organize incidents, impact and evidence to support prioritization.'),input:t('輸入：告警、日誌、資產關係','Input: alerts, logs and asset context'),output:t('輸出：時間線、影響、檢查順序','Output: timeline, impact and check order'),gate:t('確認：根因與實際操作','Review: root cause and actual action')}
];
const docs=[
  [t('01｜定義問題','01 | Define the problem'),t('先確認使用者、工作流程與要改善的結果。','Confirm users, workflow and the result to improve.')],
  [t('02｜界定資料','02 | Bound the data'),t('只使用核准來源，說清楚權限、保存與責任。','Use approved sources with clear permissions, retention and ownership.')],
  [t('03｜設計人工確認','03 | Design human review'),t('在高影響輸出前安排確認、停止與回復。','Place review, stop and recovery before high-impact outputs.')],
  [t('04｜小範圍驗證','04 | Validate narrowly'),t('用一個情境測試價值、限制與整合成本。','Test value, limits and integration cost in one scenario.')]
];
const docDirections=[
  ['Knowledge Retrieval',t('從核准知識中搜尋答案，回傳來源與可追溯片段。','Search approved knowledge and return sources with traceable excerpts.')],
  ['Care Collaboration',t('理解服務需求、準備回覆，並在送出前保留人工確認。','Understand service requests, prepare responses and retain human review before sending.')],
  ['Flow Tasks',t('建立任務、同步狀態並記錄每次交接。','Create tasks, synchronize status and record every handoff.')],
  ['Ops Context',t('整理事件、影響與建議檢查順序，不直接執行高風險操作。','Organize incidents, impact and suggested checks without executing high-risk actions.')]
];
const docNav=[
  ['overview',t('文件概覽','Overview')],['quick-start',t('快速開始','Quick Start')],['api-map',t('能力地圖','Capability Map')],['request-example',t('請求示例','Request Example')],['human-review',t('人工確認','Human Review')],['responses',t('回應與錯誤','Responses & Errors')]
];
const plans=[
  {name:t('需求探索','Discovery'),label:t('把問題說清楚','Clarify the problem'),price:t('NT$ 80,000 起','From NT$80,000'),copy:t('確認使用者、現況、資料範圍與成功條件。','Define users, current work, data scope and success criteria.'),items:[t('需求與流程工作坊','Problem and workflow workshop'),t('資料與風險盤點','Data and risk review'),t('驗證範圍建議','Validation scope recommendation')]},
  {name:t('原型驗證','Prototype'),label:t('先驗證一個情境','Validate one scenario'),price:t('NT$ 320,000 起','From NT$320,000'),copy:t('建立小範圍原型，測試價值、風險與操作方式。','Build a focused prototype to test value, risk and interaction.'),items:[t('可操作介面原型','Interactive interface prototype'),t('測試資料與人工確認','Test data and human review'),t('驗證結果與下一步','Findings and next-step plan')]},
  {name:t('系統整合','Integration'),label:t('把可行能力接進工作','Bring proven capability into work'),price:t('依專案評估','Project assessment'),copy:t('依確認範圍規劃介接、安全、部署與持續維運。','Plan integration, security, deployment and operations around an agreed scope.'),items:[t('介面與權限設計','Interfaces and permissions'),t('分階段導入與復原','Phased rollout and recovery'),t('監測、維運與改善','Monitoring, operations and improvement')]}
];
const meta=page==='api'
  ? {eyebrow:'ELIAS API · PLANNING',title:t('把需要的智慧，接進現有工作。','Bring the right intelligence into existing work.'),intro:t('以下是四種介接方向，目前用於合作規劃。正式介面、權限與可用範圍，會在原型驗證後確認。','These four integration areas support collaboration planning. Final interfaces, permissions and availability are confirmed after prototype validation.')}
  : page==='docs'
  ? {eyebrow:'DOCUMENTATION · ILLUSTRATIVE',title:t('先看懂如何整合，再開始驗證。','Understand the integration before validation begins.'),intro:t('用簡單步驟說清楚資料、權限、人工確認與驗證方式。','A clear path through data, permissions, human review and validation.')}
  : {eyebrow:'PLANS',title:t('先選合作階段，再確認範圍與費用。','Choose the collaboration stage, then define scope and cost.'),intro:t('每個情境的資料、整合與安全需求不同；我們會依實際驗證範圍提供合作評估。','Each scenario has different data, integration and safety needs. We assess the engagement around the scope to be validated.')};
---
{page!=='docs'&&<section class="v2-platform-hero"><AmbientLightField variant={page==='pricing'?'warm':'teal'}/><div class="v2-shell"><p class="v2-eyebrow">{meta.eyebrow}</p><h1>{meta.title}</h1><p>{meta.intro}</p><div class="v2-actions"><CTA href={page==='pricing'?'#engagement':`${prefix}docs/`} label={page==='pricing'?t('查看參考方案','View plans'):t('查看整合文件','Read documentation')} locale={locale} secondary/><CTA href={page==='pricing'?`${prefix}api/`:`${prefix}contact/`} label={page==='pricing'?t('了解整合方向','Explore integration'):t('洽談合作','Talk with us')} locale={locale}/></div></div></section>}

{page==='api'&&<section id="integration-map" class="v2-platform-content"><div class="v2-shell"><header><p class="v2-eyebrow">INTEGRATION MAP</p><h2>{t('先選一種介接方向。','Choose one integration area to begin.')}</h2></header><div class="v2-platform-card-grid">{apiItems.map((item,index)=><article id={item.id}><span>0{index+1}</span><h3>{item.title}</h3><p>{item.copy}</p><dl class="v2-api-contract"><div><dt>INPUT</dt><dd>{item.input}</dd></div><div><dt>OUTPUT</dt><dd>{item.output}</dd></div><div><dt>HUMAN GATE</dt><dd>{item.gate}</dd></div></dl><small>{t('規劃中｜非正式上線介面','PLANNING | NOT A LIVE INTERFACE')}</small></article>)}</div></div></section>}
{page==='docs'&&<section class="v2-docs-page"><div class="v2-docs-bar"><strong>ELIAS API</strong><span>{t('開發文件','DEVELOPER DOCUMENTATION')}</span><a href={`${prefix}api/`}>{t('API 概覽','API Overview')}</a><a href={`${prefix}pricing/`}>{t('合作方案','Plans')}</a></div><div class="v2-docs-layout"><aside class="v2-docs-sidebar"><p>{t('開始使用','GET STARTED')}</p><nav>{docNav.map(([id,label])=><a href={`#${id}`}>{label}</a>)}</nav><p>{t('合作與規範','COLLABORATION')}</p><a href="#status">{t('文件狀態','Document Status')}</a><a href={`${prefix}safety/`}>{t('信任與選擇','Trust & Choice')}</a></aside><main class="v2-docs-main"><section id="overview" class="v2-docs-welcome"><p>{meta.eyebrow}</p><h1>{t('開始了解 Elias API','Getting Started with Elias API')}</h1><p>{meta.intro}</p><div><a href="#quick-start">{t('查看快速開始','View Quick Start')} →</a><a href={`${prefix}contact/`}>{t('討論整合','Discuss Integration')} →</a></div></section><aside id="status" class="v2-docs-status"><strong>{t('示意文件｜非正式上線規格','ILLUSTRATIVE DOCUMENTATION | NOT A LIVE SPECIFICATION')}</strong><p>{t('以下端點、欄位與回應為合作原型示例，用於說明整合方式；正式規格、認證與服務等級將依驗證進度發布。','The endpoints, fields and responses below are prototype examples that explain the integration approach. Formal specifications, authentication and service levels will follow validation progress.')}</p></aside><section id="api-map" class="v2-docs-section"><p class="v2-docs-kicker">CAPABILITY MAP</p><h2>{t('選擇要接進工作的能力。','Choose the capability to bring into work.')}</h2><div class="v2-doc-direction-grid">{docDirections.map(([title,copy])=><article><h3>{title}</h3><p>{copy}</p><a href={`${prefix}api/#${title.split(' ')[0].toLowerCase()}`}>{t('查看能力方向','View capability')} →</a></article>)}</div></section><section id="quick-start" class="v2-docs-section"><p class="v2-docs-kicker">QUICK START</p><h2>{t('四步完成第一次整合評估。','Four steps to a first integration assessment.')}</h2><div class="v2-docs-grid">{docs.map(([title,copy])=><article><h3>{title}</h3><p>{copy}</p></article>)}</div></section><section id="request-example" class="v2-docs-section"><p class="v2-docs-kicker">REQUEST EXAMPLE</p><h2>{t('示意：向核准知識提出問題。','Example: query approved knowledge.')}</h2><p>{t('這段程式碼只展示預期結構，不能作為目前可呼叫的正式端點。','This code demonstrates the intended structure only. It is not a live endpoint.')}</p><div class="v2-code-panel"><header><span>POST</span><code>/v1/knowledge/query</code><small>{t('示意','EXAMPLE')}</small></header><pre><code>{`{
  "query": "What changed in the approved policy?",
  "source_scope": ["policy-library"],
  "response_mode": "cited-summary",
  "human_review": true
}`}</code></pre></div></section><section id="human-review" class="v2-docs-section"><p class="v2-docs-kicker">HUMAN REVIEW</p><h2>{t('把人的確認放進流程。','Build human review into the flow.')}</h2><div class="v2-doc-principles"><article><strong>01</strong><h3>{t('來源可見','Visible sources')}</h3><p>{t('回答附上來源與片段，讓使用者能回到原始內容確認。','Responses include sources and excerpts so people can verify the original context.')}</p></article><article><strong>02</strong><h3>{t('高影響先確認','Review high-impact output')}</h3><p>{t('對外回覆、正式更新與關鍵操作，必須等待指定人員確認。','External responses, official updates and critical actions wait for designated review.')}</p></article><article><strong>03</strong><h3>{t('保留停止與追蹤','Stop and trace')}</h3><p>{t('每項任務保留狀態、版本與停止點，方便檢查與回復。','Each task retains status, version and stop points for inspection and recovery.')}</p></article></div></section><section id="responses" class="v2-docs-section"><p class="v2-docs-kicker">RESPONSES & ERRORS</p><h2>{t('讓限制容易理解。','Make limits easy to understand.')}</h2><div class="v2-doc-table"><div><code>200</code><strong>{t('已準備結果','Result prepared')}</strong><span>{t('仍依 human_review 欄位決定是否等待確認。','May still wait for review based on human_review.')}</span></div><div><code>403</code><strong>{t('來源不在授權範圍','Source outside permission scope')}</strong><span>{t('不擴大搜尋範圍，回傳缺少的權限資訊。','Does not widen scope and returns the missing permission context.')}</span></div><div><code>422</code><strong>{t('任務需要更多資訊','More context required')}</strong><span>{t('說明缺少的欄位，不自行猜測高影響內容。','Explains missing fields rather than guessing high-impact content.')}</span></div></div></section></main></div></section>}
{page==='pricing'&&<section id="engagement" class="v2-platform-content"><div class="v2-shell"><header><p class="v2-eyebrow">ENGAGEMENT</p><h2>{t('三種開始方式。','Three ways to begin.')}</h2><p>{t('參考公開市場常見的成果型與專案型呈現，以下提供簡單的示意起價。','The examples below use a simple outcome- and project-based structure common in the market.')}</p></header><div class="v2-plan-grid">{plans.map((plan,index)=><article><span>0{index+1}</span><p>{plan.label}</p><h3>{plan.name}</h3><div class="v2-plan-price">{plan.price}</div><p>{plan.copy}</p><ul>{plan.items.map((item)=><li>{item}</li>)}</ul><strong>{t('示意費用｜正式報價依範圍確認','ILLUSTRATIVE | FINAL QUOTE FOLLOWS SCOPE')}</strong></article>)}</div><aside class="v2-platform-note"><strong>{t('費用說明','Pricing note')}</strong><p>{t('以上為網站規劃用的參考起價，不是線上購買承諾。實際費用會依資料量、系統介接、安全要求與驗證時程調整。','These are indicative starting points for planning, not an online purchase offer. Final cost depends on data volume, integration, safety requirements and validation schedule.')}</p></aside><div class="v2-actions"><CTA href={`${prefix}contact/`} label={t('取得合作評估','Request an assessment')} locale={locale}/></div></div></section>}
