---
import type { SiteLocale } from '../../data/products';
import { simplify } from '../../data/simplified-map';
import AmbientLightField from './AmbientLightField.astro';
import CTA from './CTA.astro';
interface Props { locale:SiteLocale; page:'api'|'docs'|'pricing' }
const { locale,page }=Astro.props;
const base=import.meta.env.BASE_URL.replace(/\/$/,'');
const prefix=locale==='en'?`${base}/en/`:locale==='zh-CN'?`${base}/zh-cn/`:`${base}/`;
const t=(zh:string,en:string)=>locale==='en'?en:locale==='zh-CN'?simplify(zh):zh;
const apiItems=[
  {id:'knowledge',title:t('知識搜尋','Knowledge Retrieval'),copy:t('讓核准內容可被搜尋、引用與追溯。','Make approved content searchable, citable and traceable.'),input:t('輸入：問題、來源範圍','Input: query and source scope'),output:t('輸出：答案草稿、引用','Output: draft answer and citations'),gate:t('確認：來源與適用版本','Review: source and applicable version')},
  {id:'care',title:t('客服協作','Service Collaboration'),copy:t('整理需求與案件內容，準備可修改的回覆。','Organize requests and case context into an editable response.'),input:t('輸入：訊息、案件紀錄','Input: message and case history'),output:t('輸出：分類、摘要、草稿','Output: routing, summary and draft'),gate:t('確認：敏感內容與承諾','Review: sensitive content and commitments')},
  {id:'flow',title:t('流程任務','Workflow Tasks'),copy:t('建立任務、同步狀態，並留下交接紀錄。','Create tasks, sync status and preserve handoff records.'),input:t('輸入：表單、事件、規則','Input: form, event and rules'),output:t('輸出：任務、狀態、通知','Output: task, status and notification'),gate:t('確認：例外與關鍵更新','Review: exceptions and critical updates')},
  {id:'ops',title:t('事件整理','Incident Context'),copy:t('整理事件、影響與證據，協助團隊排出處理順序。','Organize incidents, impact and evidence to support prioritization.'),input:t('輸入：告警、日誌、資產關係','Input: alerts, logs and asset context'),output:t('輸出：時間線、影響、檢查順序','Output: timeline, impact and check order'),gate:t('確認：原因與實際操作','Review: cause and actual action')}
];
const docs=[
  [t('01｜定義問題','01 | Define the problem'),t('先確認使用者、工作流程與要改善的結果。','Confirm users, workflow and the result to improve.')],
  [t('02｜界定資料','02 | Bound the data'),t('只使用核准來源，說清楚權限、保存與責任。','Use approved sources with clear permissions, retention and ownership.')],
  [t('03｜設計人工確認','03 | Design human review'),t('在高影響輸出前安排確認、停止與復原。','Place review, stop and recovery before high-impact outputs.')],
  [t('04｜小範圍驗證','04 | Validate narrowly'),t('用一個情境測試價值、限制與整合成本。','Test value, limits and integration cost in one scenario.')]
];
const docDirections=[
  ['knowledge','Knowledge Retrieval',t('從核准知識中搜尋答案，回傳來源與可追溯片段。','Search approved knowledge and return sources with traceable excerpts.')],
  ['care','Care Collaboration',t('理解服務需求、準備回覆，並在送出前保留人工確認。','Understand service requests, prepare responses and retain human review before sending.')],
  ['flow','Flow Tasks',t('建立任務、同步狀態並記錄每次交接。','Create tasks, synchronize status and record every handoff.')],
  ['ops','System Context',t('整理事件、影響與建議檢查順序，不直接執行高風險操作。','Organize incidents, impact and suggested checks without executing high-risk actions.')]
];
const docNav=[
  ['overview',t('文件概覽','Overview')],['quick-start',t('評估步驟','Assessment Steps')],['api-map',t('能力地圖','Capability Map')],['request-example',t('請求示例','Request Example')],['human-review',t('人工確認','Human Review')],['responses',t('回應與錯誤','Responses & Errors')]
];
const plans=[
  {name:t('直接導入','Direct Adoption'),label:t('採用既有能力','Adopt established capabilities'),price:t('依範圍評估','Scope-based assessment'),copy:t('採用既有能力與標準流程，完成必要設定後開始使用。','Adopt established capabilities and standard workflows with the required setup.'),items:[t('確認使用情境與帳號','Confirm use case and accounts'),t('完成必要資料設定','Complete required data setup'),t('上線說明與使用交接','Launch guidance and handoff')]},
  {name:t('配置導入','Configured Deployment'),label:t('配合組織工作方式','Fit organizational workflows'),price:t('依範圍評估','Scope-based assessment'),copy:t('依組織資料、權限與工作流程完成配置及驗證。','Configure and validate the service around organizational data, permissions and workflows.'),items:[t('資料與權限配置','Data and permission configuration'),t('流程與介面調整','Workflow and interface configuration'),t('驗收與操作確認','Acceptance and operational review')]},
  {name:t('客製整合','Custom Integration'),label:t('接進既有系統','Connect existing systems'),price:t('依範圍評估','Scope-based assessment'),copy:t('依既有系統與特殊需求，設計介面、流程、安全與維運方式。','Design interfaces, workflows, security and operations around existing systems and specialized needs.'),items:[t('系統介面與權限設計','System interfaces and permissions'),t('分階段整合與回復','Phased integration and recovery'),t('監測、維護與改善','Monitoring, support and improvement')]}
];
const meta=page==='api'
  ? {eyebrow:'AI INTEGRATION',title:t('讓 Elias AI 以合適方式接進現有工作。','Bring Elias AI into existing work through the right integration path.'),intro:t('標準能力可直接導入；需要資料來源、權限或既有系統串接時，可採配置導入或客製整合。正式 API 規格依合作範圍確認。','Standard capabilities can be adopted directly. Data-source, permission and system connections can use configured deployment or custom integration. Final API specifications follow the agreed scope.')}
  : page==='docs'
  ? {eyebrow:'DOCUMENTATION · ILLUSTRATIVE',title:t('先看懂如何整合，再開始驗證。','Understand the integration before validation begins.'),intro:t('用簡單步驟說清楚資料、權限、人工確認與驗證方式。','A clear path through data, permissions, human review and validation.')}
  : {eyebrow:'ADOPTION MODELS',title:t('選擇適合目前需求的導入方式。','Choose the adoption model that fits your current needs.'),intro:t('從直接導入、配置導入到客製整合，合作範圍依需求與系統環境確認。','From direct adoption and configured deployment to custom integration, scope follows the need and system environment.')};
---
{page!=='docs'&&<section class="v2-platform-hero"><AmbientLightField variant={page==='pricing'?'warm':'teal'}/><div class="v2-shell"><p class="v2-eyebrow">{meta.eyebrow}</p><h1>{meta.title}</h1><p>{meta.intro}</p><div class="v2-actions"><CTA href={page==='pricing'?'#engagement':`${prefix}docs/`} label={page==='pricing'?t('查看合作方案','View plans'):t('查看 AI 整合文件','Read AI documentation')} locale={locale} secondary/><CTA href={`${prefix}contact/`} label={page==='pricing'?t('討論服務需求','Discuss service needs'):t('洽談合作','Talk with us')} locale={locale}/></div></div></section>}

{page==='api'&&<section id="integration-map" class="v2-platform-content"><div class="v2-shell"><header><p class="v2-eyebrow">AI INTEGRATION MAP</p><h2>{t('選擇適合現有工作的整合方式。','Choose the integration path that fits your work.')}</h2></header><div class="v2-platform-card-grid">{apiItems.map((item,index)=><article id={item.id}><span>0{index+1}</span><h3>{item.title}</h3><p>{item.copy}</p><dl class="v2-api-contract"><div><dt>INPUT</dt><dd>{item.input}</dd></div><div><dt>OUTPUT</dt><dd>{item.output}</dd></div><div><dt>HUMAN GATE</dt><dd>{item.gate}</dd></div></dl><small>{t('介接規格依方案確認｜畫面端點為示意','SPECIFICATION FOLLOWS SCOPE | ENDPOINT SHOWN IS ILLUSTRATIVE')}</small></article>)}</div></div></section>}
{page==='docs'&&<section class="v2-docs-page"><div class="v2-docs-bar"><strong>ELIAS API</strong><span>{t('開發文件','DEVELOPER DOCUMENTATION')}</span><a href={`${prefix}api/`}>{t('API 概覽','API Overview')}</a><a href={`${prefix}pricing/`}>{t('合作方案','Plans')}</a></div><div class="v2-docs-layout"><aside class="v2-docs-sidebar"><p>{t('開始使用','GET STARTED')}</p><nav>{docNav.map(([id,label])=><a href={`#${id}`}>{label}</a>)}</nav><p>{t('合作與規範','COLLABORATION')}</p><a href="#status">{t('文件狀態','Document Status')}</a><a href={`${prefix}safety/`}>{t('信任與選擇','Trust & Choice')}</a></aside><div class="v2-docs-main"><section id="overview" class="v2-docs-welcome"><p>{meta.eyebrow}</p><h1>{t('開始了解 Elias API','Getting Started with Elias API')}</h1><p>{meta.intro}</p><div><a href="#quick-start">{t('查看快速開始','View Quick Start')} →</a><a href={`${prefix}contact/`}>{t('討論整合','Discuss Integration')} →</a></div></section><aside id="status" class="v2-docs-status"><strong>{t('示意文件｜非正式上線規格','ILLUSTRATIVE DOCUMENTATION | NOT A LIVE SPECIFICATION')}</strong><p>{t('以下端點、欄位與回應為合作原型示例，用於說明整合方式；正式規格、認證與服務等級將依驗證進度發布。','The endpoints, fields and responses below are prototype examples that explain the integration approach. Formal specifications, authentication and service levels will follow validation progress.')}</p></aside><section id="api-map" class="v2-docs-section"><p class="v2-docs-kicker">CAPABILITY MAP</p><h2>{t('選擇要接進工作的能力。','Choose the capability to bring into work.')}</h2><div class="v2-doc-direction-grid">{docDirections.map(([id,title,copy])=><article><h3>{title}</h3><p>{copy}</p><a href={`${prefix}api/#${id}`}>{t('查看能力方向','View capability')} →</a></article>)}</div></section><section id="quick-start" class="v2-docs-section"><p class="v2-docs-kicker">QUICK START</p><h2>{t('四步完成第一次整合評估。','Four steps to a first integration assessment.')}</h2><div class="v2-docs-grid">{docs.map(([title,copy])=><article><h3>{title}</h3><p>{copy}</p></article>)}</div></section><section id="request-example" class="v2-docs-section"><p class="v2-docs-kicker">REQUEST EXAMPLE</p><h2>{t('示意：向核准知識提出問題。','Example: query approved knowledge.')}</h2><p>{t('這段程式碼只展示預期結構，不能作為目前可呼叫的正式端點。','This code demonstrates the intended structure only. It is not a live endpoint.')}</p><div class="v2-code-panel"><header><span>POST</span><code>/v1/knowledge/query</code><small>{t('示意','EXAMPLE')}</small></header><pre><code>{`{
  "query": "What changed in the approved policy?",
  "source_scope": ["policy-library"],
  "response_mode": "cited-summary",
  "human_review": true
}`}</code></pre></div></section><section id="human-review" class="v2-docs-section"><p class="v2-docs-kicker">HUMAN REVIEW</p><h2>{t('把人的確認放進流程。','Build human review into the flow.')}</h2><div class="v2-doc-principles"><article><strong>01</strong><h3>{t('來源可見','Visible sources')}</h3><p>{t('回答附上來源與片段，讓使用者能回到原始內容確認。','Responses include sources and excerpts so people can verify the original context.')}</p></article><article><strong>02</strong><h3>{t('高影響先確認','Review high-impact output')}</h3><p>{t('對外回覆、正式更新與關鍵操作，必須等待指定人員確認。','External responses, official updates and critical actions wait for designated review.')}</p></article><article><strong>03</strong><h3>{t('保留停止與追蹤','Stop and trace')}</h3><p>{t('每項任務保留狀態、版本與停止點，方便檢查與復原。','Each task retains status, version and stop points for inspection and recovery.')}</p></article></div></section><section id="responses" class="v2-docs-section"><p class="v2-docs-kicker">RESPONSES & ERRORS</p><h2>{t('讓限制容易理解。','Make limits easy to understand.')}</h2><div class="v2-doc-table"><div><code>200</code><strong>{t('已準備結果','Result prepared')}</strong><span>{t('仍依 human_review 欄位決定是否等待確認。','May still wait for review based on human_review.')}</span></div><div><code>403</code><strong>{t('來源不在授權範圍','Source outside permission scope')}</strong><span>{t('不擴大搜尋範圍，回傳缺少的權限資訊。','Does not widen scope and returns the missing permission context.')}</span></div><div><code>422</code><strong>{t('任務需要更多資訊','More context required')}</strong><span>{t('說明缺少的欄位，不自行猜測高影響內容。','Explains missing fields rather than guessing high-impact content.')}</span></div></div></section></div></div></section>}
{page==='pricing'&&<section id="engagement" class="v2-platform-content"><div class="v2-shell"><header><p class="v2-eyebrow">ENGAGEMENT</p><h2>{t('三種導入方式。','Three adoption models.')}</h2><p>{t('依需求、資料與既有系統，選擇適合的導入範圍。','Choose an adoption scope based on your needs, data and existing systems.')}</p></header><div class="v2-plan-grid">{plans.map((plan,index)=><article><span>0{index+1}</span><p>{plan.label}</p><h3>{plan.name}</h3><div class="v2-plan-price">{plan.price}</div><p>{plan.copy}</p><ul>{plan.items.map((item)=><li>{item}</li>)}</ul><strong>{t('實際內容與報價依範圍確認','SCOPE AND QUOTE CONFIRMED PER ENGAGEMENT')}</strong></article>)}</div><aside class="v2-platform-note"><strong>{t('範圍說明','Scope note')}</strong><p>{t('實際費用依資料量、系統介接、安全要求、部署環境與維護範圍確認。','Final cost follows data volume, system integration, security requirements, deployment environment and support scope.')}</p></aside><div class="v2-actions"><CTA href={`${prefix}contact/`} label={t('取得合作評估','Request an assessment')} locale={locale}/></div></div></section>}
