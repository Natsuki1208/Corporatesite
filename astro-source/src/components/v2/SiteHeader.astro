---
import type { SiteLocale } from '../../data/products';
import LanguageMenu from './LanguageMenu.astro';
import AnimatedBrandMark from './AnimatedBrandMark.astro';
import { simplify } from '../../data/simplified-map';
interface Props { locale: SiteLocale; current?: string; path?: string }
const { locale, current = '', path = '' } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const lang = locale === 'en' ? 'en/' : locale === 'zh-CN' ? 'zh-cn/' : '';
const root = `${base}/${lang}`.replace(/([^:]\/)\/+/, '$1');
const t=(zh:string,en:string)=>locale==='en'?en:locale==='zh-CN'?simplify(zh):zh;
const groups = [
  { id:'products', label:t('服務','Services'), active:['digital-intelligence','elias-knowledge','elias-care','elias-flow','elias-ops'].includes(current), intro:t('從 AI、應用軟體到資料與數位資產，依照實際需求選擇合作起點。','Begin with AI, application software, data or digital assets according to the real need.'), columns:[
    { eyebrow:'AI APPLICATIONS + COLLABORATION', title:t('AI 應用與協作','AI Applications & Collaboration'), href:`${root}digital-intelligence/`, links:[[t('知識與客服','Knowledge & Service'),`${root}digital-intelligence/knowledge-service/`],[t('系統與流程','Systems & Workflow'),`${root}digital-intelligence/operations-workflow/`]] },
    { eyebrow:'ENTERPRISE DIGITAL SOLUTIONS', title:t('企業數位解決方案','Enterprise Digital Solutions'), href:`${root}#service-software`, links:[[`Elias Build · ${t('應用軟體開發與維護','Application Development & Maintenance')}`,`${root}#service-software`],[`Elias Data · ${t('資料整合與效能優化','Data Integration & Performance')}`,`${root}#service-data`],[`Elias Chain · ${t('區塊鏈與數位資產應用','Blockchain & Digital Assets')}`,`${root}#service-digital-assets`]] }
  ]},
  { id:'api', label:'API', active:['api','docs','pricing'].includes(current), intro:t('用 API 把 Elias AI 接進現有工具；產品頁則說明能解決什麼問題。','Use APIs to bring Elias AI into existing tools. Product pages explain what each product helps solve.'), columns:[
    { eyebrow:'DEVELOPER PATH', title:t('開發與整合','Build & Integrate'), href:`${root}api/`, links:[[t('整合文件','Documentation'),`${root}docs/`],[t('合作方案','Plans'),`${root}pricing/`],[t('討論整合','Discuss Integration'),`${root}contact/`]] },
    { eyebrow:'AI INTEGRATION', title:t('四種 AI 整合方式','Four AI Integration Areas'), href:`${root}api/#integration-map`, links:[[t('知識搜尋','Knowledge Retrieval'),`${root}api/#knowledge`],[t('客服協作','Service Collaboration'),`${root}api/#care`],[t('流程任務','Workflow Tasks'),`${root}api/#flow`],[t('事件整理','Incident Context'),`${root}api/#ops`]] }
  ]},
  { id:'resources', label:t('資源','Resources'), active:['technology','safety','research'].includes(current), intro:t('查看技術原則、研發進度、品牌觀點與公司資訊。','Explore technology principles, research progress, brand perspectives and company information.'), columns:[
    { eyebrow:'TRUST + PROGRESS', title:t('技術與信任','Technology & Trust'), href:`${root}technology/`, links:[[t('信任與選擇','Trust & Choice'),`${root}safety/`],[t('研發進度','Research Progress'),`${root}research/`]] },
    { eyebrow:'PERSPECTIVE + COMPANY', title:t('觀點與公司','Perspective & Company'), href:`${root}founder/`, links:[[t('關於 Elias Net','About Elias Net'),`${root}company/`],[t('查看服務項目','Explore Services'),`${root}#products`]] }
  ]},
  { id:'features', label:t('能力','Capabilities'), active:false, intro:t('六項核心能力，支援 AI、軟體、資料與流程服務。','Six capabilities supporting AI, software, data and workflow services.'), columns:[
    { eyebrow:'DIGITAL AI', title:t('工作中的智慧','Intelligence at Work'), href:`${root}#feature-understand`, links:[[t('看懂資訊','Understand information'),`${root}#feature-understand`],[t('找出重點','Find what matters'),`${root}#feature-focus`],[t('協助回覆','Prepare responses'),`${root}#feature-assist`],[t('推進流程','Keep work moving'),`${root}#feature-coordinate`]] },
    { eyebrow:'DATA + APPLICATIONS', title:t('資料與應用支援','Data & Application Support'), href:`${root}#feature-sense`, links:[[t('整合資料','Integrate data'),`${root}#feature-sense`],[t('支援應用','Support applications'),`${root}#feature-act`],[t('由人確認','Human review'),`${root}safety/`]] }
  ]},
  { id:'company', label:t('關於我們','About'), active:['company','founder','about','careers'].includes(current), intro:t('認識我們相信的未來、正在形成的團隊，以及可以一起前進的方式。','Meet the future we believe in, the team taking shape and ways to move forward together.'), columns:[
    { eyebrow:'COMPANY', title:'ELIAS NET', href:`${root}company/`, links:[[t('創辦人理念','Founder Vision'),`${root}founder/`],[t('技術與信任','Technology & Trust'),`${root}technology/`]] },
    { eyebrow:'TOGETHER', title:t('一起前進','Move Forward Together'), href:`${root}careers/`, links:[[t('職缺與所需能力','Roles & Skills'),`${root}careers/#ai-engineer`],[t('合作與聯絡','Collaboration'),`${root}contact/`]] }
  ]}
];
---
<header class="v2-header" data-v2-header>
  <a class="v2-brand" href={root} aria-label={t('Elias Net 首頁','Elias Net home')}><AnimatedBrandMark id="header" animated={path === ''} /></a>
  <button class="v2-menu" type="button" aria-expanded="false" aria-controls="v2-nav" data-v2-menu>{t('選單','Menu')}<span aria-hidden="true"></span></button>
  <nav id="v2-nav" class="v2-nav" aria-label={t('主要導覽','Primary navigation')} data-v2-nav>
    {groups.map((group,index)=><div class="v2-nav-group" data-nav-group>
      <button type="button" aria-expanded="false" aria-controls={`v2-mega-${group.id}`} aria-current={group.active?'page':undefined} data-nav-trigger>{group.label}<i aria-hidden="true"></i></button>
      <section id={`v2-mega-${group.id}`} class="v2-mega-menu" data-mega-menu aria-label={group.label}>
        <div class="v2-mega-shell"><header><span>0{index+1}</span><p>{group.intro}</p></header><div class="v2-mega-columns">{group.columns.map((column)=><article><p>{column.eyebrow}</p><a class="v2-mega-title" href={column.href}>{column.title}<span aria-hidden="true">↗</span></a><ul>{column.links.map(([label,href])=><li><a href={href}>{label}<span aria-hidden="true">→</span></a></li>)}</ul></article>)}</div></div>
      </section>
    </div>)}
    <a class="v2-nav-cta" href={`${root}contact/`}>{t('合作與聯絡','Contact')}</a>
  </nav>
  <div class="v2-header-tools">
    {path === '' && <a class="v2-header-explore" href="#products" aria-label={t('向下探索產品','Scroll to explore products')}><span>{t('向下探索','EXPLORE')}</span><i aria-hidden="true"></i></a>}
    <LanguageMenu locale={locale} path={path}/>
  </div>
</header>
<script>
document.querySelectorAll<HTMLElement>('[data-v2-header]').forEach((header)=>{
  const menu=header.querySelector<HTMLButtonElement>('[data-v2-menu]');
  const nav=header.querySelector<HTMLElement>('[data-v2-nav]');
  const groups=[...header.querySelectorAll<HTMLElement>('[data-nav-group]')];
  const desktopHover=window.matchMedia('(min-width:1181px) and (hover:hover) and (pointer:fine)');
  if(!menu||!nav||menu.dataset.ready)return;
  menu.dataset.ready='1';

  let openTimer=0;
  let closeTimer=0;
  const clearTimers=()=>{window.clearTimeout(openTimer);window.clearTimeout(closeTimer)};
  const setGroup=(group:HTMLElement,open:boolean)=>{
    group.querySelector('[data-nav-trigger]')?.setAttribute('aria-expanded',String(open));
    open?group.setAttribute('data-open',''):group.removeAttribute('data-open');
  };
  const closeGroups=(except?:HTMLElement)=>groups.forEach((group)=>{if(group!==except)setGroup(group,false)});
  const openGroup=(group:HTMLElement)=>{closeGroups(group);setGroup(group,true)};
  const close=()=>{clearTimers();menu.setAttribute('aria-expanded','false');nav.removeAttribute('data-open');closeGroups()};

  groups.forEach((group)=>{
    const trigger=group.querySelector<HTMLButtonElement>('[data-nav-trigger]');
    if(!trigger)return;
    trigger.addEventListener('click',()=>{
      clearTimers();
      const open=trigger.getAttribute('aria-expanded')!=='true';
      open?openGroup(group):setGroup(group,false);
    });
    group.addEventListener('pointerenter',()=>{
      if(!desktopHover.matches)return;
      clearTimers();
      if(!group.hasAttribute('data-open')){
        closeGroups();
        openTimer=window.setTimeout(()=>openGroup(group),1000);
      }
    });
    group.addEventListener('pointerleave',()=>{
      if(!desktopHover.matches)return;
      clearTimers();
      closeTimer=window.setTimeout(()=>setGroup(group,false),140);
    });
    trigger.addEventListener('focus',()=>{if(desktopHover.matches){clearTimers();openGroup(group)}});
  });

  menu.addEventListener('click',()=>{
    const open=menu.getAttribute('aria-expanded')!=='true';
    menu.setAttribute('aria-expanded',String(open));
    open?nav.setAttribute('data-open',''):close();
  });
  nav.addEventListener('click',(event)=>{if((event.target as Element).closest('a'))close()});
  nav.addEventListener('focusout',()=>window.setTimeout(()=>{if(!nav.contains(document.activeElement))closeGroups()},0));
  document.addEventListener('click',(event)=>{if(!header.contains(event.target as Node))closeGroups()});
  document.addEventListener('keydown',(event)=>{if(event.key==='Escape'){close();menu.focus()}});
  desktopHover.addEventListener('change',close);

  const updateHeader=()=>header.toggleAttribute('data-scrolled',window.scrollY>12);
  updateHeader();
  window.addEventListener('scroll',updateHeader,{passive:true});
});
</script>
