---
import type { SiteLocale } from '../../data/products';
import { simplify } from '../../data/simplified-map';
const { locale }=Astro.props as {locale:SiteLocale};
const t=(zh:string,en:string)=>locale==='en'?en:locale==='zh-CN'?simplify(zh):zh;
---
<section id="contact-form" class="v2-contact-form-section" aria-labelledby="contact-form-title">
  <div class="v2-shell v2-contact-form-grid">
    <header>
      <p class="v2-eyebrow">CONTACT BRIEF</p>
      <h2 id="contact-form-title">{t('留下基本資訊，讓第一次交流更聚焦。','Share a few details so the first conversation can stay focused.')}</h2>
      <p>{t('告訴我們想改善的工作、現有環境與期待結果；若尚未確定導入方式，我們會協助判斷。','Tell us what you want to improve, your current environment and the result you expect. If the adoption model is not yet clear, we will help you evaluate it.')}</p>
      <aside><strong>{t('資料說明','DATA NOTE')}</strong><span>{t('本站不會線上儲存這些欄位；送出後會開啟你的郵件程式，由你確認內容再寄出。','This site does not store these fields online. Submitting opens your email app so you can review the message before sending.')}</span></aside>
      <p class="v2-contact-email-fallback">{t('若郵件程式沒有開啟，可直接寄至','If your email app does not open, write directly to')} <a href="mailto:natsuki12089212@gmail.com">natsuki12089212@gmail.com</a></p>
    </header>
    <form class="v2-contact-form" data-contact-form data-recipient="natsuki12089212@gmail.com">
      <div class="v2-contact-context is-wide" data-contact-product-context hidden><span>{t('目前選擇','Selected')}</span><strong data-contact-product-label></strong></div>
      <input type="hidden" name="product" data-contact-product />
      <div class="v2-contact-field"><label for="contact-name">{t('姓名','Name')} <span aria-hidden="true">*</span></label><input id="contact-name" name="name" autocomplete="name" required /></div>
      <div class="v2-contact-field"><label for="contact-title">{t('職稱／角色','Title / Role')}</label><input id="contact-title" name="title" autocomplete="organization-title" /></div>
      <div class="v2-contact-field"><label for="contact-email">Email <span aria-hidden="true">*</span></label><input id="contact-email" name="email" type="email" autocomplete="email" required /></div>
      <div class="v2-contact-field"><label for="contact-phone">{t('電話（選填）','Phone (optional)')}</label><input id="contact-phone" name="phone" type="tel" autocomplete="tel" /></div>
      <div class="v2-contact-field is-wide"><label for="contact-topic">{t('需求方向','Area of interest')}</label><select id="contact-topic" name="topic"><option value="ai">{t('AI 應用與協作','AI applications and collaboration')}</option><option value="build">Elias Build</option><option value="data">Elias Data</option><option value="chain">Elias Chain</option><option value="talent">{t('人才交流','Talent conversation')}</option><option value="other">{t('其他合作','Other collaboration')}</option></select></div>
      <div class="v2-contact-field is-wide"><label for="contact-adoption">{t('希望的導入方式','Preferred adoption model')}</label><select id="contact-adoption" name="adoption"><option value="unsure">{t('尚未確定','Not sure yet')}</option><option value="direct">{t('直接導入','Direct adoption')}</option><option value="configured">{t('配置導入','Configured deployment')}</option><option value="custom">{t('客製整合','Custom integration')}</option></select></div>
      <div class="v2-contact-field is-wide"><label for="contact-message">{t('想討論的情境','What would you like to discuss?')} <span aria-hidden="true">*</span></label><textarea id="contact-message" name="message" rows="6" required placeholder={t('例如：目前的流程、遇到的問題、希望改善的結果。','For example: the current workflow, the challenge and the result you hope to improve.')}></textarea></div>
      <div class="v2-contact-form-action"><button type="submit">{t('準備郵件','Prepare email')} <span aria-hidden="true">→</span></button><p aria-live="polite" data-contact-status>{t('送出前仍可在郵件程式中確認內容。','You can review everything in your email app before sending.')}</p></div>
    </form>
  </div>
</section>

<script>
  const setupContactForm=(form:HTMLFormElement)=>{
    if(form.dataset.ready==='true')return;
    form.dataset.ready='true';
    const params=new URLSearchParams(location.search);
    const topic=form.elements.namedItem('topic') as HTMLSelectElement|null;
    const adoption=form.elements.namedItem('adoption') as HTMLSelectElement|null;
    const title=form.elements.namedItem('title') as HTMLInputElement|null;
    const productInput=form.elements.namedItem('product') as HTMLInputElement|null;
    const productContext=form.querySelector<HTMLElement>('[data-contact-product-context]');
    const productLabelNode=form.querySelector<HTMLElement>('[data-contact-product-label]');
    const productLabels:Record<string,string>={'elias-knowledge':'Elias Knowledge','elias-care':'Elias Care','elias-flow':'Elias Flow','elias-ops':'Elias System','elias-build':'Elias Build','elias-data':'Elias Data','elias-chain':'Elias Chain','elias-home':'Elias Home','elias-rescue':'Elias Rescue'};
    const incomingTopic=params.get('topic');
    if(topic&&incomingTopic&&Array.from(topic.options).some(option=>option.value===incomingTopic))topic.value=incomingTopic;
    const incomingProduct=params.get('product');
    const productLabel=incomingProduct?productLabels[incomingProduct]:undefined;
    if(productLabel&&productInput&&productContext&&productLabelNode){productInput.value=incomingProduct||'';productLabelNode.textContent=productLabel;productContext.hidden=false;}
    const role=params.get('role');if(title&&role&&!title.value)title.value=role;
    form.addEventListener('submit',(event)=>{
      event.preventDefault();
      if(!form.reportValidity())return;
      const data=new FormData(form);
      const topicLabel=topic?.selectedOptions[0]?.textContent?.trim()||'Elias Net';
      const adoptionLabel=adoption?.selectedOptions[0]?.textContent?.trim()||'';
      const selectedProduct=productLabels[String(data.get('product')||'')]||'';
      const subject=`Elias Net ${selectedProduct||topicLabel} inquiry`;
      const body=[
        `Name: ${data.get('name')||''}`,
        `Title / Role: ${data.get('title')||''}`,
        `Email: ${data.get('email')||''}`,
        `Phone: ${data.get('phone')||''}`,
        `Area: ${topicLabel}`,
        `Product / Service: ${selectedProduct}`,
        `Adoption model: ${adoptionLabel}`,
        '',
        `${data.get('message')||''}`
      ].join('\n');
      location.href=`mailto:${form.dataset.recipient}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
    });
  };
  document.querySelectorAll<HTMLFormElement>('[data-contact-form]').forEach(setupContactForm);
  document.addEventListener('astro:page-load',()=>document.querySelectorAll<HTMLFormElement>('[data-contact-form]').forEach(setupContactForm));
</script>
