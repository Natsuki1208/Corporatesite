---
import type { SiteLocale } from '../../data/products';
import { simplify } from '../../data/simplified-map';
import { enterpriseServiceSlugs, enterpriseServices } from '../../data/enterprise-services';
const { locale }=Astro.props as {locale:SiteLocale};
const base=import.meta.env.BASE_URL.replace(/\/$/,'');
const prefix=locale==='en'?`${base}/en/`:locale==='zh-CN'?`${base}/zh-cn/`:`${base}/`;
const t=(zh:string,en:string)=>locale==='en'?en:locale==='zh-CN'?simplify(zh):zh;
const text=(copy:{zh:string;en:string})=>locale==='en'?copy.en:locale==='zh-CN'?simplify(copy.zh):copy.zh;
---
<section class="v2-page-hero v2-enterprise-index-hero">
  <div class="v2-shell v2-enterprise-index-hero-grid">
    <div class="v2-enterprise-index-intro v2-reveal">
      <p class="v2-eyebrow">ENTERPRISE DIGITAL SOLUTIONS</p>
      <h1>{t('需要新系統、資料整合或鏈上介接，我們從現況盤點做到交付驗收。','From system requirements and data integration to on-chain connections, we work from assessment through acceptance.')}</h1>
      <p>{t('Build 負責應用開發，Data 處理資料品質與效能，Chain 規劃鏈上資料與數位資產介接。','Build delivers applications, Data improves data quality and performance, and Chain plans on-chain data and digital-asset integrations.')}</p>
    </div>
    <div class="v2-enterprise-map" aria-hidden="true">
      <div class="v2-enterprise-map-core"><small>ELIAS</small><strong>DIGITAL</strong><span>01 · 02 · 03</span></div>
      <i class="v2-enterprise-map-path is-build"></i><i class="v2-enterprise-map-path is-data"></i><i class="v2-enterprise-map-path is-chain"></i>
      <span class="v2-enterprise-map-node is-build">BUILD</span>
      <span class="v2-enterprise-map-node is-data">DATA</span>
      <span class="v2-enterprise-map-node is-chain">CHAIN</span>
    </div>
  </div>
</section>

<section class="v2-section v2-enterprise-index">
  <div class="v2-shell v2-enterprise-index-grid">
    {enterpriseServiceSlugs.map((slug,index)=>{
      const item=enterpriseServices[slug];
      return <a href={`${prefix}services/${slug}/`} class={`is-${slug}`}>
        <span class="v2-enterprise-index-number">0{index+1}</span>
        <div class="v2-enterprise-index-icon" aria-hidden="true"><i></i><i></i><i></i></div>
        <p class="v2-eyebrow">{item.eyebrow}</p>
        <h2>{item.name}</h2>
        <strong>{text(item.label)}</strong>
        <p>{text(item.intro)}</p>
        <span class="v2-enterprise-index-action">{t('查看服務內容','Explore this service')} →</span>
      </a>;
    })}
  </div>
</section>

<section class="v2-section v2-tint">
  <div class="v2-shell v2-split v2-reveal">
    <div><p class="v2-eyebrow">{t('跨領域專案','CROSS-DOMAIN WORK')}</p><h2>{t('軟體、資料與 AI 同時相關，也先選一個可驗收的項目。','When software, data and AI overlap, begin with one outcome that can be accepted.')}</h2></div>
    <p>{t('我們會列出輸入資料、目標系統、負責人與驗收標準，避免專案在名詞與概念中失去焦點。','We document input data, target systems, owners and acceptance criteria so the project does not disappear into terminology and concepts.')}</p>
  </div>
</section>
