---
import type { SiteLocale } from '../../data/products';
import { simplify } from '../../data/simplified-map';
interface Props { locale: SiteLocale; isHome?: boolean }
const { locale, isHome = false } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const lang = locale === 'en' ? 'en/' : locale === 'zh-CN' ? 'zh-cn/' : '';
const root = `${base}/${lang}`.replace(/([^:]\/)\/+/, '$1');
const t = (zh:string,en:string) => locale === 'en' ? en : locale === 'zh-CN' ? simplify(zh) : zh;
const links = [
  [t('探索產品','Explore products'), `${root}#products`],
  [t('了解合作方式','How we collaborate'), `${root}pricing/`],
  [t('認識 Elias Net','Meet Elias Net'), `${root}company/`],
  [t('與我們聊聊','Start a conversation'), `${root}contact/`]
];
const guidePrompt = locale === 'en' ? 'Welcome to Elias. Let me show you around.' : locale === 'zh-CN' ? '欢迎来到 Elias，让我为您带路' : '歡迎來到 Elias，讓我為您帶路';
const guideReady = locale === 'en' ? 'Glad to show you around.' : locale === 'zh-CN' ? '很高兴为您带路' : '很高興為您帶路';
const guideLabel = locale === 'en' ? 'Open quick navigation' : locale === 'zh-CN' ? '打开快捷导航' : '開啟快捷導覽';
---
<aside class:list={['v2-guide', { 'is-home': isHome }]} data-guide>
  <div class="v2-guide-panel" id="elias-guide-panel" hidden>
    <p class="v2-guide-eyebrow">ELIAS GUIDE</p>
    <strong>{t('想先去哪裡看看？','Where would you like to begin?')}</strong>
    <span>{t('讓我替你帶路。','Let me show you the way.')}</span>
    <nav aria-label={t('快捷導覽','Quick navigation')}>
      {links.map(([label,href]) => <a href={href}>{label}<i aria-hidden="true">→</i></a>)}
    </nav>
  </div>
  <button class="v2-guide-toggle" type="button" aria-haspopup="true" aria-expanded="false" aria-controls="elias-guide-panel" aria-label={guideLabel}>
    <img src={`${base}/images/v2/elias-guide-robot.png`} width="591" height="600" alt="" />
    <span><b class="v2-guide-greeting">{guidePrompt}</b><b class="v2-guide-ready">{guideReady}</b></span>
  </button>
</aside>

<script>
  const guide = document.querySelector<HTMLElement>('[data-guide]');
  if (guide && !guide.dataset.ready) {
    guide.dataset.ready = 'true';
    const toggle = guide.querySelector<HTMLButtonElement>('.v2-guide-toggle');
    const panel = guide.querySelector<HTMLElement>('.v2-guide-panel');
    const close = () => { if (!toggle || !panel) return; toggle.setAttribute('aria-expanded','false'); panel.hidden = true; guide.classList.remove('is-open'); };
    toggle?.addEventListener('click', () => {
      if (!panel) return;
      const opening = panel.hidden;
      panel.hidden = !opening;
      toggle.setAttribute('aria-expanded', String(opening));
      guide.classList.toggle('is-open', opening);
      if (opening) panel.querySelector<HTMLAnchorElement>('a')?.focus();
    });
    document.addEventListener('pointerdown', (event) => { if (!guide.contains(event.target as Node)) close(); });
    document.addEventListener('keydown', (event) => { if (event.key === 'Escape') { close(); toggle?.focus(); } });
    if (guide.classList.contains('is-home')) {
      const greetingDuration = window.matchMedia('(max-width: 640px)').matches ? 2600 : 4500;
      window.setTimeout(() => guide.classList.add('is-settled'), greetingDuration);
    }
    const footer = document.querySelector('.v2-footer');
    if (footer && 'IntersectionObserver' in window) {
      const footerObserver = new IntersectionObserver(([entry]) => guide.classList.toggle('is-away', entry.isIntersecting), { threshold: .08 });
      footerObserver.observe(footer);
    }
  }
</script>

<style>
  .v2-guide{position:fixed;right:clamp(14px,2vw,28px);bottom:clamp(14px,2vw,26px);z-index:80;display:grid;justify-items:end;gap:10px;opacity:1;transition:opacity .2s ease,transform .2s ease;pointer-events:none}.v2-guide.is-away{opacity:0;visibility:hidden;transform:translateY(8px)}
  .v2-guide>*{pointer-events:auto}.v2-guide-panel{width:min(310px,calc(100vw - 32px));padding:22px;border:1px solid rgba(213,229,226,.72);border-radius:18px;background:rgba(247,250,249,.96);color:#102129;box-shadow:0 24px 70px rgba(3,20,27,.22);backdrop-filter:blur(18px);transform-origin:bottom right;animation:v2-guide-open .24s ease-out}
  .v2-guide-panel[hidden]{display:none}.v2-guide-eyebrow{margin:0 0 8px;color:#087d73;font-size:.62rem;font-weight:800;letter-spacing:.16em}.v2-guide-panel>strong{display:block;font-size:1.12rem;font-weight:600}.v2-guide-panel>span{display:block;margin-top:4px;color:#68777a;font-size:.82rem}.v2-guide-panel nav{display:grid;margin-top:16px;border-top:1px solid #dce6e4}.v2-guide-panel a{display:flex;justify-content:space-between;gap:20px;padding:11px 2px;border-bottom:1px solid #e3eae9;color:#223238;text-decoration:none;font-size:.88rem}.v2-guide-panel a:hover,.v2-guide-panel a:focus-visible{color:#087d73}.v2-guide-panel i{font-style:normal}
  .v2-guide-toggle{position:relative;width:96px;height:94px;padding:0;border:0;background:transparent;cursor:pointer}.v2-guide-toggle img{position:absolute;right:0;bottom:0;width:84px;height:auto;filter:drop-shadow(0 10px 10px rgba(7,25,31,.28));transform-origin:50% 86%;transition:transform .2s ease,filter .2s ease}.v2-guide-toggle span{position:absolute;right:76px;top:50%;width:max-content;padding:8px 11px;border:1px solid rgba(255,255,255,.16);border-radius:999px;background:rgba(12,31,38,.9);color:#fff;font-size:.72rem;font-weight:650;letter-spacing:.02em;box-shadow:0 10px 28px rgba(3,20,27,.18);backdrop-filter:blur(10px);opacity:0;visibility:hidden;transform:translate(6px,-50%);transition:opacity .18s ease,transform .18s ease,visibility .18s ease;pointer-events:none}.v2-guide-toggle span::after{content:"";position:absolute;right:-5px;top:50%;width:10px;height:10px;background:rgba(12,31,38,.9);transform:translateY(-50%) rotate(45deg)}.v2-guide.is-home:not(.is-settled) .v2-guide-toggle span,.v2-guide-toggle:hover span,.v2-guide-toggle:focus-visible span,.v2-guide.is-open .v2-guide-toggle span{opacity:1;visibility:visible;transform:translate(0,-50%)}.v2-guide-toggle b{font:inherit}.v2-guide-ready{display:none}.v2-guide-toggle:hover img,.v2-guide-toggle:focus-visible img{transform:rotate(1.5deg) scale(1.04);filter:drop-shadow(0 12px 12px rgba(7,25,31,.34)) brightness(1.04)}.v2-guide.is-open .v2-guide-toggle img{transform:rotate(2deg) scale(1.04);filter:drop-shadow(0 12px 14px rgba(12,120,111,.34)) brightness(1.06)}.v2-guide.is-open .v2-guide-greeting{display:none}.v2-guide.is-open .v2-guide-ready{display:block}.v2-guide-toggle:focus-visible{outline:3px solid #55ded0;outline-offset:3px;border-radius:18px}
  @keyframes v2-guide-open{from{opacity:0;transform:translateY(8px) scale(.97)}to{opacity:1;transform:none}}
  @media(max-width:640px){.v2-guide{right:14px;bottom:max(14px,env(safe-area-inset-bottom))}.v2-guide-toggle{width:62px;height:62px}.v2-guide-toggle img{width:54px}.v2-guide-toggle span{right:0;top:-10px;max-width:calc(100vw - 28px);padding:7px 9px;font-size:.66rem;white-space:nowrap;transform:translate(0,-100%)}.v2-guide.is-home:not(.is-settled) .v2-guide-toggle span,.v2-guide-toggle:hover span,.v2-guide-toggle:focus-visible span,.v2-guide.is-open .v2-guide-toggle span{transform:translate(0,-100%)}.v2-guide-toggle span::after{right:18px;top:100%;transform:translateY(-5px) rotate(45deg)}.v2-guide-panel{padding:18px}.v2-guide-panel a{min-height:44px;align-items:center}}
  @media(prefers-reduced-motion:reduce){.v2-guide-toggle img,.v2-guide-panel{animation:none!important}.v2-guide-toggle img{transform:none!important;transition:none!important}}
</style>
