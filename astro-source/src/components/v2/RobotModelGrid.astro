---
import type { SiteLocale } from '../../data/products';
import { robotModels, modelText } from '../../data/robot-models';
import { simplify } from '../../data/simplified-map';
interface Props { locale: SiteLocale; compact?: boolean }
const { locale, compact = false } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/,'');
const t=(zh:string,en:string)=>locale==='en'?en:locale==='zh-CN'?simplify(zh):zh;
---
<div class:list={['v2-robot-model-grid', compact && 'is-compact']}>
  {robotModels.map((model,index) => <article class="v2-robot-model-card" data-motion-reveal>
    <figure><img src={`${base}/${model.image}`} alt={modelText(model,'alt',locale)} loading="lazy" width="900" height="675"/></figure>
    <div class="v2-robot-model-copy">
      <div class="v2-robot-model-meta"><span>0{index+1}</span><b>{modelText(model,'category',locale)}</b><em>{t('概念機型','CONCEPT MODEL')}</em></div>
      <p>{model.code}</p>
      <h3>{locale === 'en' ? model.code : locale === 'zh-CN' ? simplify(model.name) : model.name}</h3>
      <p>{modelText(model,'description',locale)}</p>
    </div>
  </article>)}
</div>
