---
interface Props { variant?: 'lockup'|'icon'; class?: string; id?: string; continuous?: boolean }
const { variant='lockup', class:className='', id='primary', continuous=false } = Astro.props;
const iconOnly = variant === 'icon';
const titleId=`elias-${id}-title`, descId=`elias-${id}-desc`, energyId=`elias-${id}-energy`, signalId=`elias-${id}-signal`, shadowId=`elias-${id}-shadow`;
---
<svg class:list={['v2-brand-mark',iconOnly&&'is-icon',continuous&&'is-continuous',className]} viewBox={iconOnly?'0 0 180 180':'0 0 640 180'} role="img" aria-labelledby={`${titleId} ${descId}`}>
  <title id={titleId}>Elias Net</title>
  <desc id={descId}>A futuristic Elias E and N intelligence core assembled from four independent precision modules.</desc>
  <defs>
    <linearGradient id={energyId} x1="52" y1="55" x2="128" y2="126" gradientUnits="userSpaceOnUse"><stop stop-color="#2ED7C5"/><stop offset=".5" stop-color="#F2F5F4"/><stop offset="1" stop-color="#D9A441"/></linearGradient>
    <linearGradient id={signalId} x1="22" y1="20" x2="157" y2="156" gradientUnits="userSpaceOnUse"><stop stop-color="#F2F5F4"/><stop offset=".48" stop-color="#85979A"/><stop offset="1" stop-color="#3B5057"/></linearGradient>
    <filter id={shadowId} x="-40%" y="-40%" width="180%" height="180%"><feDropShadow dx="0" dy="8" stdDeviation="9" flood-color="#071016" flood-opacity=".25"/></filter>
  </defs>
  <g class="mark-icon" filter={`url(#${shadowId})`}>
    <path class="mark-orbit" d="M29 74C35 42 58 24 89 22c31-1 55 17 63 46M151 107c-8 30-32 49-63 49-30 0-53-17-61-44" fill="none" stroke={`url(#${energyId})`} stroke-width="2" stroke-linecap="square"/>
    <path class="mark-module module-nw" d="M22 69V44l22-22h28l12 13-15 14H53L48 54v15Z" fill={`url(#${signalId})`}/>
    <path class="mark-module module-ne" d="M111 22h25l22 22v28l-13 12-14-15V53l-5-5h-15Z" fill="#64777D"/>
    <path class="mark-module module-se" d="M158 111v25l-22 22h-28l-12-13 15-14h16l5-5v-15Z" fill={`url(#${signalId})`}/>
    <path class="mark-module module-sw" d="M69 158H44l-22-22v-28l13-12 14 15v16l5 5h15Z" fill="#86989B"/>
    <path class="mark-core" d="M61 43h58l18 18v58l-18 18H61l-18-18V61Z" fill="#08141A" stroke="#DDE7E4" stroke-width="2.2"/>
    <path class="mark-core-frame" d="M67 53h46l14 14v46l-14 14H67l-14-14V67Z" fill="none" stroke="#32474E" stroke-width="1.5"/>
    <path class="mark-e" d="M62 63h34v11H75v10h17v11H75v11h22v11H62Z" fill="#2ED7C5"/>
    <path class="mark-n" d="M94 63h12l18 31V63h12v54h-12l-18-31v31H94V96l10-10-10-17Z" fill={`url(#${energyId})`}/>
    <path class="mark-cut" d="M94 84h12L94 96Z" fill="#08141A"/>
    <path class="mark-rail rail-teal" d="M32 75v25M38 106l13 13M72 148h24" fill="none" stroke="#2ED7C5" stroke-width="3"/>
    <path class="mark-rail rail-gold" d="M148 76V56l-13-13M108 32h16M108 148h18l12-12" fill="none" stroke="#D9A441" stroke-width="3"/>
    <circle class="mark-node node-one" cx="28" cy="88" r="3" fill="#2ED7C5"/>
    <circle class="mark-node node-two" cx="151" cy="91" r="3" fill="#D9A441"/>
  </g>
  {!iconOnly && <g class="mark-wordmark" transform="translate(205 53)">
    <text x="0" y="34" font-family="Inter, Arial, sans-serif" font-size="39" font-weight="760" letter-spacing="7" fill="#102129">ELIAS NET</text>
    <path d="M2 53h286" stroke="#AAB8B9" stroke-width="1"/>
    <text x="2" y="73" font-family="Inter, Arial, sans-serif" font-size="10" font-weight="700" letter-spacing="3.6" fill="#617176">INTELLIGENCE ALONGSIDE HUMANITY</text>
  </g>}
</svg>

<style>
  .v2-brand-mark{display:block;width:100%;height:auto;overflow:visible}.mark-module,.mark-core,.mark-core-frame,.mark-e,.mark-n,.mark-cut,.mark-rail,.mark-node,.mark-orbit,.mark-wordmark{transform-box:fill-box;transform-origin:center}.mark-module,.mark-core,.mark-core-frame,.mark-e,.mark-n,.mark-cut,.mark-node{opacity:0}.module-nw{transform:translate(-24px,-22px) rotate(-9deg)}.module-ne{transform:translate(25px,-22px) rotate(9deg)}.module-se{transform:translate(25px,22px) rotate(-9deg)}.module-sw{transform:translate(-24px,22px) rotate(9deg)}.mark-core,.mark-core-frame{transform:scale(.72) rotate(8deg)}.mark-e{transform:translateX(-8px)}.mark-n,.mark-cut{transform:translateX(8px)}.mark-rail,.mark-orbit{stroke-dasharray:180;stroke-dashoffset:180}.mark-wordmark{opacity:0;transform:translateX(-10px)}
  .v2-brand-mark.is-assembled .module-nw{animation:module-in .66s .04s forwards}.v2-brand-mark.is-assembled .module-ne{animation:module-in .66s .14s forwards}.v2-brand-mark.is-assembled .module-se{animation:module-in .66s .24s forwards}.v2-brand-mark.is-assembled .module-sw{animation:module-in .66s .34s forwards}.v2-brand-mark.is-assembled .mark-core,.v2-brand-mark.is-assembled .mark-core-frame{animation:core-lock .58s .62s forwards}.v2-brand-mark.is-assembled .mark-e{animation:glyph-slide .42s .86s forwards}.v2-brand-mark.is-assembled .mark-n,.v2-brand-mark.is-assembled .mark-cut{animation:glyph-slide .42s .96s forwards}.v2-brand-mark.is-assembled .mark-rail{animation:line-lock .66s 1.08s forwards}.v2-brand-mark.is-assembled .mark-orbit{animation:line-lock .9s 1.18s forwards}.v2-brand-mark.is-assembled .mark-node{animation:node-on .38s 1.48s forwards}.v2-brand-mark.is-assembled .mark-wordmark{animation:wordmark-in .55s 1.38s forwards}
  .v2-brand-mark.is-assembled.is-continuous .module-nw{animation:module-in .66s .04s forwards,module-drift-nw 7.6s 1.8s ease-in-out infinite}.v2-brand-mark.is-assembled.is-continuous .module-ne{animation:module-in .66s .14s forwards,module-drift-ne 8.3s 1.8s ease-in-out infinite}.v2-brand-mark.is-assembled.is-continuous .module-se{animation:module-in .66s .24s forwards,module-drift-se 7.9s 1.8s ease-in-out infinite}.v2-brand-mark.is-assembled.is-continuous .module-sw{animation:module-in .66s .34s forwards,module-drift-sw 8.6s 1.8s ease-in-out infinite}.v2-brand-mark.is-assembled.is-continuous .mark-core,.v2-brand-mark.is-assembled.is-continuous .mark-core-frame{animation:core-lock .58s .62s forwards,core-breathe 5.8s 1.8s ease-in-out infinite}.v2-brand-mark.is-assembled.is-continuous .mark-orbit{animation:line-lock .9s 1.18s forwards,orbit-live 6.4s 2.1s ease-in-out infinite}.v2-brand-mark.is-assembled.is-continuous .node-one{animation:node-on .38s 1.48s forwards,node-live 3.4s 2s ease-in-out infinite}.v2-brand-mark.is-assembled.is-continuous .node-two{animation:node-on .38s 1.58s forwards,node-live 3.4s 2.7s ease-in-out infinite}
  @keyframes module-in{72%{opacity:1;transform:scale(1.035)}to{opacity:1;transform:none}}@keyframes core-lock{70%{opacity:1;transform:scale(1.05)}to{opacity:1;transform:none}}@keyframes glyph-slide{to{opacity:1;transform:none}}@keyframes line-lock{to{stroke-dashoffset:0}}@keyframes node-on{55%{opacity:1;transform:scale(1.8)}to{opacity:1;transform:none}}@keyframes wordmark-in{to{opacity:1;transform:none}}
  @keyframes module-drift-nw{0%,100%{opacity:1;transform:none}50%{opacity:.82;transform:translate(-6px,-5px) rotate(-2deg)}}@keyframes module-drift-ne{0%,100%{opacity:1;transform:none}50%{opacity:.86;transform:translate(6px,-5px) rotate(2deg)}}@keyframes module-drift-se{0%,100%{opacity:1;transform:none}50%{opacity:.8;transform:translate(6px,5px) rotate(-2deg)}}@keyframes module-drift-sw{0%,100%{opacity:1;transform:none}50%{opacity:.84;transform:translate(-6px,5px) rotate(2deg)}}@keyframes core-breathe{0%,100%{opacity:1;transform:none}50%{opacity:1;transform:scale(1.025)}}@keyframes orbit-live{0%,100%{opacity:.55;stroke-width:2}50%{opacity:1;stroke-width:2.8}}@keyframes node-live{0%,100%{opacity:.55;transform:scale(.8)}50%{opacity:1;transform:scale(1.65)}}
  @media(prefers-reduced-motion:reduce){.mark-module,.mark-core,.mark-core-frame,.mark-e,.mark-n,.mark-cut,.mark-node,.mark-wordmark{opacity:1;transform:none}.mark-rail,.mark-orbit{stroke-dashoffset:0}.v2-brand-mark *{animation:none!important}}
</style>

<script>
  document.querySelectorAll<SVGElement>('.v2-brand-mark').forEach((mark) => {
    if (mark.dataset.markReady) return;
    mark.dataset.markReady='true';
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) mark.classList.add('is-assembled');
    else requestAnimationFrame(() => mark.classList.add('is-assembled'));
  });
</script>
