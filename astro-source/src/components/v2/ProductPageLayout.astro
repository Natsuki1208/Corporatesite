---
import type { ProductDefinition, SiteLocale } from '../../data/products'; import { l } from '../../data/products'; import ResponsivePicture from './ResponsivePicture.astro'; import ResearchStage from './ResearchStage.astro'; import CTA from './CTA.astro';
import { simplify } from '../../data/simplified-map';
import VideoSoundToggle from './VideoSoundToggle.astro';
interface Props { product: ProductDefinition; locale: SiteLocale; prefix: string }
const { product,locale,prefix }=Astro.props; const t=(zh:string,en:string)=>locale==='en'?en:locale==='zh-CN'?simplify(zh):zh; const base=import.meta.env.BASE_URL.replace(/\/$/,'');
const mediaUrl=(path:string)=>`${base}/${path}`;
const familyLabel=product.family==='digital'?t('線上智慧支援','DIGITAL INTELLIGENCE'):t('人工智慧機器人','AI ROBOTICS');
const statusLabel=locale==='en'?(product.status==='概念'?'Concept':product.status==='原型'?'Prototype':product.status):locale==='zh-CN'?simplify(product.status):product.status;
const liveVideoByProduct:Record<string,{src:string;label:string}>={
  'elias-knowledge':{src:`${base}/media/elias-knowledge-live-scenario.mp4`,label:t('工作人員查找答案並確認來源文件','A team member finding an answer and reviewing its source documents')},
  'elias-care':{src:`${base}/media/elias-care-live-scenario.mp4`,label:t('客服人員與人工智慧共同理解客戶需求','A service specialist and AI understanding a customer request together')},
  'elias-flow':{src:`${base}/media/elias-flow-live-scenario.mp4`,label:t('工作人員整理待辦、進度與交接事項','A team member organizing tasks, progress and handoffs')},
  'elias-ops':{src:`${base}/media/elias-ops-live-scenario.mp4`,label:t('維運人員與人工智慧共同檢視服務異常','An operations specialist and AI reviewing a service incident together')},
  'elias-home':{src:`${base}/media/elias-home-live-scenario.mp4`,label:t('家庭成員與 Elias Home 在日常生活中協作','A family member and Elias Home working together in daily life')},
  'elias-rescue':{src:`${base}/media/elias-rescue-live-scenario.mp4`,label:t('救援人員指揮 Elias Rescue 執行現場任務','Responders directing Elias Rescue during a field mission')}
};
const liveVideo=liveVideoByProduct[product.slug];
const liveStoryByProduct:Record<string,{eyebrow:{zh:string;en:string};caption:{zh:string;en:string};decision:{zh:string;en:string};detail:{zh:string;en:string};cta:{zh:string;en:string}}>={
  'elias-knowledge':{eyebrow:{zh:'真人工作情境',en:'REAL WORK, CLEAR ANSWERS'},caption:{zh:'從文件找到可信答案',en:'FIND ANSWERS IN TRUSTED SOURCES'},decision:{zh:'確認來源，再安心使用',en:'REVIEW THE SOURCE, THEN USE'},detail:{zh:'把散落的資料整理清楚，讓需要的答案更快被找到。',en:'Bring scattered information together so the right answer is easier to find.'},cta:{zh:'查看如何協作',en:'See how the team works'}},
  'elias-care':{eyebrow:{zh:'真人客服協作',en:'LIVE HUMAN + AI SERVICE'},caption:{zh:'Elias AI 整理需求',en:'ELIAS AI ORGANIZES THE REQUEST'},decision:{zh:'客服確認後回覆',en:'THE SERVICE TEAM REVIEWS AND REPLIES'},detail:{zh:'對話與紀錄集中呈現，讓回覆更快也更一致。',en:'Conversations and history come together for faster, more consistent replies.'},cta:{zh:'查看如何協作',en:'See how the team works'}},
  'elias-flow':{eyebrow:{zh:'真人工作情境',en:'REAL WORK, CLEAR PROGRESS'},caption:{zh:'待辦與進度一目了然',en:'TASKS AND PROGRESS AT A GLANCE'},decision:{zh:'負責人確認下一步',en:'OWNERS CONFIRM WHAT COMES NEXT'},detail:{zh:'把工作順序與交接整理清楚，讓團隊自然接得上。',en:'Clarify priorities and handoffs so the team can keep moving.'},cta:{zh:'查看如何協作',en:'See how the team works'}},
  'elias-ops':{eyebrow:{zh:'真人系統協作',en:'LIVE HUMAN + AI SYSTEMS'},caption:{zh:'Elias AI 協助判讀',en:'ELIAS AI HELPS REVIEW THE SIGNALS'},decision:{zh:'工程師確認再處理',en:'ENGINEERS CONFIRM BEFORE ACTION'},detail:{zh:'把告警與影響整理清楚，協助團隊更快找到處理方向。',en:'Clarify alerts and impact so teams can find the right response sooner.'},cta:{zh:'查看如何協作',en:'See how the team works'}},
  'elias-home':{eyebrow:{zh:'真人居家情境',en:'LIVE HUMAN + AI AT HOME'},caption:{zh:'Elias AI 確認需求',en:'ELIAS AI CONFIRMS THE REQUEST'},decision:{zh:'使用者隨時決定',en:'THE USER STAYS IN CONTROL'},detail:{zh:'理解日常需求並提供剛好的協助，使用者隨時可以停止。',en:'Understand everyday needs and offer measured help that the user can stop at any time.'},cta:{zh:'查看居家情境',en:'Explore the home scenario'}},
  'elias-rescue':{eyebrow:{zh:'真人救援情境',en:'LIVE HUMAN + AI RESCUE'},caption:{zh:'Elias AI 協助判斷',en:'ELIAS AI HELPS ASSESS THE SCENE'},decision:{zh:'救援團隊確認行動',en:'RESPONDERS CONFIRM EVERY ACTION'},detail:{zh:'先回傳危險區域資訊，幫助救援人員安全規劃下一步。',en:'Return information from dangerous areas so responders can plan the next step safely.'},cta:{zh:'查看救援情境',en:'Explore the rescue scenario'}}
};
const liveStory=liveStoryByProduct[product.slug];
---
<article class="v2-product-page" data-product={product.slug}>
  <header class:list={['v2-product-editorial-hero',liveVideo&&'has-live-video',liveVideo&&'has-split-live']}>
    {liveVideo?<video id="product-hero-video" class="v2-product-hero-video" autoplay muted={true} loop playsinline controls preload="metadata" poster={mediaUrl(product.media.hero.desktop)} aria-label={liveVideo.label}>
      <source src={liveVideo.src} type="video/mp4" />
      {t('你的瀏覽器不支援此產品情境影片。','Your browser does not support this product scenario video.')}
    </video>:<ResponsivePicture desktop={mediaUrl(product.media.hero.desktop)} mobile={mediaUrl(product.media.hero.mobile)} product={product.name} label={t('產品主圖','Product hero image')} status={t('正式素材','Approved asset')} alt={l(product.media.hero.alt,locale)}/>}
    {liveVideo&&<VideoSoundToggle target="product-hero-video" locale={locale}/>}
    <div class="v2-product-hero-shade" aria-hidden="true"></div>
    <div class="v2-shell v2-product-hero-content">
      <div class="v2-product-hero-meta">
        <a href={`${prefix}${product.family==='digital'?'digital-intelligence/':'ai-robots/'}`}>{familyLabel}</a>
        <span>{t('產品方向','PRODUCT DIRECTION')}</span>
      </div>
      <div class="v2-product-hero-copy v2-reveal">
        {liveStory&&<p class="v2-product-split-eyebrow">{t(liveStory.eyebrow.zh,liveStory.eyebrow.en)}</p>}
        <p class="v2-product-name">{product.name} · {product.chineseName}</p>
        <ResearchStage status={product.status} locale={locale} note={l(product.statusNote,locale)}/>
        <h1>{l(product.headline,locale)}</h1>
        <p>{l(product.intro,locale)}</p>
        <dl class="v2-product-promise" aria-label={t('產品重點','Product essentials')}>
          <div><dt>{t('適合誰','BEST FOR')}</dt><dd>{product.audience.slice(0,2).map((item)=>l(item,locale)).join(' · ')}</dd></div>
          <div><dt>{t('帶來什麼','CORE VALUE')}</dt><dd>{l(product.values[0],locale)}</dd></div>
          <div><dt>{t('目前階段','CURRENT STAGE')}</dt><dd>{statusLabel}</dd></div>
        </dl>
        {!liveVideo&&<CTA href="#product-story" label={t('看看它如何工作','See how it works')} locale={locale}/>}
      </div>
      <p class="v2-product-scroll-cue" aria-hidden="true">{t('向下探索','SCROLL TO EXPLORE')} <span></span></p>
    </div>
    {liveStory&&<p class="v2-product-video-caption"><span>{t(liveStory.caption.zh,liveStory.caption.en)}</span><strong>{t(liveStory.decision.zh,liveStory.decision.en)}</strong><em>{t(liveStory.detail.zh,liveStory.detail.en)}</em></p>}
  </header>
  <nav class="v2-product-subnav" aria-label={t('產品頁面導覽','Product page navigation')}>
    <a href="#product-story">{liveVideo?t('情境重點','Scenario'):t('產品運作','How it works')}</a>
    <a href="#product-value">{t('產品價值','Value')}</a>
    <a href="#product-capabilities">{t('如何協作','Collaboration')}</a>
    <a href="#product-safety">{t('安心設計','Safety')}</a>
    <a href="#collaboration">{t('合作方式','Work with us')}</a>
  </nav>
  <slot />
</article>
