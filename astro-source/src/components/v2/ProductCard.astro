---
import type { ProductDefinition, SiteLocale } from '../../data/products';
import { l } from '../../data/products';
import { simplify } from '../../data/simplified-map';
import ProductStatus from './ProductStatus.astro';
import ResponsivePicture from './ResponsivePicture.astro';
interface Props { product: ProductDefinition; locale: SiteLocale; basePath: string }
const { product, locale, basePath } = Astro.props;
const assetBase = import.meta.env.BASE_URL.replace(/\/$/,'');
---
<article class="v2-product-card v2-reveal">
  <ResponsivePicture desktop={`${assetBase}/${product.media.hero.desktop}`} mobile={`${assetBase}/${product.media.hero.mobile}`} alt={l(product.media.hero.alt,locale)} />
  <div class="v2-card-top"><p>{product.family === 'digital' ? 'DIGITAL INTELLIGENCE' : 'AI ROBOTICS'}</p><ProductStatus status={product.status} locale={locale} note={l(product.statusNote,locale)} /></div>
  <h3>{product.name}</h3><span class="v2-product-cn">{locale === 'zh-CN' ? simplify(product.chineseName) : product.chineseName}</span>
  <h4>{l(product.headline,locale)}</h4><p>{l(product.intro,locale)}</p>
  <dl><div><dt>{locale === 'en' ? 'Who it helps' : locale === 'zh-CN' ? '适合谁' : '適合誰'}</dt><dd>{product.audience.slice(0,2).map((item)=>l(item,locale)).join(' · ')}</dd></div><div><dt>{locale === 'en' ? 'How we work together' : locale === 'zh-CN' ? '如何一起完成' : '如何一起完成'}</dt><dd>{l(product.collaboration,locale)}</dd></div></dl>
  <a class="v2-card-action" href={`${basePath}products/${product.slug}/`}>{locale === 'en' ? 'View product' : locale === 'zh-CN' ? '查看产品' : '查看產品'} <span aria-hidden="true">→</span></a>
</article>
