---
import type { ProductDefinition, SiteLocale } from '../../data/products';
import { l } from '../../data/products';
import { simplify } from '../../data/simplified-map';
import ProductStatus from './ProductStatus.astro';
import ResponsivePicture from './ResponsivePicture.astro';
interface Props { product: ProductDefinition; locale: SiteLocale; basePath: string }
const { product, locale, basePath } = Astro.props;
const assetBase = import.meta.env.BASE_URL.replace(/\/$/,'');
const cardMedia = product.media.secondary ?? product.media.hero;
const actionByProduct:Record<string,{zh:string;en:string}>={
  'elias-knowledge':{zh:'查找企業知識',en:'Explore enterprise knowledge'},
  'elias-care':{zh:'了解客服協作',en:'Explore service collaboration'},
  'elias-flow':{zh:'查看流程如何推進',en:'See how work moves forward'},
  'elias-ops':{zh:'查看系統判讀',en:'Explore system insight'},
  'elias-home':{zh:'探索居家協助',en:'Explore help at home'},
  'elias-rescue':{zh:'了解救援應用',en:'Explore rescue applications'}
};
const action=actionByProduct[product.slug]??{zh:'了解產品',en:'Explore the product'};
---
<article class="v2-product-card v2-reveal">
  <ResponsivePicture desktop={`${assetBase}/${cardMedia.desktop}`} mobile={`${assetBase}/${cardMedia.mobile}`} alt={l(cardMedia.alt,locale)} />
  <div class="v2-card-heading">
    <h2>{product.name}</h2>
    <span class="v2-product-cn">{locale === 'en' ? l(product.headline,locale) : locale === 'zh-CN' ? simplify(product.chineseName) : product.chineseName}</span>
  </div>
  <p class="v2-card-summary">{l(product.intro,locale)}</p>
  <div class="v2-card-footer">
    <ProductStatus status={product.status} locale={locale} note={l(product.statusNote,locale)} />
    <a class="v2-card-action" href={`${basePath}products/${product.slug}/`}>{locale === 'en' ? action.en : locale === 'zh-CN' ? simplify(action.zh) : action.zh} <span aria-hidden="true">→</span></a>
  </div>
</article>
