---
import type {SiteLocale} from '../../data/products';
import {simplify} from '../../data/simplified-map';
import CTA from './CTA.astro';
import AnimatedBrandMark from './AnimatedBrandMark.astro';
const {locale}=Astro.props as {locale:SiteLocale};
const base=import.meta.env.BASE_URL.replace(/\/$/,'');
const prefix=locale==='en'?`${base}/en/`:locale==='zh-CN'?`${base}/zh-cn/`:`${base}/`;
const t=(zh:string,en:string)=>locale==='en'?en:locale==='zh-CN'?simplify(zh):zh;
const sectionLabel=(english:string,zh:string)=>locale==='en'?english:`${english} / ${t(zh,english)}`;
const people=[
 {name:'Elena Hart',title:t('創辦人暨執行董事長','FOUNDER & EXECUTIVE CHAIR'),scope:t('以人與人工智慧協作為核心，負責 Elias Net 的公司願景、產品組合與長期合作方向。她將複雜科技轉化為一般人能理解、企業願意信任的未來藍圖。','Leads Elias Net’s vision, product portfolio and long-term partnerships around collaboration between people and artificial intelligence. She turns complex technology into a future that people can understand and organizations can trust.'),background:[t('企業策略與品牌定位','Corporate strategy and brand direction'),t('人工智慧產品與服務設計','AI product and service design'),t('人本科技與責任邊界','Human-centered technology and responsibility')],image:'elias-founder-chair.webp'},
 {name:'Adrian Cole',title:t('營運長暨產品負責人','CHIEF OPERATING & PRODUCT OFFICER'),scope:t('連接產品構想、使用者需求與實際交付，讓研究方向成為可以測試、改善並逐步落地的產品計畫。負責跨團隊協作、產品節奏與合作體驗。','Connects product ideas, user needs and delivery so research directions become testable products that can improve and progress toward real use. Leads cross-team execution, product cadence and partner experience.'),background:[t('企業產品與服務規劃','Enterprise product and service planning'),t('流程改善與營運設計','Workflow improvement and operations design'),t('跨團隊交付與合作體驗','Cross-team delivery and partner experience')],image:'elias-chief-executive.webp'},
 {name:'Noah Bennett',title:t('技術暨安全長','CHIEF TECHNOLOGY & SAFETY OFFICER'),scope:t('負責人工智慧架構、系統整合、可靠性與人類控制設計。確保服務在導入組織前，具備清楚的權限、停止方式與檢查紀錄。','Leads AI architecture, systems integration, reliability and human-control design. Ensures services have clear permissions, stop controls and review records before entering an organization.'),background:[t('人工智慧與系統架構','AI and systems architecture'),t('平台整合、維運與可靠性','Platform integration, operations and reliability'),t('權限控制、安全與事故檢查','Authorization, safety and incident review')],image:'elias-chief-safety.webp'}
];
---
<article class="v2-company">
 <section class="v2-company-hero" aria-labelledby="company-title"><div class="v2-shell v2-company-hero-grid"><div class="v2-reveal"><p class="v2-eyebrow">AI + ENTERPRISE DIGITAL SOLUTIONS</p><div class="v2-company-hero-logo"><AnimatedBrandMark variant="icon" id="company-hero"/></div><h1 id="company-title">{locale==='en'?<><span>Useful intelligence.</span><span>Reliable delivery.</span></>:locale==='zh-CN'?<><span>让智慧有用，</span><span>让服务可靠。</span></>:<><span>讓智慧有用，</span><span>讓服務可靠。</span></>}</h1><p>{t('ELIAS NET 結合人工智慧、應用軟體與資料整合，協助組織把複雜資訊轉化為清楚、可持續運作的數位服務。','ELIAS NET combines AI, application software and data integration to turn complex information into clear digital services designed for lasting operations.')}</p></div><figure><img src={`${base}/images/elias-leadership-board.webp`} alt={t('ELIAS NET 團隊在明亮會議室共同檢視產品與治理方向','The ELIAS NET team reviewing product and governance direction in a bright meeting room')} width="1200" height="800"><figcaption>HUMAN / ACCOUNTABLE</figcaption></figure></div></section>

 <section id="company-mission" class="v2-section"><div class="v2-shell v2-two-grid"><div class="v2-reveal"><p class="v2-eyebrow">{sectionLabel('MISSION','公司使命')}</p><h2>{t('讓智慧協助工作，讓人做出選擇。','Bring intelligence to work. Keep decisions with people.')}</h2></div><div class="v2-prose"><p>{t('我們提供 AI 應用與協作，以及企業數位解決方案。每項服務都從實際需求出發，清楚確認範圍、資料與需要人工決定的節點。','We provide AI applications and collaboration alongside enterprise digital solutions. Every service begins with a real need and clearly defines scope, data and the points that require human decisions.')}</p></div></div></section>

 <section id="company-founder" class="v2-section v2-tint"><div class="v2-shell"><header class="v2-section-head"><p class="v2-eyebrow">{sectionLabel('CORE PEOPLE','核心人物')}</p><h2>{t('方向、服務與技術，各有專責。','Clear ownership across direction, services and technology.')}</h2><p>{t('三位核心人物分別負責公司方向、服務與產品落地及技術安全，讓每一項想法都有清楚的負責人與前進方式。','Three core leaders own company direction, service and product delivery, and technology safety, giving every idea clear responsibility and a path forward.')}</p></header><div class="v2-people-grid">{people.map((person)=><article class="v2-person-card v2-reveal"><img src={`${base}/images/${person.image}`} alt={`${person.name} — ${person.title}`} width="1200" height="900" loading="lazy"><div><p class="v2-person-kicker">CORE LEADERSHIP</p><h3>{person.name}</h3><p class="v2-person-title">{person.title}</p><p class="v2-person-bio">{person.scope}</p><div class="v2-person-background"><strong>{t('專業背景','AREAS OF EXPERIENCE')}</strong><ul>{person.background.map((item)=><li>{item}</li>)}</ul></div></div></article>)}</div></div></section>

<section id="company-solutions" class="v2-section"><div class="v2-shell"><header class="v2-section-head"><p class="v2-eyebrow">{sectionLabel('SERVICE PORTFOLIO','服務架構')}</p><h2>{t('從智慧協作，到穩定運作的數位服務。','From intelligent collaboration to dependable digital services.')}</h2><p>{t('兩個服務方向，分別回應 AI 應用與企業數位需求。','Two service directions for AI applications and enterprise digital needs.')}</p></header><div class="v2-company-products is-systems"><article><span>AI APPLICATIONS + COLLABORATION</span><h3>{t('AI 應用與協作','AI Applications & Collaboration')}</h3><p>{t('協助整理知識、理解需求、準備回應並推進工作流程。','Organize knowledge, understand needs, prepare responses and support workflows.')}</p><a href={`${prefix}digital-intelligence/`}>{t('查看 AI 服務','Explore AI services')} →</a></article><article><span>ENTERPRISE DIGITAL SOLUTIONS</span><h3>{t('企業數位服務','Enterprise Digital Services')}</h3><p>{t('Elias Build、Elias Data 與 Elias Chain，分別支援應用軟體、資料效能及區塊鏈與數位資產需求。','Elias Build, Elias Data and Elias Chain support application software, data performance, and blockchain and digital-asset needs.')}</p><a href={`${prefix}enterprise-digital-solutions/`}>{t('查看數位服務','Explore digital services')} →</a></article></div></div></section>

 <section id="company-start" class="v2-section v2-contact"><div class="v2-shell v2-contact-inner"><p class="v2-eyebrow">COLLABORATION</p><h2>{t('從一個真實需求開始。','Start with a real need.')}</h2><p>{t('先確認使用者、環境與目標，再一起決定下一步。','First confirm the users, environment and goal, then choose the next step together.')}</p><CTA href={`${prefix}contact/`} label={t('洽談合作','Talk with us')} locale={locale}/></div></section>
</article>
