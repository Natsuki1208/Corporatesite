---
import type {SiteLocale} from '../../data/products';
import {products,l} from '../../data/products';
import {simplify} from '../../data/simplified-map';
import CTA from './CTA.astro';
import AnimatedBrandMark from './AnimatedBrandMark.astro';
const {locale}=Astro.props as {locale:SiteLocale};
const base=import.meta.env.BASE_URL.replace(/\/$/,'');
const prefix=locale==='en'?`${base}/en/`:locale==='zh-CN'?`${base}/zh-cn/`:`${base}/`;
const t=(zh:string,en:string)=>locale==='en'?en:locale==='zh-CN'?simplify(zh):zh;
const people=[
 {name:'Mira Lin',title:t('創辦人暨執行董事長','FOUNDER & EXECUTIVE CHAIR'),scope:t('以人與人工智能協作為核心，負責 Elias Net 的公司願景、產品組合與長期合作方向。她將複雜科技轉化為一般人能理解、企業願意信任的未來藍圖。','Leads Elias Net’s vision, product portfolio and long-term partnerships around collaboration between people and artificial intelligence. She turns complex technology into a future that people can understand and organizations can trust.'),background:[t('企業策略與品牌定位','Corporate strategy and brand direction'),t('人工智能產品與服務設計','AI product and service design'),t('人本科技與責任邊界','Human-centered technology and responsibility')],image:'elias-founder-chair.webp'},
 {name:'Alex Wu',title:t('營運長暨產品負責人','CHIEF OPERATING & PRODUCT OFFICER'),scope:t('連接產品構想、使用者需求與實際交付，讓研究方向成為可以測試、改善並逐步落地的產品計畫。負責跨團隊協作、產品節奏與合作體驗。','Connects product ideas, user needs and delivery so research directions become testable products that can improve and progress toward real use. Leads cross-team execution, product cadence and partner experience.'),background:[t('企業產品與服務規劃','Enterprise product and service planning'),t('流程改善與營運設計','Workflow improvement and operations design'),t('跨團隊交付與合作體驗','Cross-team delivery and partner experience')],image:'elias-chief-executive.webp'},
 {name:'Noah Chen',title:t('技術暨安全長','CHIEF TECHNOLOGY & SAFETY OFFICER'),scope:t('負責人工智能架構、系統整合、可靠性與人類控制設計。確保產品在走進企業、家庭或救援現場前，都具備清楚的權限、停止方式與檢查紀錄。','Leads AI architecture, systems integration, reliability and human-control design. Ensures every product has clear permissions, stop controls and review records before entering enterprise, home or rescue environments.'),background:[t('人工智能與系統架構','AI and systems architecture'),t('平台整合、維運與可靠性','Platform integration, operations and reliability'),t('權限控制、安全與事故檢查','Authorization, safety and incident review')],image:'elias-chief-safety.webp'}
];
---
<article class="v2-company">
 <section class="v2-company-hero" aria-labelledby="company-title"><div class="v2-shell v2-company-hero-grid"><div class="v2-reveal"><p class="v2-eyebrow">AI AND EMBODIED INTELLIGENCE</p><div class="v2-company-hero-logo"><AnimatedBrandMark variant="icon" id="company-hero" continuous/></div><h1 id="company-title">{locale==='en'?<><span>Autonomous systems.</span><span>Human command.</span></>:locale==='zh-CN'?<><span>自主系统，</span><span>由人类指挥。</span></>:<><span>自主系統，</span><span>由人類指揮。</span></>}</h1><p>{t('ELIAS NET 研發能理解資訊、協調系統並在清楚界線內行動的智慧產品。能力越接近真實世界，授權、停止、接管與責任就必須越清楚。','ELIAS NET develops intelligent products that understand information, coordinate systems and act within clear boundaries. The closer capability gets to the real world, the clearer authorization, stop, override and accountability must become.')}</p></div><figure><img src={`${base}/images/elias-leadership-board.webp`} alt={t('ELIAS NET 團隊在明亮會議室共同檢視產品與治理方向','The ELIAS NET team reviewing product and governance direction in a bright meeting room')} width="1200" height="800"><figcaption>HUMAN / ACCOUNTABLE</figcaption></figure></div></section>

 <section id="company-mission" class="v2-section"><div class="v2-shell v2-two-grid"><div class="v2-reveal"><p class="v2-eyebrow">MISSION / {t('公司使命','MISSION')}</p><h2>{t('讓智慧進入真實工作，也讓人始終保有決定權。','Bring intelligence into real work while people retain decision authority.')}</h2></div><div class="v2-prose"><p>{t('我們從企業知識、客服、流程與維運開始，也探索居家協助與高風險救援。每項產品先說清楚服務誰、能幫什麼、需要哪些資料，以及什麼時候必須停下等待人員確認。','We begin with enterprise knowledge, service, workflows and operations, while exploring home assistance and high-risk rescue. Every product states who it serves, how it helps, what it needs and when it must stop for human review.')}</p></div></div></section>

 <section id="company-founder" class="v2-section v2-tint"><div class="v2-shell"><header class="v2-section-head"><p class="v2-eyebrow">CORE PEOPLE / {t('核心人物','CORE PEOPLE')}</p><h2>{t('不同專業，共同讓未來科技走得更穩。','Different disciplines, moving future technology forward with purpose.')}</h2><p>{t('三位核心人物分別負責公司方向、產品落地與技術安全，讓每一項想法都有清楚的負責人與前進方式。','Three core leaders own company direction, product delivery and technology safety, giving every idea clear responsibility and a path forward.')}</p></header><div class="v2-people-grid">{people.map((person)=><article class="v2-person-card v2-reveal"><img src={`${base}/images/${person.image}`} alt={`${person.name} — ${person.title}`} width="1200" height="900" loading="lazy"><div><p class="v2-person-kicker">CORE LEADERSHIP</p><h3>{person.name}</h3><p class="v2-person-title">{person.title}</p><p class="v2-person-bio">{person.scope}</p><div class="v2-person-background"><strong>{t('專業背景','AREAS OF EXPERIENCE')}</strong><ul>{person.background.map((item)=><li>{item}</li>)}</ul></div></div></article>)}</div></div></section>

 <section id="company-solutions" class="v2-section"><div class="v2-shell"><header class="v2-section-head"><p class="v2-eyebrow">SOLUTIONS / {t('解決方案','SOLUTIONS')}</p><h2>{t('六項產品，共用一套可停止、可接管的工作原則。','Six products share one stoppable, overridable way of working.')}</h2></header><div class="v2-company-products">{products.map((product)=><article><span>{product.name}</span><h3>{l(product.headline,locale)}</h3><p>{l(product.intro,locale)}</p><a href={`${prefix}products/${product.slug}/`}>{t('查看產品','View product')} →</a></article>)}</div></div></section>

 <section id="company-start" class="v2-section v2-contact"><div class="v2-shell v2-contact-inner"><p class="v2-eyebrow">COLLABORATION</p><h2>{t('從一個值得驗證的任務開始。','Start with one mission worth validating.')}</h2><p>{t('我們先確認使用者、資料或環境、風險與成功條件，再共同決定下一步。','We first confirm users, data or environment, risks and success criteria, then decide the next step together.')}</p><CTA href={`${prefix}contact/`} label={t('討論合作可能','Discuss collaboration')} locale={locale}/></div></section>
</article>
