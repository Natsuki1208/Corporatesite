---
interface Props { id: string; tone?: 'dark'|'light'|'soft'; class?: string; labelledby?: string }
const { id, tone='light', class: className='', labelledby } = Astro.props;
---
<section id={id} class:list={['v2-scroll-scene',`is-${tone}`,className]} data-motion-scene aria-labelledby={labelledby}><slot /></section>
