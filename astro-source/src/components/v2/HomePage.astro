---
import type { SiteLocale } from '../../data/products';
import { simplify } from '../../data/simplified-map';
import MotionProvider from './motion/MotionProvider.astro';
import ScrollScene from './motion/ScrollScene.astro';
import MotionReveal from './motion/MotionReveal.astro';
import MotionPicture from './motion/MotionPicture.astro';
import AmbientLightField from './AmbientLightField.astro';
import HeroParticleRibbon from './HeroParticleRibbon.astro';
const { locale }=Astro.props as {locale:SiteLocale};
const base=import.meta.env.BASE_URL.replace(/\/$/,'');
const prefix=locale==='en'?`${base}/en/`:locale==='zh-CN'?`${base}/zh-cn/`:`${base}/`;
const t=(zh:string,en:string)=>locale==='en'?en:locale==='zh-CN'?simplify(zh):zh;
const sectionLabel=(english:string,zh:string)=>locale==='en'?english:`${english} / ${t(zh,english)}`;
const media=(path:string)=>`${base}/${path}`;
const features=[
  {id:'understand',title:t('看懂資訊','UNDERSTAND INFORMATION'),copy:t('把可靠資料與現場資訊整理清楚，也保留來源。','Organize reliable data and real-world information clearly, while preserving sources.'),tag:'UNDERSTAND'},
  {id:'focus',title:t('找出重點','FIND WHAT MATTERS'),copy:t('從大量內容中指出需要留意的變化、問題與下一步。','Surface the changes, issues and next steps that deserve attention.'),tag:'FOCUS'},
  {id:'assist',title:t('協助回覆','PREPARE RESPONSES'),copy:t('依可靠來源準備內容，讓人更快確認、調整與送出。','Prepare grounded responses for people to review, refine and send.'),tag:'ASSIST'},
  {id:'coordinate',title:t('推進流程','KEEP WORK MOVING'),copy:t('整理任務、狀態與交接，讓負責的人知道接下來要做什麼。','Organize tasks, status and handoffs so ownership stays clear.'),tag:'COORDINATE'},
  {id:'sense',title:t('整合資料','INTEGRATE DATA'),copy:t('串接分散資訊、整理資料關係，讓查詢與分析建立在清楚的基礎上。','Connect scattered information and clarify data relationships for dependable search and analysis.'),tag:'INTEGRATE'},
  {id:'act',title:t('支援應用','SUPPORT APPLICATIONS'),copy:t('依明確需求與安全界線準備整合方案，重要決定仍由人做出。','Prepare integrations within clear requirements and safety boundaries, with people making key decisions.'),tag:'APPLY'}
];
---
<MotionProvider class="v2-immersive-home" ambientField={false}>
  <ScrollScene id="brand" tone="dark" class="v2-immersive-hero" labelledby="brand-title">
    <HeroParticleRibbon label={t('由深青、銀灰與暖金色光點交織成流動的智慧網絡','A flowing intelligence network woven from deep teal, silver and warm-gold particles')}/>
    <div class="v2-hero-shade" aria-hidden="true"></div>
    <div class="v2-shell v2-hero-content"><MotionReveal class="v2-hero-message"><h1 id="brand-title" class="v2-hero-split"><span class="v2-hero-side"><strong>The future of</strong>{locale !== 'en' && <small>昨天的科幻</small>}</span><span class="v2-hero-side"><strong>yesterday, today.</strong>{locale !== 'en' && <small>今天的日常</small>}</span></h1></MotionReveal></div>
  </ScrollScene>

  <ScrollScene id="products" tone="dark" class="v2-products-scene v2-model-architecture" labelledby="products-title">
    <AmbientLightField variant="teal"/>
    <div class="v2-shell"><div class="v2-model-architecture-head">
      <MotionReveal><p class="v2-eyebrow">{sectionLabel('SERVICE PORTFOLIO','服務項目')}</p><h2 id="products-title">{t('讓 AI、軟體與資料，成為可持續運作的服務。','AI, software and data designed for lasting operations.')}</h2><p>{t('從智慧協作到應用開發、資料優化與數位資產整合，依實際需求規劃合適的起點。','From AI collaboration and application development to data optimization and digital-asset integration, begin with the right scope for each need.')}</p></MotionReveal>
      <div class="v2-architecture-families">
        <article id="service-ai" data-motion-reveal><span>01</span><p class="v2-eyebrow">AI APPLICATIONS</p><img class="v2-service-preview" src={media('images/v2/products/elias-knowledge-desktop.webp')} alt={t('AI 知識與協作應用情境','AI knowledge and collaboration scenario')} loading="lazy" decoding="async"/><h3>{t('AI 應用與協作','AI Applications & Collaboration')}</h3><p>{t('協助整理知識、理解需求、準備回應並推進工作流程。','Organize knowledge, understand needs, prepare responses and support workflows.')}</p><a href={`${prefix}digital-intelligence/`}>{t('查看 AI 產品','Explore AI products')} →</a></article>
        <article id="service-software" data-motion-reveal><span>02</span><p class="v2-eyebrow">APPLICATION ENGINEERING</p><video class="v2-service-preview" autoplay muted={true} loop playsinline preload="metadata" poster={media('images/v2/services/elias-build-service.jpg')} aria-label={t('Elias Build 應用軟體開發與維護情境','Elias Build application engineering scenario')}><source src={media('media/elias-build-service.mp4')} type="video/mp4"/></video><h3>Elias Build</h3><p class="v2-service-label">{t('應用軟體開發與維護','Application Software Development & Maintenance')}</p><p>{t('從需求整理、系統開發到後續維護，建立可持續使用的數位服務。','From requirements and development to ongoing maintenance, build digital services designed for continued use.')}</p><a href={`${prefix}contact/`}>{t('討論開發需求','Discuss development needs')} →</a></article>
        <article id="service-data" data-motion-reveal><span>03</span><p class="v2-eyebrow">DATA INTELLIGENCE</p><video class="v2-service-preview" autoplay muted={true} loop playsinline preload="metadata" poster={media('images/v2/services/elias-data-service.jpg')} aria-label={t('Elias Data 資料整合與效能優化情境','Elias Data integration and performance scenario')}><source src={media('media/elias-data-service.mp4')} type="video/mp4"/></video><h3>Elias Data</h3><p class="v2-service-label">{t('資料整合與效能優化','Data Integration & Performance')}</p><p>{t('整合分散資料、改善查詢效率與資訊呈現，建立穩定清楚的資料基礎。','Integrate scattered data, improve query performance and clarify information for a dependable data foundation.')}</p><a href={`${prefix}contact/`}>{t('討論資料需求','Discuss data needs')} →</a></article>
        <article id="service-digital-assets" data-motion-reveal><span>04</span><p class="v2-eyebrow">BLOCKCHAIN &amp; DIGITAL ASSETS</p><video class="v2-service-preview" autoplay muted={true} loop playsinline preload="metadata" poster={media('images/v2/services/elias-chain-service.jpg')} aria-label={t('Elias Chain 區塊鏈與數位資產應用情境','Elias Chain blockchain and digital asset scenario')}><source src={media('media/elias-chain-service.mp4')} type="video/mp4"/></video><h3>Elias Chain</h3><p class="v2-service-label">{t('區塊鏈與數位資產應用','Blockchain & Digital Asset Applications')}</p><p>{t('依需求、法規與安全條件，評估區塊鏈及數位資產相關的應用整合。','Assess blockchain and digital-asset integrations according to requirements, regulations and security conditions.')}</p><a href={`${prefix}contact/`}>{t('討論應用方向','Discuss an application')} →</a></article>
      </div>
    </div></div>
  </ScrollScene>

  <ScrollScene id="features" tone="light" class="v2-solutions-scene" labelledby="features-title"><AmbientLightField variant="warm"/><div class="v2-shell"><MotionReveal class="v2-section-head"><p class="v2-eyebrow">{sectionLabel('AI CAPABILITIES','AI 特性')}</p><h2 id="features-title">{t('理解資訊，也支援每一段工作。','Understand information. Support every stage of work.')}</h2><p>{t('六項核心能力，支援 Elias 的 AI 應用、資料與流程服務。','Six capabilities support Elias AI applications, data and workflow services.')}</p></MotionReveal><div class="v2-solution-grid">{features.map((feature,index)=><article id={`feature-${feature.id}`} data-motion-reveal><span>0{index+1}</span><h3>{feature.title}</h3><p>{feature.copy}</p><small>{feature.tag}</small></article>)}</div></div></ScrollScene>

  <ScrollScene id="governance" tone="light" class="v2-governance-scene v2-cocreation-scene" labelledby="governance-title">
    <MotionPicture class="v2-cocreation-backdrop" desktop={media('images/v2/human-ai-cocreation.webp')} mobile={media('images/v2/human-ai-cocreation.webp')} alt={t('孩子與友善的智慧夥伴同行，工作人員在控制中心持續監督系統','A child walks with a friendly intelligent companion while an operator continues supervising the system')}/>
    <div class="v2-cocreation-shade" aria-hidden="true"></div>
    <div class="v2-shell v2-cocreation-inner">
      <MotionReveal class="v2-cocreation-copy"><p class="v2-eyebrow">{sectionLabel('HUMAN + AI','人與人工智慧同行')}</p><h2 id="governance-title">{t('AI 看見更多，人做出選擇。','AI sees more. People make the choice.')}</h2><p>{t('AI 整理訊息、提示風險並準備建議；人帶著經驗與責任，決定是否前進。','AI organizes information, highlights risk and prepares options. People bring experience and responsibility to decide what happens next.')}</p></MotionReveal>
      <div class="v2-cocreation-principles" aria-label={t('人與人工智慧並肩同行','People and artificial intelligence moving forward side by side')}>
        <article data-motion-reveal><span>AI</span><h3>{t('幫我們看見更多','Helps us see more')}</h3><p>{t('留意容易錯過的需要與線索，讓幫助在適合的時候自然出現。','Notice needs and clues we might miss, so help can appear naturally at the right moment.')}</p></article>
        <article data-motion-reveal><span>HUMAN</span><h3>{t('讓科技懂得關心','Brings care to technology')}</h3><p>{t('我們用經驗與同理心選擇方向，讓每一項能力都回到人的真實需要。','We use experience and empathy to choose the direction, keeping every capability grounded in real human needs.')}</p></article>
        <article data-motion-reveal><span>TOGETHER</span><h3>{t('人與 AI，各自發揮所長','People and AI, each at their best')}</h3><p>{t('AI 整理資訊並準備建議，人員確認行動，也為最後的結果負責。','AI organizes information and prepares options. People confirm the action and remain accountable for the outcome.')}</p></article>
      </div>
      <a class="v2-cocreation-link" href={`${prefix}safety/`}>{t('了解人與 AI 的合作方式','See how people and AI work together')} →</a>
    </div>
  </ScrollScene>

  <ScrollScene id="collaboration" tone="light" class="v2-collaboration-scene" labelledby="collaboration-title"><AmbientLightField variant="violet" density="quiet"/><div class="v2-shell"><div class="v2-collaboration-intro"><MotionReveal><p class="v2-eyebrow">{sectionLabel('COLLABORATION','合作方式')}</p><h2 id="collaboration-title">{t('從一件值得改善的事開始。','Start with something worth improving.')}</h2><p>{t('先確認需求，再用小範圍驗證找出可行的下一步。','Clarify the need, then use a focused validation to find the next practical step.')}</p></MotionReveal><MotionPicture class="v2-collaboration-visual" desktop={media('images/v2/services/elias-collaboration-planning.jpg')} mobile={media('images/v2/services/elias-collaboration-planning.jpg')} alt={t('Elias Net 團隊共同討論資料、產品與合作方向','The Elias Net team discussing data, product and collaboration priorities')}/></div><div class="v2-collaboration-offers"><article><span>01</span><p class="v2-eyebrow">{t('了解方式','UNDERSTAND THE APPROACH')}</p><h3>{t('先看合作怎麼進行','See how engagement works')}</h3><p>{t('從需求探索、原型驗證到 AI 系統整合，依實際範圍前進。','Move from discovery to prototype and AI integration based on the real scope.')}</p><a href={`${prefix}pricing/`}>{t('查看合作方案','View plans')} →</a></article><article><span>02</span><p class="v2-eyebrow">{t('準備整合','PREPARE TO INTEGRATE')}</p><h3>{t('先看資料與人工確認','Review data and human checkpoints')}</h3><p>{t('用示意文件了解資料、權限與人工確認如何接進流程。','Use the illustrative documentation to understand data, permissions and human review.')}</p><a href={`${prefix}docs/`}>{t('查看整合文件','Read documentation')} →</a></article><article><span>03</span><p class="v2-eyebrow">{t('開始對話','START A CONVERSATION')}</p><h3>{t('帶著真實需求來找我們','Bring us a real need')}</h3><p>{t('告訴我們想改善什麼，一起找出適合的起點。','Tell us what you want to improve and we will find a practical starting point.')}</p><a href={`${prefix}contact/`}>{t('洽談合作','Talk with us')} →</a></article></div></div></ScrollScene>
</MotionProvider>

<script>
  const reduceHeroMotion = matchMedia('(prefers-reduced-motion: reduce)');
  const hero = document.querySelector<HTMLElement>('#brand');
  const playHero = () => {
    if (!hero || reduceHeroMotion.matches) return;
    hero.classList.remove('is-hero-playing');
    void hero.offsetWidth;
    hero.classList.add('is-hero-playing');
    hero.dataset.heroState = 'playing';
    window.setTimeout(() => { if (hero.dataset.heroState === 'playing') hero.dataset.heroState = 'complete'; }, 8200);
  };
  if (hero) {
    if (reduceHeroMotion.matches) hero.dataset.heroState = 'complete';
    else requestAnimationFrame(playHero);
    const heroObserver = new IntersectionObserver(([entry]) => {
      const animations = typeof hero.getAnimations === 'function' ? hero.getAnimations({ subtree:true }) : [];
      animations.forEach((animation) => entry?.isIntersecting ? animation.play() : animation.pause());
    }, { threshold:.05 });
    heroObserver.observe(hero);
  }
</script>
