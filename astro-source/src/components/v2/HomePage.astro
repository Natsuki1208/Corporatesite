---
import type { SiteLocale } from '../../data/products';
import { simplify } from '../../data/simplified-map';
import CTA from './CTA.astro';
import MotionProvider from './motion/MotionProvider.astro';
import ScrollScene from './motion/ScrollScene.astro';
import MotionReveal from './motion/MotionReveal.astro';
import MotionPicture from './motion/MotionPicture.astro';
import AmbientLightField from './AmbientLightField.astro';
const { locale }=Astro.props as {locale:SiteLocale};
const base=import.meta.env.BASE_URL.replace(/\/$/,'');
const prefix=locale==='en'?`${base}/en/`:locale==='zh-CN'?`${base}/zh-cn/`:`${base}/`;
const t=(zh:string,en:string)=>locale==='en'?en:locale==='zh-CN'?simplify(zh):zh;
const media=(path:string)=>`${base}/${path}`;
const features=[
  {id:'understand',title:t('看懂資訊','UNDERSTAND INFORMATION'),copy:t('把可靠資料與現場資訊整理清楚，也保留來源。','Organize reliable data and real-world information clearly, while preserving sources.'),tag:'UNDERSTAND'},
  {id:'focus',title:t('找出重點','FIND WHAT MATTERS'),copy:t('從大量內容中指出需要留意的變化、問題與下一步。','Surface the changes, issues and next steps that deserve attention.'),tag:'FOCUS'},
  {id:'assist',title:t('協助回覆','PREPARE RESPONSES'),copy:t('依可靠來源準備內容，讓人更快確認、調整與送出。','Prepare grounded responses for people to review, refine and send.'),tag:'ASSIST'},
  {id:'coordinate',title:t('推進流程','KEEP WORK MOVING'),copy:t('整理任務、狀態與交接，讓負責的人知道接下來要做什麼。','Organize tasks, status and handoffs so ownership stays clear.'),tag:'COORDINATE'},
  {id:'sense',title:t('感知環境','SENSE ENVIRONMENTS'),copy:t('透過感測資訊理解周遭情況，同時呈現限制與不確定性。','Use sensor input to understand surroundings while exposing limits and uncertainty.'),tag:'SENSE'},
  {id:'act',title:t('支援行動','SUPPORT ACTION'),copy:t('在明確任務與安全界線內提供協助，關鍵決定仍由人做出。','Provide support within clear tasks and safety limits, with people making key decisions.'),tag:'ACT'}
];
---
<MotionProvider class="v2-immersive-home">
  <ScrollScene id="brand" tone="dark" class="v2-immersive-hero" labelledby="brand-title">
    <video class="v2-hero-backdrop v2-hero-video" autoplay muted loop playsinline preload="metadata" poster={`${base}/images/v2/elias-net-home-hero-desktop.jpg`} aria-label={t('人與人工智慧機器人並肩走向所期盼的未來','A person and an AI robot walking side by side toward the future')}>
      <source src={`${base}/media/elias-net-home-hero.mp4`} type="video/mp4" />
    </video>
    <div class="v2-hero-shade" aria-hidden="true"></div>
    <div class="v2-hero-depth" aria-hidden="true"><i></i><i></i><i></i></div>
    <div class="v2-hero-stars" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i><i></i><i></i><i></i><i></i></div>
    <div class="v2-shell v2-hero-content"><MotionReveal class="v2-hero-message"><p class="v2-eyebrow">AI NETWORKS · HUMAN + MACHINE · FORWARD TOGETHER</p><h1 id="brand-title">The future of yesterday, today.</h1><p class="v2-hero-en">{t('昨天的科幻，今天的日常。','Yesterday’s science fiction. Today’s everyday life.')}</p><p>{t('歡迎來到 AI 時代。ELIAS NET 把人類對未來的想像，化為走進生活與工作的人工智慧。','Welcome to the AI era. ELIAS NET turns humanity’s vision of the future into intelligence for life and work.')}</p><div class="v2-actions"><CTA href="#products" label={t('探索產品','Explore products')} locale={locale}/><CTA href="#governance" label={t('了解人與 AI 如何合作','See how people and AI work together')} locale={locale} secondary/></div></MotionReveal></div>
    <a class="v2-hero-scroll" href="#products" aria-label={t('向下探索產品','Scroll to explore products')}><span>{t('向下探索','EXPLORE')}</span><i aria-hidden="true"></i></a>
  </ScrollScene>

  <ScrollScene id="products" tone="dark" class="v2-products-scene v2-model-architecture" labelledby="products-title"><AmbientLightField variant="teal"/><div class="v2-shell"><div class="v2-model-architecture-head"><MotionReveal><p class="v2-eyebrow">PRODUCT SYSTEMS / {t('產品系統','PRODUCT SYSTEMS')}</p><h2 id="products-title">{t('兩大產品系統，走進工作、生活與救援。','Two product systems for work, daily life and rescue.')}</h2><p>{t('選一個方向，查看產品、型號與真人情境。','Choose a direction, then explore products, models and real-world scenarios.')}</p></MotionReveal><div class="v2-architecture-families"><article data-motion-reveal><span>01</span><p class="v2-eyebrow">DIGITAL INTELLIGENCE</p><h3>{t('線上智慧支援','Digital Intelligence')}</h3><p>{t('協助企業處理知識、客服、流程與營運問題。','Support enterprise knowledge, service, workflows and operations.')}</p><strong>Elias Knowledge · Care · Flow · Ops</strong><a href={`${prefix}digital-intelligence/`}>{t('查看兩條產品線','Explore two product lines')} →</a></article><article data-motion-reveal><span>02</span><p class="v2-eyebrow">AI ROBOTICS</p><h3>{t('人工智慧機器人','AI Robots')}</h3><p>{t('探索居家陪伴、生活協助與專業救援的產品家族及型號。','Explore product families and models for home companionship, daily assistance and professional rescue.')}</p><strong>Elias Home · Rescue</strong><a href={`${prefix}ai-robots/`}>{t('觀看情境與型號','View scenarios and models')} →</a></article></div></div></div></ScrollScene>

  <ScrollScene id="features" tone="dark" class="v2-solutions-scene" labelledby="features-title"><AmbientLightField variant="warm"/><div class="v2-shell"><MotionReveal class="v2-section-head"><p class="v2-eyebrow">AI CAPABILITIES / {t('AI 特性','AI CAPABILITIES')}</p><h2 id="features-title">{t('六項核心能力，讓 AI 真正幫得上忙。','Six core capabilities that make AI genuinely useful.')}</h2><p>{t('從理解資訊到協助行動，這些能力貫穿 Elias 的數位系統與機器人研究。','From understanding information to supporting action, these capabilities connect Elias digital systems and robotics research.')}</p></MotionReveal><div class="v2-solution-grid">{features.map((feature,index)=><article id={`feature-${feature.id}`} data-motion-reveal><span>0{index+1}</span><h3>{feature.title}</h3><p>{feature.copy}</p><small>{feature.tag}</small></article>)}</div></div></ScrollScene>

  <ScrollScene id="governance" tone="dark" class="v2-governance-scene v2-cocreation-scene" labelledby="governance-title">
    <MotionPicture class="v2-cocreation-backdrop" desktop={media('images/v2/human-ai-cocreation.webp')} mobile={media('images/v2/human-ai-cocreation.webp')} alt={t('孩子與友善的智慧夥伴同行，工作人員在控制中心持續監督系統','A child walks with a friendly intelligent companion while an operator continues supervising the system')}/>
    <div class="v2-cocreation-shade" aria-hidden="true"></div>
    <div class="v2-shell v2-cocreation-inner">
      <MotionReveal class="v2-cocreation-copy"><p class="v2-eyebrow">HUMAN + AI / {t('人與人工智慧同行','ALONGSIDE EACH OTHER')}</p><h2 id="governance-title">{t('AI 看見更多，人做出選擇。','AI sees more. People make the choice.')}</h2><p>{t('AI 整理訊號、提示風險並準備建議；人帶著經驗與責任，決定是否前進。','AI organizes signals, highlights risk and prepares options. People bring experience and responsibility to decide what happens next.')}</p></MotionReveal>
      <div class="v2-cocreation-principles" aria-label={t('人與人工智慧並肩同行','People and artificial intelligence moving forward side by side')}>
        <article data-motion-reveal><span>AI</span><h3>{t('幫我們看見更多','Helps us see more')}</h3><p>{t('留意容易錯過的需要與線索，讓幫助在適合的時候自然出現。','Notice needs and clues we might miss, so help can appear naturally at the right moment.')}</p></article>
        <article data-motion-reveal><span>HUMAN</span><h3>{t('讓科技懂得關心','Brings care to technology')}</h3><p>{t('我們用經驗與同理心選擇方向，讓每一項能力都回到人的真實需要。','We use experience and empathy to choose the direction, keeping every capability grounded in real human needs.')}</p></article>
        <article data-motion-reveal><span>TOGETHER</span><h3>{t('人與 AI，各自發揮所長','People and AI, each at their best')}</h3><p>{t('AI 整理資訊並準備建議，人員確認行動，也為最後的結果負責。','AI organizes information and prepares options. People confirm the action and remain accountable for the outcome.')}</p></article>
      </div>
      <a class="v2-cocreation-link" href={`${prefix}safety/`}>{t('了解人與 AI 的合作方式','See how people and AI work together')} →</a>
    </div>
  </ScrollScene>

  <ScrollScene id="collaboration" tone="dark" class="v2-collaboration-scene" labelledby="collaboration-title"><AmbientLightField variant="violet" density="quiet"/><div class="v2-shell"><div class="v2-collaboration-intro"><MotionReveal><p class="v2-eyebrow">COLLABORATION / {t('合作方式','HOW TO WORK WITH US')}</p><h2 id="collaboration-title">{t('從一個清楚的問題開始。','Start with one clear problem.')}</h2><p>{t('先確認需求，再用小範圍驗證找出可行的下一步。','Clarify the need, then use a focused validation to find the next practical step.')}</p></MotionReveal></div><div class="v2-collaboration-offers"><article><span>01</span><p class="v2-eyebrow">{t('了解方式','UNDERSTAND THE APPROACH')}</p><h3>{t('先看合作怎麼進行','See how engagement works')}</h3><p>{t('從需求探索、原型驗證到 AI 系統整合，依實際範圍前進。','Move from discovery to prototype and AI integration based on the real scope.')}</p><a href={`${prefix}pricing/`}>{t('查看合作方案','View plans')} →</a></article><article><span>02</span><p class="v2-eyebrow">{t('準備整合','PREPARE TO INTEGRATE')}</p><h3>{t('先看資料與人工確認','Review data and human checkpoints')}</h3><p>{t('用示意文件了解資料、權限與人工確認如何接進流程。','Use the illustrative documentation to understand data, permissions and human review.')}</p><a href={`${prefix}docs/`}>{t('查看整合文件','Read documentation')} →</a></article><article><span>03</span><p class="v2-eyebrow">{t('開始對話','START A CONVERSATION')}</p><h3>{t('帶著真實需求來找我們','Bring us a real need')}</h3><p>{t('告訴我們想改善什麼，一起找出適合的起點。','Tell us what you want to improve and we will find a practical starting point.')}</p><a href={`${prefix}contact/`}>{t('洽談合作','Talk with us')} →</a></article></div></div></ScrollScene>
</MotionProvider>

<script>
  const reduceHeroMotion = matchMedia('(prefers-reduced-motion: reduce)');
  const hero = document.querySelector<HTMLElement>('#brand');
  const playHero = () => {
    if (!hero || reduceHeroMotion.matches) return;
    hero.classList.remove('is-hero-playing');
    void hero.offsetWidth;
    hero.classList.add('is-hero-playing');
    hero.dataset.heroState = 'playing';
    window.setTimeout(() => { if (hero.dataset.heroState === 'playing') hero.dataset.heroState = 'complete'; }, 8200);
  };
  if (hero) {
    if (reduceHeroMotion.matches) hero.dataset.heroState = 'complete';
    else requestAnimationFrame(playHero);
    const heroObserver = new IntersectionObserver(([entry]) => {
      const animations = typeof hero.getAnimations === 'function' ? hero.getAnimations({ subtree:true }) : [];
      animations.forEach((animation) => entry?.isIntersecting ? animation.play() : animation.pause());
    }, { threshold:.05 });
    heroObserver.observe(hero);
  }
</script>
