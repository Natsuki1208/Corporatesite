---
import type { SiteLocale } from '../../data/products';
import { simplify } from '../../data/simplified-map';
import MotionProvider from './motion/MotionProvider.astro';
import ScrollScene from './motion/ScrollScene.astro';
import MotionReveal from './motion/MotionReveal.astro';
import MotionPicture from './motion/MotionPicture.astro';
import AmbientLightField from './AmbientLightField.astro';
import HeroParticleRibbon from './HeroParticleRibbon.astro';
const { locale }=Astro.props as {locale:SiteLocale};
const base=import.meta.env.BASE_URL.replace(/\/$/,'');
const prefix=locale==='en'?`${base}/en/`:locale==='zh-CN'?`${base}/zh-cn/`:`${base}/`;
const t=(zh:string,en:string)=>locale==='en'?en:locale==='zh-CN'?simplify(zh):zh;
const sectionLabel=(english:string,zh:string)=>locale==='en'?english:`${english} / ${t(zh,english)}`;
const media=(path:string)=>`${base}/${path}`;
const features=[
  {id:'understand',title:t('釐清需求','CLARIFY NEEDS'),copy:t('確認使用者、工作方式與成功條件，讓服務從真正的問題出發。','Define users, workflows and success criteria so every service begins with the real problem.'),tag:'DISCOVER'},
  {id:'focus',title:t('建置應用','BUILD APPLICATIONS'),copy:t('把已確認的需求轉化為可測試、可維護的軟體與介面。','Turn confirmed needs into software and interfaces that can be tested and maintained.'),tag:'BUILD'},
  {id:'assist',title:t('協作知識','COLLABORATE WITH KNOWLEDGE'),copy:t('整理可靠來源、準備回應，並保留人工確認與追溯。','Organize reliable sources, prepare responses and retain human review and traceability.'),tag:'COLLABORATE'},
  {id:'coordinate',title:t('整合資料','INTEGRATE DATA'),copy:t('連結分散資料、改善品質與查詢效率，建立清楚的資訊基礎。','Connect scattered data, improve quality and retrieval, and establish a clear information foundation.'),tag:'INTEGRATE'},
  {id:'sense',title:t('安全與治理','SAFE GOVERNANCE'),copy:t('先確認權限、法規與風險條件，並保留人工核准、操作紀錄與必要的停止機制。','Define permissions, regulatory and risk conditions, with human approval, action records and stop controls where needed.'),tag:'GOVERNANCE'},
  {id:'act',title:t('維運改善','IMPROVE OPERATIONS'),copy:t('以測試、監測與明確交接，讓服務在實際運作中持續改善。','Use testing, monitoring and clear handoffs to improve services through real operations.'),tag:'IMPROVE'}
];
---
<MotionProvider class="v2-immersive-home" ambientField={false}>
  <ScrollScene id="brand" tone="dark" class="v2-immersive-hero" labelledby="brand-title">
    <HeroParticleRibbon label={t('由深青、銀灰與暖金色光點交織成流動的智慧網絡','A flowing intelligence network woven from deep teal, silver and warm-gold particles')}/>
    <div class="v2-hero-shade" aria-hidden="true"></div>
    <div class="v2-shell v2-hero-content"><MotionReveal class="v2-hero-message"><h1 id="brand-title" class="v2-hero-declaration"><span>Imagined yesterday.</span> <span>Built for today.</span></h1>{locale !== 'en' && <p class="v2-hero-declaration-zh">{t('昨日的想像，今日的實現。','Imagined yesterday. Built for today.')}</p>}<p class="v2-hero-positioning">{t('Elias Net 提供 AI 應用、軟體開發與資料整合服務，支援直接導入、配置導入與客製整合。','Elias Net provides AI applications, software development and data integration through direct adoption, configured deployment and custom integration.')}</p></MotionReveal></div>
  </ScrollScene>

  <ScrollScene id="products" tone="dark" class="v2-products-scene v2-model-architecture" labelledby="products-title">
    <AmbientLightField variant="teal"/>
    <div class="v2-shell"><div class="v2-model-architecture-head">
      <MotionReveal><p class="v2-eyebrow">{sectionLabel('SERVICE PORTFOLIO','服務項目')}</p><h2 id="products-title">{t('從可直接導入的能力，到完整客製整合。','From ready-to-adopt capabilities to complete custom integration.')}</h2><p>{t('依需求與既有環境，選擇直接導入、配置導入或客製整合。','Choose direct adoption, configured deployment or custom integration based on your needs and existing environment.')}</p></MotionReveal>
      <div class="v2-architecture-families">
        <article id="service-ai" data-motion-reveal><span>01</span><p class="v2-eyebrow">AI APPLICATIONS + COLLABORATION</p><h3>{t('AI 應用與協作','AI Applications & Collaboration')}</h3><p>{t('協助整理知識、理解需求、準備回應並推進工作流程。','Organize knowledge, understand needs, prepare responses and support workflows.')}</p><a href={`${prefix}digital-intelligence/`}>{t('查看 AI 應用','Explore AI applications')} →</a></article>
        <article id="service-enterprise" data-motion-reveal><span>02</span><p class="v2-eyebrow">ENTERPRISE DIGITAL SOLUTIONS</p><h3>{t('企業數位服務','Enterprise Digital Services')}</h3><p>{t('以 Elias Build、Data 與 Chain，支援應用軟體、資料效能及數位資產整合。','Use Elias Build, Data and Chain for application software, data performance and digital-asset integration.')}</p><a href={`${prefix}enterprise-digital-solutions/`}>{t('查看數位服務','Explore digital services')} →</a></article>
      </div>
    </div></div>
  </ScrollScene>

  <ScrollScene id="features" tone="light" class="v2-solutions-scene" labelledby="features-title"><AmbientLightField variant="warm"/><div class="v2-shell"><MotionReveal class="v2-section-head"><p class="v2-eyebrow">{sectionLabel('SERVICE CAPABILITIES','服務能力')}</p><h2 id="features-title">{t('從釐清需求，到穩定運作。','From a clear need to dependable operations.')}</h2><p>{t('六項服務能力，串起 AI 協作、應用建置、資料整合與後續維運。','Six service capabilities connect AI collaboration, application delivery, data integration and ongoing operations.')}</p></MotionReveal><div class="v2-solution-grid">{features.map((feature,index)=><article id={`feature-${feature.id}`} data-motion-reveal><span>0{index+1}</span><h3>{feature.title}</h3><p>{feature.copy}</p><small>{feature.tag}</small></article>)}</div></div></ScrollScene>

  <ScrollScene id="governance" tone="light" class="v2-governance-scene v2-cocreation-scene" labelledby="governance-title">
    <MotionPicture class="v2-cocreation-backdrop" desktop={media('images/v2/human-ai-cocreation.webp')} mobile={media('images/v2/human-ai-cocreation.webp')} alt={t('孩子與友善的智慧夥伴同行，工作人員在控制中心持續監督系統','A child walks with a friendly intelligent companion while an operator continues supervising the system')}/>
    <div class="v2-cocreation-shade" aria-hidden="true"></div>
    <div class="v2-shell v2-cocreation-inner">
      <MotionReveal class="v2-cocreation-copy"><p class="v2-eyebrow">{sectionLabel('HUMAN + AI','人與人工智慧同行')}</p><h2 id="governance-title">{t('AI 看見更多，人做出選擇。','AI sees more. People make the choice.')}</h2><p>{t('AI 整理訊息、提示風險並準備建議；人以經驗與責任，決定下一步。','AI organizes information, highlights risk and prepares options. People bring experience and responsibility to decide the next step.')}</p></MotionReveal>
      <div class="v2-cocreation-principles" aria-label={t('人與人工智慧並肩同行','People and artificial intelligence moving forward side by side')}>
        <article data-motion-reveal><span>AI</span><h3>{t('幫我們看見更多','Helps us see more')}</h3><p>{t('留意容易錯過的需要與線索，讓幫助在適合的時候自然出現。','Notice needs and clues we might miss, so help can appear naturally at the right moment.')}</p></article>
        <article data-motion-reveal><span>HUMAN</span><h3>{t('讓科技回應人的需要','Keeps technology focused on people')}</h3><p>{t('我們用經驗與同理心選擇方向，讓每一項能力都回到人的真實需要。','We use experience and empathy to choose the direction, keeping every capability grounded in real human needs.')}</p></article>
        <article data-motion-reveal><span>TOGETHER</span><h3>{t('人與 AI，各自發揮所長','People and AI, each at their best')}</h3><p>{t('AI 整理資訊並準備建議，人員確認行動，也為最後的結果負責。','AI organizes information and prepares options. People confirm the action and remain accountable for the outcome.')}</p></article>
      </div>
      <a class="v2-cocreation-link" href={`${prefix}safety/`}>{t('了解人與 AI 的合作方式','See how people and AI work together')} →</a>
    </div>
  </ScrollScene>

  <ScrollScene id="collaboration" tone="light" class="v2-collaboration-scene" labelledby="collaboration-title"><AmbientLightField variant="violet" density="quiet"/><div class="v2-shell"><div class="v2-collaboration-intro"><MotionReveal><p class="v2-eyebrow">{sectionLabel('COLLABORATION','合作方式')}</p><h2 id="collaboration-title">{t('從一件值得改善的事開始。','Start with something worth improving.')}</h2><p>{t('確認需求、資料與整合條件後，選擇最合適的導入方式。','Confirm the need, data and integration conditions, then choose the right delivery model.')}</p></MotionReveal><MotionPicture class="v2-collaboration-visual" desktop={media('images/v2/services/elias-collaboration-planning.jpg')} mobile={media('images/v2/services/elias-collaboration-planning.jpg')} alt={t('Elias Net 團隊共同討論資料、產品與合作方向','The Elias Net team discussing data, product and collaboration priorities')}/></div><div class="v2-collaboration-offers"><article><span>01</span><p class="v2-eyebrow">{t('選擇導入方式','CHOOSE AN ADOPTION MODEL')}</p><h3>{t('直接使用、配置或客製','Adopt, configure or customize')}</h3><p>{t('依既有流程與系統環境，選擇直接導入、配置導入或客製整合。','Choose direct adoption, configured deployment or custom integration around your workflows and systems.')}</p><a href={`${prefix}pricing/`}>{t('查看合作方案','View plans')} →</a></article><article><span>02</span><p class="v2-eyebrow">{t('準備 AI 整合','PREPARE AI INTEGRATION')}</p><h3>{t('確認資料與人工核准','Review data and human checkpoints')}</h3><p>{t('了解資料、權限與人工確認如何接進現有流程。','Understand how data, permissions and human review fit into the existing workflow.')}</p><a href={`${prefix}docs/`}>{t('查看 AI 整合文件','Read AI documentation')} →</a></article><article><span>03</span><p class="v2-eyebrow">{t('開始對話','START A CONVERSATION')}</p><h3>{t('帶著真實需求來找我們','Bring us a real need')}</h3><p>{t('說明想改善的工作與既有環境，我們會一起確認適合的導入方式。','Describe the work and environment you want to improve, and we will identify the right adoption model together.')}</p><a href={`${prefix}contact/`}>{t('洽談合作','Talk with us')} →</a></article></div></div></ScrollScene>
</MotionProvider>

<script>
  const reduceHeroMotion = matchMedia('(prefers-reduced-motion: reduce)');
  const hero = document.querySelector<HTMLElement>('#brand');
  const playHero = () => {
    if (!hero || reduceHeroMotion.matches) return;
    hero.classList.remove('is-hero-playing');
    void hero.offsetWidth;
    hero.classList.add('is-hero-playing');
    hero.dataset.heroState = 'playing';
    window.setTimeout(() => { if (hero.dataset.heroState === 'playing') hero.dataset.heroState = 'complete'; }, 8200);
  };
  if (hero) {
    if (reduceHeroMotion.matches) hero.dataset.heroState = 'complete';
    else requestAnimationFrame(playHero);
    const heroObserver = new IntersectionObserver(([entry]) => {
      const animations = typeof hero.getAnimations === 'function' ? hero.getAnimations({ subtree:true }) : [];
      animations.forEach((animation) => entry?.isIntersecting ? animation.play() : animation.pause());
    }, { threshold:.05 });
    heroObserver.observe(hero);
  }
</script>
