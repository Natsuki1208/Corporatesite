---
import type { SiteLocale } from '../../data/products';
import { products,l } from '../../data/products';
import { simplify } from '../../data/simplified-map';
import CTA from './CTA.astro';
import ProductStatus from './ProductStatus.astro';
import MotionProvider from './motion/MotionProvider.astro';
import ScrollScene from './motion/ScrollScene.astro';
import MotionReveal from './motion/MotionReveal.astro';
import MotionPicture from './motion/MotionPicture.astro';
import AnimatedBrandMark from './AnimatedBrandMark.astro';
const { locale }=Astro.props as {locale:SiteLocale};
const base=import.meta.env.BASE_URL.replace(/\/$/,'');
const prefix=locale==='en'?`${base}/en/`:locale==='zh-CN'?`${base}/zh-cn/`:`${base}/`;
const t=(zh:string,en:string)=>locale==='en'?en:locale==='zh-CN'?simplify(zh):zh;
const media=(path:string)=>`${base}/${path}`;
const solutions=[
  {title:t('企業工作與服務','ENTERPRISE WORK & SERVICE'),copy:t('讓知識、客服與重複流程更容易理解、確認並持續推進。','Make knowledge, service and recurring workflows easier to understand, review and move forward.'),users:t('企業知識、客服、流程、行政與營運團隊','Knowledge, service, workflow, administration and operations teams')},
  {title:t('網路與基礎設施','NETWORK & INFRASTRUCTURE'),copy:t('把分散告警整理成事件脈絡與下一步，重要操作等待工程師授權。','Turn scattered alerts into incident context and next steps, with important actions waiting for engineer authorization.'),users:t('IT、NOC、SRE 與基礎設施維運團隊','IT, NOC, SRE and infrastructure operations teams')},
  {title:t('生活與高風險環境','DAILY & HIGH-RISK ENVIRONMENTS'),copy:t('探索由人指示、可停止的居家協助與非武裝救援支援。','Explore human-directed, stoppable assistance for homes and unarmed rescue support.'),users:t('輔助科技、照護、醫療及災害救援合作夥伴','Assistive technology, care, medical and disaster-response partners')}
];
---
<MotionProvider class="v2-immersive-home">
  <ScrollScene id="brand" tone="dark" class="v2-immersive-hero" labelledby="brand-title">
    <MotionPicture class="v2-hero-backdrop" desktop={`${base}/images/v2/elias-net-home-hero-desktop.jpg`} mobile={`${base}/images/v2/elias-net-home-hero-mobile.jpg`} alt={t('一位工作者與智慧系統並肩看向未來','A professional and an intelligent system looking toward the future together')} eager/>
    <div class="v2-hero-shade" aria-hidden="true"></div>
    <div class="v2-hero-depth" aria-hidden="true"><i></i><i></i><i></i></div>
    <div class="v2-hero-cinematic" aria-hidden="true"><i class="v2-hero-sweep"></i><i class="v2-hero-horizon"></i><i class="v2-hero-orbit-meteor meteor-one"></i><i class="v2-hero-orbit-meteor meteor-two"></i><i class="v2-hero-orbit-meteor meteor-three"></i></div>
    <div class="v2-shell v2-hero-content"><MotionReveal class="v2-hero-message"><p class="v2-eyebrow">AI NETWORKS · RESCUE ROBOTICS · HUMAN COMMAND</p><h1 id="brand-title">The future of yesterday, today.</h1><p class="v2-hero-en">{t('昨日想像的未來，今天由人類指揮。','Yesterday’s imagined future—under human command today.')}</p><p>{t('ELIAS NET 建構能理解資訊、協調系統並走進真實環境的人工智慧產品。從企業知識與網路維運，到居家協助及非武裝救援，人工智能幫我們看見更多；我們帶著經驗與關心，一起選擇下一步。','ELIAS NET builds intelligent products that understand information, coordinate systems and enter the real world. From enterprise knowledge and network operations to home assistance and unarmed rescue, artificial intelligence helps us see more; we bring experience and care, choosing the next step together.')}</p><p class="v2-hero-protocol" aria-label="SENSE, COORDINATE, AUTHORIZE, RESPOND"><span>SENSE</span><i>·</i><span>COORDINATE</span><i>·</i><span>AUTHORIZE</span><i>·</i><span>RESPOND</span></p><div class="v2-actions"><CTA href="#products" label={t('探索產品','Explore products')} locale={locale}/><CTA href="#governance" label={t('看看我們如何同行','See how we move forward together')} locale={locale} secondary/><button type="button" class="v2-hero-replay" data-hero-replay>{t('重播首屏動畫','Replay opening')}</button></div></MotionReveal></div>
    <a class="v2-hero-scroll" href="#products" aria-label={t('向下探索產品','Scroll to explore products')}><span>{t('向下探索','EXPLORE')}</span><i aria-hidden="true"></i></a>
  </ScrollScene>

  <ScrollScene id="products" tone="light" class="v2-products-scene" labelledby="products-title"><div class="v2-shell"><MotionReveal class="v2-section-head"><p class="v2-eyebrow">PRODUCTS / {t('產品','PRODUCTS')}</p><h2 id="products-title">{t('六項產品，讓智慧走進工作與真實世界。','Six products bringing intelligence into work and the real world.')}</h2><p>{t('第一眼先看產品能幫助誰、能一起完成什麼，以及人與人工智能如何合作；詳細技術與研發狀態留在產品頁。','See who each product helps, what people and artificial intelligence can accomplish together, and how the collaboration works. Deeper technology and research status remain on each product page.')}</p></MotionReveal><div class="v2-product-editorial">{products.map((product,index)=><article class:list={['v2-product-row',index%2===1&&'is-reverse']} data-motion-reveal><MotionPicture desktop={media(product.media.hero.desktop)} mobile={media(product.media.hero.mobile)} alt={l(product.media.hero.alt,locale)}/><div><span class="v2-product-index">0{index+1}</span><p class="v2-eyebrow">{product.family==='digital'?'DIGITAL INTELLIGENCE':'EMBODIED INTELLIGENCE'}</p><h3>{product.name}</h3><h4>{l(product.headline,locale)}</h4><p>{l(product.intro,locale)}</p><dl><div><dt>{t('主要使用者','WHO IT SERVES')}</dt><dd>{product.audience.slice(0,2).map((item)=>l(item,locale)).join(' · ')}</dd></div><div><dt>{t('如何一起完成','HOW WE WORK TOGETHER')}</dt><dd>{l(product.collaboration,locale)}</dd></div></dl><div class="v2-row-foot"><ProductStatus status={product.status} locale={locale} note={l(product.statusNote,locale)}/><a href={`${prefix}products/${product.slug}/`}>{t('查看產品','View product')} →</a></div></div></article>)}</div></div></ScrollScene>

  <ScrollScene id="solutions" tone="soft" class="v2-solutions-scene" labelledby="solutions-title"><div class="v2-shell"><MotionReveal class="v2-section-head"><p class="v2-eyebrow">SOLUTIONS / {t('解決方案','SOLUTIONS')}</p><h2 id="solutions-title">{t('從一個真實任務開始，再決定需要多少智慧。','Start with a real mission, then decide how much intelligence it needs.')}</h2></MotionReveal><div class="v2-solution-grid">{solutions.map((solution,index)=><article data-motion-reveal><span>0{index+1}</span><h3>{solution.title}</h3><p>{solution.copy}</p><small>{solution.users}</small></article>)}</div></div></ScrollScene>

  <ScrollScene id="organization" tone="light" class="v2-organization-scene" labelledby="organization-title"><div class="v2-shell v2-two-grid"><MotionReveal><p class="v2-eyebrow">PRODUCT SYSTEM / {t('產品系統架構','PRODUCT SYSTEM')}</p><h2 id="organization-title">{t('一個智慧核心，讓六項產品朝同一個方向前進。','One intelligence core keeps six products moving in the same direction.')}</h2><p>{t('Knowledge、Care、Flow 與 Ops 協助處理資訊和工作；Home 與 Rescue 把感知與行動帶進真實環境。六項產品共享一致的安全原則：AI 負責看見、整理與準備，我們決定何時採取行動。','Knowledge, Care, Flow and Ops help with information and work. Home and Rescue bring sensing and action into real environments. All six share one safety principle: AI observes, organizes and prepares; people decide when to act.')}</p></MotionReveal><div class="v2-platform-map" aria-label={t('Elias Intelligence Core 六項產品系統架構','Elias Intelligence Core six-product system')}><AnimatedBrandMark id="organization" variant="icon"/><div><strong>{t('數位智慧','DIGITAL INTELLIGENCE')}</strong><span>Knowledge · Care · Flow · Ops</span></div><div><strong>{t('實體智慧','EMBODIED INTELLIGENCE')}</strong><span>Home · Rescue</span></div></div></div></ScrollScene>

  <ScrollScene id="governance" tone="dark" class="v2-governance-scene v2-cocreation-scene" labelledby="governance-title">
    <MotionPicture class="v2-cocreation-backdrop" desktop={media('images/v2/human-ai-cocreation.webp')} mobile={media('images/v2/human-ai-cocreation.webp')} alt={t('孩子與友善的智慧夥伴同行，工作人員在控制中心持續監督系統','A child walks with a friendly intelligent companion while an operator continues supervising the system')}/>
    <div class="v2-cocreation-shade" aria-hidden="true"></div>
    <div class="v2-shell v2-cocreation-inner">
      <MotionReveal class="v2-cocreation-copy"><p class="v2-eyebrow">HUMAN + AI / {t('人與人工智能同行','ALONGSIDE EACH OTHER')}</p><h2 id="governance-title">{t('人與人工智能並肩而行，把未來走得更遠。','People and artificial intelligence, side by side toward a greater future.')}</h2><p>{t('人工智能不是站在我們對面的工具，而是一起工作、一起生活的好夥伴。它幫我們理解環境、留意細節並準備下一步；我們帶著經驗、關心與想像，共同決定要去的方向。','Artificial intelligence is not a tool standing apart from us, but a companion in work and life. It helps us understand our surroundings, notice details and prepare what comes next. We bring experience, care and imagination—and choose the direction together.')}</p></MotionReveal>
      <div class="v2-cocreation-principles" aria-label={t('人與人工智能並肩同行','People and artificial intelligence moving forward side by side')}>
        <article data-motion-reveal><span>AI</span><h3>{t('幫我們看見更多','Helps us see more')}</h3><p>{t('留意容易錯過的需要與線索，讓幫助在適合的時候自然出現。','Notice needs and clues we might miss, so help can appear naturally at the right moment.')}</p></article>
        <article data-motion-reveal><span>HUMAN</span><h3>{t('讓科技懂得關心','Brings care to technology')}</h3><p>{t('我們用經驗與同理心選擇方向，讓每一項能力都回到人的真實需要。','We use experience and empathy to choose the direction, keeping every capability grounded in real human needs.')}</p></article>
        <article data-motion-reveal><span>TOGETHER</span><h3>{t('一起把下一步走好','Takes the next step together')}</h3><p>{t('人工智能準備協助，我們做出選擇；彼此發揮所長，一起完成更好的結果。','Artificial intelligence prepares support and we make the choice—each contributing what we do best to create a better result.')}</p></article>
      </div>
      <a class="v2-cocreation-link" href={`${prefix}safety/`}>{t('看看我們如何讓人與人工智能一起前進','See how people and AI move forward together')} →</a>
    </div>
  </ScrollScene>

  <ScrollScene id="collaboration" tone="soft" class="v2-collaboration-scene" labelledby="collaboration-title"><div class="v2-shell"><div class="v2-collaboration-intro"><MotionReveal><p class="v2-eyebrow">COLLABORATION / {t('合作模式','HOW TO WORK WITH US')}</p><h2 id="collaboration-title">{t('選一項產品，或帶著一個值得解決的問題開始。','Choose a product—or start with a problem worth solving.')}</h2><p>{t('Elias Net 提供四項企業 AI 產品的導入與共同驗證，也開放兩項仿生人概念的研發合作。先從小範圍確認價值、資料、環境與安全界線，再決定是否繼續擴大。','Elias Net offers implementation and joint validation for four enterprise AI products, plus research collaboration for two humanoid concepts. We start small to confirm value, data, environment and safety boundaries before expanding.')}</p></MotionReveal><div class="v2-actions"><CTA href={`${prefix}contact/`} label={t('討論合作可能','Discuss collaboration')} locale={locale}/><CTA href={`${prefix}digital-intelligence/`} label={t('查看所有產品','View all products')} locale={locale} secondary/></div></div><div class="v2-collaboration-offers"><article><span>01</span><p class="v2-eyebrow">{t('企業 AI 產品','ENTERPRISE AI PRODUCTS')}</p><h3>Elias Knowledge · Care · Flow · Ops</h3><p>{t('從知識搜尋、客服、流程到維運，選一個日常工作問題進行原型驗證與系統整合。','Validate and integrate one everyday problem across knowledge, service, workflows or operations.')}</p><a href={`${prefix}digital-intelligence/`}>{t('查看數位智慧','Explore digital intelligence')} →</a></article><article><span>02</span><p class="v2-eyebrow">{t('仿生人研發合作','HUMANOID RESEARCH')}</p><h3>Elias Home · Elias Rescue</h3><p>{t('針對居家協助與非武裝救援，討論情境研究、安全設計、感測與遠端控制驗證。','Explore scenario research, safety design, sensing and remote-control validation for home assistance and unarmed rescue.')}</p><a href={`${prefix}embodied-intelligence/`}>{t('查看實體智慧','Explore embodied intelligence')} →</a></article><article><span>03</span><p class="v2-eyebrow">{t('從問題開始','START WITH A PROBLEM')}</p><h3>{t('還不確定適合哪一項產品？','Not sure which product fits?')}</h3><p>{t('告訴我們工作卡在哪裡。我們會先釐清使用者、資料、權限與風險，再提出適合的起點。','Tell us where the work gets stuck. We will clarify users, data, permissions and risk before suggesting a starting point.')}</p><a href={`${prefix}contact/`}>{t('帶著問題來聊聊','Bring us a problem')} →</a></article></div></div></ScrollScene>
</MotionProvider>

<script>
  const reduceHeroMotion = matchMedia('(prefers-reduced-motion: reduce)');
  const hero = document.querySelector<HTMLElement>('#brand');
  const replay = hero?.querySelector<HTMLButtonElement>('[data-hero-replay]');
  const playHero = () => {
    if (!hero || reduceHeroMotion.matches) return;
    hero.classList.remove('is-hero-playing');
    void hero.offsetWidth;
    hero.classList.add('is-hero-playing');
    hero.dataset.heroState = 'playing';
    window.setTimeout(() => { if (hero.dataset.heroState === 'playing') hero.dataset.heroState = 'complete'; }, 8200);
  };
  replay?.addEventListener('click', playHero);
  if (hero) {
    if (reduceHeroMotion.matches) hero.dataset.heroState = 'complete';
    else requestAnimationFrame(playHero);
    const heroObserver = new IntersectionObserver(([entry]) => {
      const animations = typeof hero.getAnimations === 'function' ? hero.getAnimations({ subtree:true }) : [];
      animations.forEach((animation) => entry?.isIntersecting ? animation.play() : animation.pause());
    }, { threshold:.05 });
    heroObserver.observe(hero);
  }
</script>
