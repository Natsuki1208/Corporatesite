---
import type { SiteLocale } from '../../data/products';
import { simplify } from '../../data/simplified-map';
import CTA from './CTA.astro';
import MotionProvider from './motion/MotionProvider.astro';
import ScrollScene from './motion/ScrollScene.astro';
import MotionReveal from './motion/MotionReveal.astro';
import MotionPicture from './motion/MotionPicture.astro';
const { locale }=Astro.props as {locale:SiteLocale};
const base=import.meta.env.BASE_URL.replace(/\/$/,'');
const prefix=locale==='en'?`${base}/en/`:locale==='zh-CN'?`${base}/zh-cn/`:`${base}/`;
const t=(zh:string,en:string)=>locale==='en'?en:locale==='zh-CN'?simplify(zh):zh;
const media=(path:string)=>`${base}/${path}`;
const solutions=[
  {title:t('企業知識與客服','KNOWLEDGE & SERVICE'),copy:t('更快找到可靠資訊、理解每一次需求，也讓回覆準備得更完整。','Find reliable information, understand each request and prepare stronger responses.'),users:t('一般員工、專案、人資、法務與客服團隊','Employees, project teams, HR, legal and customer service'),href:`${prefix}digital-intelligence/`},
  {title:t('營運與工作流程','OPERATIONS & WORKFLOWS'),copy:t('整理表單、待辦與系統異常，讓負責的人清楚知道下一步。','Organize forms, tasks and system incidents so the right people can see what comes next.'),users:t('行政、採購、財務、IT、NOC 與 SRE 團隊','Administration, procurement, finance, IT, NOC and SRE teams'),href:`${prefix}digital-intelligence/`},
  {title:t('居家陪伴與協助','HOME COMPANIONSHIP'),copy:t('探索能理解生活需求、安心移動並協助日常小事的智慧夥伴。','Explore intelligent companions that understand daily needs, move safely and help with everyday tasks.'),users:t('家庭、高齡生活支持與輔助科技夥伴','Families, ageing-in-place support and assistive technology partners'),href:`${prefix}products/elias-home/`},
  {title:t('災害搜尋與救援','SEARCH & RESCUE'),copy:t('先感測危險、回傳資訊並支援物資運送，讓專業人員掌握行動。','Sense danger, return information and support supply transport while professionals direct the response.'),users:t('消防、醫療、災害應變與人道救援團隊','Fire, medical, disaster-response and humanitarian teams'),href:`${prefix}products/elias-rescue/`}
];
---
<MotionProvider class="v2-immersive-home">
  <ScrollScene id="brand" tone="dark" class="v2-immersive-hero" labelledby="brand-title">
    <MotionPicture class="v2-hero-backdrop" desktop={`${base}/images/v2/elias-net-home-hero-desktop.jpg`} mobile={`${base}/images/v2/elias-net-home-hero-mobile.jpg`} alt={t('一位工作者與智慧系統並肩看向未來','A professional and an intelligent system looking toward the future together')} eager/>
    <div class="v2-hero-shade" aria-hidden="true"></div>
    <div class="v2-hero-depth" aria-hidden="true"><i></i><i></i><i></i></div>
    <div class="v2-hero-stars" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i><i></i><i></i><i></i><i></i></div>
    <div class="v2-shell v2-hero-content"><MotionReveal class="v2-hero-message"><p class="v2-eyebrow">AI NETWORKS · RESCUE ROBOTICS · HUMAN COMMAND</p><h1 id="brand-title">The future of yesterday, today.</h1><p class="v2-hero-en">{t('昨日想像的未來，今天由人類指揮。','Yesterday’s imagined future—under human command today.')}</p><p>{t('ELIAS NET 研發人工智慧與機器人，讓科技走進工作、生活與救援現場。人工智慧幫我們看見更多，我們一起決定下一步。','ELIAS NET develops AI and robotics for work, daily life and rescue environments. Artificial intelligence helps us see more, and we choose what comes next together.')}</p><p class="v2-hero-protocol" aria-label="SENSE, COORDINATE, AUTHORIZE, RESPOND"><span>SENSE</span><i>·</i><span>COORDINATE</span><i>·</i><span>AUTHORIZE</span><i>·</i><span>RESPOND</span></p><div class="v2-actions"><CTA href="#products" label={t('探索產品','Explore products')} locale={locale}/><CTA href="#governance" label={t('看看我們如何同行','See how we move forward together')} locale={locale} secondary/><button type="button" class="v2-hero-replay" data-hero-replay>{t('重播首屏動畫','Replay opening')}</button></div></MotionReveal></div>
    <a class="v2-hero-scroll" href="#products" aria-label={t('向下探索產品','Scroll to explore products')}><span>{t('向下探索','EXPLORE')}</span><i aria-hidden="true"></i></a>
  </ScrollScene>

  <ScrollScene id="products" tone="light" class="v2-products-scene v2-model-architecture" labelledby="products-title"><div class="v2-shell"><div class="v2-model-architecture-head"><MotionReveal><p class="v2-eyebrow">PRODUCT SYSTEMS / {t('產品系統','PRODUCT SYSTEMS')}</p><h2 id="products-title">{t('兩大產品系統，陪人們把工作與生活走得更遠。','Two product systems helping people move work and life forward.')}</h2><p>{t('從你關心的方向開始，查看適合的產品、型號與真人情境。','Start with what matters to you, then explore the right products, models and real-world scenarios.')}</p></MotionReveal><div class="v2-architecture-families"><article data-motion-reveal><span>01</span><p class="v2-eyebrow">DIGITAL INTELLIGENCE</p><h3>{t('線上智慧支援','Digital Intelligence')}</h3><p>{t('協助企業處理知識、客服、流程與營運問題。','Support enterprise knowledge, service, workflows and operations.')}</p><strong>Elias Knowledge · Care · Flow · Ops</strong><a href={`${prefix}digital-intelligence/`}>{t('探索線上智慧支援','Explore digital intelligence')} →</a></article><article data-motion-reveal><span>02</span><p class="v2-eyebrow">AI ROBOTICS</p><h3>{t('人工智慧機器人','AI Robots')}</h3><p>{t('探索居家陪伴、生活協助與專業救援的產品家族及型號。','Explore product families and models for home companionship, daily assistance and professional rescue.')}</p><strong>Elias Home · Rescue</strong><a href={`${prefix}ai-robots/`}>{t('觀看真人情境與機器人型號','View scenarios and robot models')} →</a></article></div></div></div></ScrollScene>

  <ScrollScene id="solutions" tone="soft" class="v2-solutions-scene" labelledby="solutions-title"><div class="v2-shell"><MotionReveal class="v2-section-head"><p class="v2-eyebrow">APPLICATION AREAS / {t('應用區域','APPLICATION AREAS')}</p><h2 id="solutions-title">{t('從工作、生活到救援，找到適合你的智慧協助。','Find the right kind of intelligent support for work, daily life and rescue.')}</h2><p>{t('先從你想改善的事情開始，再看看哪一項產品能提供協助。','Start with what you want to improve, then see which product can help.')}</p></MotionReveal><div class="v2-solution-grid">{solutions.map((solution,index)=><article data-motion-reveal><span>0{index+1}</span><h3>{solution.title}</h3><p>{solution.copy}</p><small>{solution.users}</small><a href={solution.href}>{t('查看相關產品','See related products')} →</a></article>)}</div></div></ScrollScene>

  <ScrollScene id="governance" tone="dark" class="v2-governance-scene v2-cocreation-scene" labelledby="governance-title">
    <MotionPicture class="v2-cocreation-backdrop" desktop={media('images/v2/human-ai-cocreation.webp')} mobile={media('images/v2/human-ai-cocreation.webp')} alt={t('孩子與友善的智慧夥伴同行，工作人員在控制中心持續監督系統','A child walks with a friendly intelligent companion while an operator continues supervising the system')}/>
    <div class="v2-cocreation-shade" aria-hidden="true"></div>
    <div class="v2-shell v2-cocreation-inner">
      <MotionReveal class="v2-cocreation-copy"><p class="v2-eyebrow">HUMAN + AI / {t('人與人工智慧同行','ALONGSIDE EACH OTHER')}</p><h2 id="governance-title">{t('人與人工智慧並肩而行，把未來走得更遠。','People and artificial intelligence, side by side toward a greater future.')}</h2><p>{t('人工智慧幫我們理解環境、留意細節並準備下一步。我們帶著經驗與關心，一起選擇前進的方向。','Artificial intelligence helps us understand our surroundings, notice details and prepare what comes next. We bring experience and care, choosing the direction together.')}</p></MotionReveal>
      <div class="v2-cocreation-principles" aria-label={t('人與人工智慧並肩同行','People and artificial intelligence moving forward side by side')}>
        <article data-motion-reveal><span>AI</span><h3>{t('幫我們看見更多','Helps us see more')}</h3><p>{t('留意容易錯過的需要與線索，讓幫助在適合的時候自然出現。','Notice needs and clues we might miss, so help can appear naturally at the right moment.')}</p></article>
        <article data-motion-reveal><span>HUMAN</span><h3>{t('讓科技懂得關心','Brings care to technology')}</h3><p>{t('我們用經驗與同理心選擇方向，讓每一項能力都回到人的真實需要。','We use experience and empathy to choose the direction, keeping every capability grounded in real human needs.')}</p></article>
        <article data-motion-reveal><span>TOGETHER</span><h3>{t('一起把下一步走好','Takes the next step together')}</h3><p>{t('人工智慧準備協助，我們做出選擇；彼此發揮所長，一起完成更好的結果。','Artificial intelligence prepares support and we make the choice—each contributing what we do best to create a better result.')}</p></article>
      </div>
      <a class="v2-cocreation-link" href={`${prefix}safety/`}>{t('看看我們如何讓人與人工智慧一起前進','See how people and AI move forward together')} →</a>
    </div>
  </ScrollScene>

  <ScrollScene id="collaboration" tone="soft" class="v2-collaboration-scene" labelledby="collaboration-title"><div class="v2-shell"><div class="v2-collaboration-intro"><MotionReveal><p class="v2-eyebrow">COLLABORATION / {t('合作模式','HOW TO WORK WITH US')}</p><h2 id="collaboration-title">{t('選一個方向，或帶著問題來找我們。','Choose a direction—or bring us a problem.')}</h2><p>{t('我們先小範圍確認需求與價值，再一起決定下一步。','We start small, confirm the need and value, then choose the next step together.')}</p></MotionReveal><div class="v2-actions"><CTA href={`${prefix}contact/`} label={t('討論合作可能','Discuss collaboration')} locale={locale}/><CTA href={`${prefix}digital-intelligence/`} label={t('查看線上智慧產品','View digital products')} locale={locale} secondary/></div></div><div class="v2-collaboration-offers"><article><span>01</span><p class="v2-eyebrow">{t('企業 AI 產品','ENTERPRISE AI PRODUCTS')}</p><h3>Elias Knowledge · Care · Flow · Ops</h3><p>{t('從知識搜尋、客服、流程到維運，先選一個日常問題開始。','Start with one everyday problem in knowledge, service, workflows or operations.')}</p><a href={`${prefix}digital-intelligence/`}>{t('查看線上智慧支援','Explore digital intelligence')} →</a></article><article><span>02</span><p class="v2-eyebrow">{t('人工智慧機器人','AI ROBOTICS')}</p><h3>Elias Home · Elias Rescue</h3><p>{t('從居家陪伴或專業救援開始，探索適合的產品家族與概念型號。','Explore product families and concept models for home companionship or professional rescue.')}</p><a href={`${prefix}ai-robots/`}>{t('查看機器人與型號','Explore robots and models')} →</a></article><article><span>03</span><p class="v2-eyebrow">{t('從問題開始','START WITH A PROBLEM')}</p><h3>{t('還不確定適合哪一個方向？','Not sure which direction fits?')}</h3><p>{t('告訴我們想改善什麼，我們一起找出適合的起點。','Tell us what you want to improve, and we will find a practical starting point together.')}</p><a href={`${prefix}contact/`}>{t('帶著問題來聊聊','Bring us a problem')} →</a></article></div></div></ScrollScene>
</MotionProvider>

<script>
  const reduceHeroMotion = matchMedia('(prefers-reduced-motion: reduce)');
  const hero = document.querySelector<HTMLElement>('#brand');
  const replay = hero?.querySelector<HTMLButtonElement>('[data-hero-replay]');
  const playHero = () => {
    if (!hero || reduceHeroMotion.matches) return;
    hero.classList.remove('is-hero-playing');
    void hero.offsetWidth;
    hero.classList.add('is-hero-playing');
    hero.dataset.heroState = 'playing';
    window.setTimeout(() => { if (hero.dataset.heroState === 'playing') hero.dataset.heroState = 'complete'; }, 8200);
  };
  replay?.addEventListener('click', playHero);
  if (hero) {
    if (reduceHeroMotion.matches) hero.dataset.heroState = 'complete';
    else requestAnimationFrame(playHero);
    const heroObserver = new IntersectionObserver(([entry]) => {
      const animations = typeof hero.getAnimations === 'function' ? hero.getAnimations({ subtree:true }) : [];
      animations.forEach((animation) => entry?.isIntersecting ? animation.play() : animation.pause());
    }, { threshold:.05 });
    heroObserver.observe(hero);
  }
</script>
