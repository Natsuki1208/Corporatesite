---
import type { SiteLocale } from '../../data/products';
import { simplify } from '../../data/simplified-map';
import CTA from './CTA.astro';
import MotionProvider from './motion/MotionProvider.astro';
import ScrollScene from './motion/ScrollScene.astro';
import MotionReveal from './motion/MotionReveal.astro';
import MotionPicture from './motion/MotionPicture.astro';
import AmbientLightField from './AmbientLightField.astro';
const { locale }=Astro.props as {locale:SiteLocale};
const base=import.meta.env.BASE_URL.replace(/\/$/,'');
const prefix=locale==='en'?`${base}/en/`:locale==='zh-CN'?`${base}/zh-cn/`:`${base}/`;
const t=(zh:string,en:string)=>locale==='en'?en:locale==='zh-CN'?simplify(zh):zh;
const media=(path:string)=>`${base}/${path}`;
const features=[
  {title:t('看懂資訊','UNDERSTAND INFORMATION'),copy:t('整理核准資料與現場訊號，建立清楚、可追溯的脈絡。','Turn approved data and real-world signals into clear, traceable context.'),tag:'UNDERSTAND'},
  {title:t('找出重點','FIND WHAT MATTERS'),copy:t('從大量內容中指出需要留意的變化、問題與下一步。','Surface the changes, issues and next steps that deserve attention.'),tag:'FOCUS'},
  {title:t('協助回覆','PREPARE RESPONSES'),copy:t('依可靠來源準備內容，讓人更快確認、調整與送出。','Prepare grounded responses for people to review, refine and send.'),tag:'ASSIST'},
  {title:t('推進流程','KEEP WORK MOVING'),copy:t('整理任務、狀態與交接，讓負責的人知道接下來要做什麼。','Organize tasks, status and handoffs so ownership stays clear.'),tag:'COORDINATE'},
  {title:t('感知環境','SENSE ENVIRONMENTS'),copy:t('透過感測資訊理解周遭情況，同時呈現限制與不確定性。','Use sensor input to understand surroundings while exposing limits and uncertainty.'),tag:'SENSE'},
  {title:t('支援行動','SUPPORT ACTION'),copy:t('在明確任務與安全界線內準備協助，關鍵決定仍由人做出。','Prepare support within clear tasks and safety limits, with people making key decisions.'),tag:'ACT'}
];
---
<MotionProvider class="v2-immersive-home">
  <ScrollScene id="brand" tone="dark" class="v2-immersive-hero" labelledby="brand-title">
    <MotionPicture class="v2-hero-backdrop" desktop={`${base}/images/v2/elias-net-home-hero-desktop.jpg`} mobile={`${base}/images/v2/elias-net-home-hero-mobile.jpg`} alt={t('一位工作者與智慧系統並肩看向未來','A professional and an intelligent system looking toward the future together')} eager/>
    <div class="v2-hero-shade" aria-hidden="true"></div>
    <div class="v2-hero-depth" aria-hidden="true"><i></i><i></i><i></i></div>
    <div class="v2-hero-stars" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i><i></i><i></i><i></i><i></i></div>
    <div class="v2-shell v2-hero-content"><MotionReveal class="v2-hero-message"><p class="v2-eyebrow">AI NETWORKS · RESCUE ROBOTICS · HUMAN COMMAND</p><h1 id="brand-title">The future of yesterday, today.</h1><p class="v2-hero-en">{t('昨日想像的未來，今天由人類指揮。','Yesterday’s imagined future—under human command today.')}</p><p>{t('ELIAS NET 研發人工智慧與機器人，走進工作、生活與救援。AI 幫我們看見更多，人類決定下一步。','ELIAS NET develops AI and robotics for work, daily life and rescue. AI helps us see more; people decide what comes next.')}</p><p class="v2-hero-protocol" aria-label="SENSE, COORDINATE, AUTHORIZE, RESPOND"><span>SENSE</span><i>·</i><span>COORDINATE</span><i>·</i><span>AUTHORIZE</span><i>·</i><span>RESPOND</span></p><div class="v2-actions"><CTA href="#products" label={t('探索產品','Explore products')} locale={locale}/><CTA href="#governance" label={t('了解人與 AI 如何合作','See how people and AI work together')} locale={locale} secondary/><button type="button" class="v2-hero-replay" data-hero-replay>{t('重播動畫','Replay animation')}</button></div></MotionReveal></div>
    <a class="v2-hero-scroll" href="#products" aria-label={t('向下探索產品','Scroll to explore products')}><span>{t('向下探索','EXPLORE')}</span><i aria-hidden="true"></i></a>
  </ScrollScene>

  <ScrollScene id="products" tone="dark" class="v2-products-scene v2-model-architecture" labelledby="products-title"><AmbientLightField variant="teal"/><div class="v2-shell"><div class="v2-model-architecture-head"><MotionReveal><p class="v2-eyebrow">PRODUCT SYSTEMS / {t('產品系統','PRODUCT SYSTEMS')}</p><h2 id="products-title">{t('兩大產品系統，走進工作、生活與救援。','Two product systems for work, daily life and rescue.')}</h2><p>{t('選一個方向，查看產品、型號與真人情境。','Choose a direction, then explore products, models and real-world scenarios.')}</p></MotionReveal><div class="v2-architecture-families"><article data-motion-reveal><span>01</span><p class="v2-eyebrow">DIGITAL INTELLIGENCE</p><h3>{t('線上智慧支援','Digital Intelligence')}</h3><p>{t('協助企業處理知識、客服、流程與營運問題。','Support enterprise knowledge, service, workflows and operations.')}</p><strong>Elias Knowledge · Care · Flow · Ops</strong><a href={`${prefix}digital-intelligence/`}>{t('查看兩條產品線','Explore two product lines')} →</a></article><article data-motion-reveal><span>02</span><p class="v2-eyebrow">AI ROBOTICS</p><h3>{t('人工智慧機器人','AI Robots')}</h3><p>{t('探索居家陪伴、生活協助與專業救援的產品家族及型號。','Explore product families and models for home companionship, daily assistance and professional rescue.')}</p><strong>Elias Home · Rescue</strong><a href={`${prefix}ai-robots/`}>{t('觀看情境與型號','View scenarios and models')} →</a></article></div></div></div></ScrollScene>

  <ScrollScene id="features" tone="dark" class="v2-solutions-scene" labelledby="features-title"><AmbientLightField variant="warm"/><div class="v2-shell"><MotionReveal class="v2-section-head"><p class="v2-eyebrow">AI CAPABILITIES / {t('AI 特性','AI CAPABILITIES')}</p><h2 id="features-title">{t('六種能力，讓智慧真正幫得上忙。','Six capabilities designed to make intelligence useful.')}</h2><p>{t('這些不是六項產品，而是所有 Elias 系統共同發展的能力。','These are not six products. They are capabilities shared across Elias systems.')}</p></MotionReveal><div class="v2-solution-grid">{features.map((feature,index)=><article data-motion-reveal><span>0{index+1}</span><h3>{feature.title}</h3><p>{feature.copy}</p><small>{feature.tag}</small></article>)}</div></div></ScrollScene>

  <ScrollScene id="governance" tone="dark" class="v2-governance-scene v2-cocreation-scene" labelledby="governance-title">
    <MotionPicture class="v2-cocreation-backdrop" desktop={media('images/v2/human-ai-cocreation.webp')} mobile={media('images/v2/human-ai-cocreation.webp')} alt={t('孩子與友善的智慧夥伴同行，工作人員在控制中心持續監督系統','A child walks with a friendly intelligent companion while an operator continues supervising the system')}/>
    <div class="v2-cocreation-shade" aria-hidden="true"></div>
    <div class="v2-shell v2-cocreation-inner">
      <MotionReveal class="v2-cocreation-copy"><p class="v2-eyebrow">HUMAN + AI / {t('人與人工智慧同行','ALONGSIDE EACH OTHER')}</p><h2 id="governance-title">{t('人與人工智慧並肩而行，把未來走得更遠。','People and artificial intelligence, side by side toward a greater future.')}</h2><p>{t('人工智慧幫我們理解環境、留意細節並準備下一步。我們帶著經驗與關心，一起選擇前進的方向。','Artificial intelligence helps us understand our surroundings, notice details and prepare what comes next. We bring experience and care, choosing the direction together.')}</p></MotionReveal>
      <div class="v2-cocreation-principles" aria-label={t('人與人工智慧並肩同行','People and artificial intelligence moving forward side by side')}>
        <article data-motion-reveal><span>AI</span><h3>{t('幫我們看見更多','Helps us see more')}</h3><p>{t('留意容易錯過的需要與線索，讓幫助在適合的時候自然出現。','Notice needs and clues we might miss, so help can appear naturally at the right moment.')}</p></article>
        <article data-motion-reveal><span>HUMAN</span><h3>{t('讓科技懂得關心','Brings care to technology')}</h3><p>{t('我們用經驗與同理心選擇方向，讓每一項能力都回到人的真實需要。','We use experience and empathy to choose the direction, keeping every capability grounded in real human needs.')}</p></article>
        <article data-motion-reveal><span>TOGETHER</span><h3>{t('一起把下一步走好','Takes the next step together')}</h3><p>{t('人工智慧準備協助，我們做出選擇；彼此發揮所長，一起完成更好的結果。','Artificial intelligence prepares support and we make the choice—each contributing what we do best to create a better result.')}</p></article>
      </div>
      <a class="v2-cocreation-link" href={`${prefix}safety/`}>{t('了解人與 AI 的合作方式','See how people and AI work together')} →</a>
    </div>
  </ScrollScene>

  <ScrollScene id="collaboration" tone="dark" class="v2-collaboration-scene" labelledby="collaboration-title"><AmbientLightField variant="violet" density="quiet"/><div class="v2-shell"><div class="v2-collaboration-intro"><MotionReveal><p class="v2-eyebrow">COLLABORATION / {t('合作方式','HOW TO WORK WITH US')}</p><h2 id="collaboration-title">{t('選一個方向，或告訴我們你的需求。','Choose a direction—or tell us what you need.')}</h2><p>{t('先從小範圍開始，確認有幫助，再決定下一步。','Start small, confirm the value, then choose what comes next.')}</p></MotionReveal><div class="v2-actions"><CTA href={`${prefix}contact/`} label={t('洽談合作','Talk with us')} locale={locale}/><CTA href={`${prefix}digital-intelligence/`} label={t('查看兩條線上產品線','View digital product lines')} locale={locale} secondary/></div></div><div class="v2-collaboration-offers"><article><span>01</span><p class="v2-eyebrow">{t('企業 AI 產品','ENTERPRISE AI PRODUCTS')}</p><h3>Elias Knowledge · Care · Flow · Ops</h3><p>{t('從知識、客服、流程或維運中，選一個問題開始。','Start with one problem in knowledge, service, workflows or operations.')}</p><a href={`${prefix}digital-intelligence/`}>{t('查看兩條產品線','View two product lines')} →</a></article><article><span>02</span><p class="v2-eyebrow">{t('人工智慧機器人','AI ROBOTICS')}</p><h3>Elias Home · Elias Rescue</h3><p>{t('探索居家協助與專業救援的產品和概念型號。','Explore products and concept models for home assistance and professional rescue.')}</p><a href={`${prefix}ai-robots/`}>{t('查看機器人與型號','View robots and models')} →</a></article><article><span>03</span><p class="v2-eyebrow">{t('從問題開始','START WITH A PROBLEM')}</p><h3>{t('還不確定從哪裡開始？','Not sure where to begin?')}</h3><p>{t('告訴我們想改善什麼，一起找出適合的起點。','Tell us what you want to improve and we will find a practical starting point.')}</p><a href={`${prefix}contact/`}>{t('告訴我們你的需求','Tell us what you need')} →</a></article></div></div></ScrollScene>
</MotionProvider>

<script>
  const reduceHeroMotion = matchMedia('(prefers-reduced-motion: reduce)');
  const hero = document.querySelector<HTMLElement>('#brand');
  const replay = hero?.querySelector<HTMLButtonElement>('[data-hero-replay]');
  const playHero = () => {
    if (!hero || reduceHeroMotion.matches) return;
    hero.classList.remove('is-hero-playing');
    void hero.offsetWidth;
    hero.classList.add('is-hero-playing');
    hero.dataset.heroState = 'playing';
    window.setTimeout(() => { if (hero.dataset.heroState === 'playing') hero.dataset.heroState = 'complete'; }, 8200);
  };
  replay?.addEventListener('click', playHero);
  if (hero) {
    if (reduceHeroMotion.matches) hero.dataset.heroState = 'complete';
    else requestAnimationFrame(playHero);
    const heroObserver = new IntersectionObserver(([entry]) => {
      const animations = typeof hero.getAnimations === 'function' ? hero.getAnimations({ subtree:true }) : [];
      animations.forEach((animation) => entry?.isIntersecting ? animation.play() : animation.pause());
    }, { threshold:.05 });
    heroObserver.observe(hero);
  }
</script>
