---
import type { SiteLocale } from '../../data/products';
import { simplify } from '../../data/simplified-map';
import AnimatedBrandMark from './AnimatedBrandMark.astro';
interface Props { locale: SiteLocale; compact?: boolean }
const { locale, compact = false } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const lang = locale === 'en' ? 'en/' : locale === 'zh-CN' ? 'zh-cn/' : '';
const root = `${base}/${lang}`.replace(/([^:]\/)\/+/, '$1');
const t=(zh:string,en:string)=>locale==='en'?en:locale==='zh-CN'?simplify(zh):zh;
const talentRoles = locale === 'en'
  ? ['AI Engineer','Application Software Engineer','Operations Engineer','Data & Blockchain Engineer','Product & UX Design']
  : locale === 'zh-CN'
    ? ['AI 工程师','应用软件工程师','运维工程师','数据与区块链工程师','产品与 UX 设计']
    : ['AI 工程師','應用軟體工程師','維運工程師','資料與區塊鏈工程師','產品與 UX 設計'];
---
<footer class="v2-footer">
  <div class="v2-shell v2-footer-grid is-expanded">
    <section class="v2-footer-brand" aria-label="Elias Net">
      <div class="v2-footer-lockup"><AnimatedBrandMark variant="icon" id="footer" animated={false}/><strong>ELIAS NET</strong></div>
      <p>{t('昨日的想像，今日的實現。','Imagined yesterday. Built for today.')}</p>
      <small>IMAGINED YESTERDAY. BUILT FOR TODAY.</small>
    </section>
    <nav class="v2-footer-column" aria-label={t('產品導覽','Product navigation')}>
      <h2>SERVICES</h2>
      <a href={`${root}digital-intelligence/`}>{t('AI 應用與協作','AI Applications & Collaboration')}</a>
      <a href={`${root}enterprise-digital-solutions/`}>{t('企業數位服務','Enterprise Digital Services')}</a>
      <a href={`${root}services/elias-build/`}>Elias Build · {t('應用軟體開發與維護','Application Development & Maintenance')}</a>
      <a href={`${root}services/elias-data/`}>Elias Data · {t('資料整合與效能優化','Data Integration & Performance')}</a>
      <a href={`${root}services/elias-chain/`}>Elias Chain · {t('區塊鏈與數位資產應用','Blockchain & Digital Assets')}</a>
    </nav>
    <nav class="v2-footer-column" aria-label={t('開發與整合','Developer and integration navigation')}>
      <h2>DEVELOPERS</h2>
      <a href={`${root}api/`}>API</a>
      <a href={`${root}docs/`}>{t('AI 整合文件','AI Integration Documentation')}</a>
      <a href={`${root}pricing/`}>{t('合作方案','Plans')}</a>
    </nav>
    <nav class="v2-footer-column" aria-label={t('公司導覽','Company navigation')}>
      <h2>COMPANY</h2>
      <a href={`${root}company/`}>{t('關於 Elias Net','About Elias Net')}</a>
      <a href={`${root}technology/`}>{t('技術方向','Technology')}</a>
      <a href={`${root}safety/`}>{t('信任與選擇','Trust & Choice')}</a>
      <a href={`${root}research/`}>{t('研發進度','Research')}</a>
    </nav>
    <nav class="v2-footer-column is-talent" aria-label={t('人才招募','Careers')}>
      <h2>TALENT / {t('人才招募','CAREERS')}</h2>
      {compact
        ? <><a href={`${root}careers/`}>{t('職務與所需能力','Roles and skills')}</a><a href={`${root}contact/`}>{t('合作與聯絡','Collaboration and contact')}</a></>
        : <>{talentRoles.map((role,index) => <a href={`${root}careers/#${['ai-engineer','application-engineer','operations-engineer','data-blockchain-engineer','product-ux-designer'][index]}`} aria-label={t(`了解 ${role} 所需能力與合作機會`,`Explore ${role} skills and opportunities`)}>{role}</a>)}<a href={`${root}careers/`}>{t('查看人才招募頁','View all roles')}</a></>}
      <small>{t('職務與合作形式依團隊規劃確認。','Roles and engagement models follow current team plans.')}</small>
    </nav>
    <section class="v2-footer-statement">
      <h2>{compact?t('產品狀態','PRODUCT STATUS'):'ELIAS NET'}</h2>
      {!compact&&<p>{t('我們以人工智慧、應用軟體與資料整合，協助組織把資訊變成可持續運作的服務。服務範圍依實際需求與驗證進度確認。','We use AI, application software and data integration to turn information into services designed for lasting operations. Scope follows real needs and validation progress.')}</p>}
      <p>{t('概念與原型不代表已量產、部署或可立即提供。','Concepts and prototypes do not imply production, deployment or immediate availability.')}</p>
    </section>
  </div>
  <div class="v2-shell v2-footer-bottom"><small>© 2026 Elias Net</small><span>INTELLIGENCE ALONGSIDE HUMANITY</span></div>
</footer>
