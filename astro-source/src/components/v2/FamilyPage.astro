---
import type { ProductDefinition, SiteLocale } from '../../data/products';
import { simplify } from '../../data/simplified-map';
import { getFamilyProducts } from '../../data/products';
import ProductCard from './ProductCard.astro';
import SafetyNotice from './SafetyNotice.astro';
import CTA from './CTA.astro';
interface Props { locale: SiteLocale; family: ProductDefinition['family'] }
const { locale, family } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/,''); const prefix = locale === 'en' ? `${base}/en/` : locale === 'zh-CN' ? `${base}/zh-cn/` : `${base}/`;
const t=(zh:string,en:string)=>locale==='en'?en:locale==='zh-CN'?simplify(zh):zh; const digital=family==='digital'; const list=getFamilyProducts(family);
---
<section class="v2-page-hero"><div class="v2-shell v2-reveal"><p class="v2-eyebrow">{digital?'DIGITAL INTELLIGENCE':'AI ROBOTICS'}</p><h1>{digital?t('讓工作資訊更清楚，事情更快往前走。','Clearer information. Smoother work.'):t('讓智慧走進生活，也走進需要幫助的現場。','Intelligence for daily life and the moments that need help most.')}</h1><p>{digital?t('從找資料、回覆客戶，到流程與系統異常。人工智慧先整理重點，我們再決定下一步。','From finding information to serving customers and handling operations, AI organizes what matters so people can choose what comes next.'):t('Elias Home 陪伴日常生活；Elias Rescue 支援危險現場。兩個方向都從人的需要出發，目前仍在概念研究階段。','Elias Home supports daily life. Elias Rescue supports dangerous environments. Both begin with human needs and remain research concepts.')}</p></div></section>
<section class="v2-section"><div class="v2-shell"><div class="v2-product-grid">{list.map((product)=><ProductCard product={product} locale={locale} basePath={prefix}/>)}</div></div></section>
<section class="v2-section v2-tint"><div class="v2-shell v2-split v2-reveal"><div><p class="v2-eyebrow">{t('一起工作的方式','HOW WE WORK TOGETHER')}</p><h2>{digital?t('人工智慧先準備，我們決定下一步。','AI prepares. People decide what comes next.'):t('人工智慧先感知，我們決定如何行動。','AI senses. People decide how to act.')}</h2></div><p>{digital?t('資料來源看得見，重要步驟由我們確認，完成後留下清楚紀錄。','Sources stay visible, people review important steps and every completed action leaves a clear record.'):t('每個任務都有清楚範圍、停止方式與負責的人。我們正從概念研究開始，逐步驗證安全、互動與實際用途。','Every task has a clear scope, a way to stop and a person in charge. We are beginning with concept research and progressively validating safety, interaction and real-world value.')}</p></div></section>
<section class="v2-section"><div class="v2-shell"><SafetyNotice locale={locale}><ul class="v2-check-list"><li>{digital?t('資料來源與角色權限必須先核准','Data sources and role permissions require approval'):t('Home 重視隱私、自主與實體急停','Home prioritizes privacy, autonomy and physical emergency stop')}</li><li>{digital?t('高影響更新停在指定人員確認','High-impact updates stop for designated review'):t('Rescue 採遠端優先、失聯安全與非武器化','Rescue is remote-first, fail-safe and non-weaponized')}</li><li>{t('所有能力依真實證據標示狀態','Every capability carries an evidence-based status')}</li></ul></SafetyNotice><div class="v2-inline-cta"><CTA href={`${prefix}contact/`} label={digital?t('討論合作可能','Discuss collaboration possibilities'):t('了解研發方向','Explore the research direction')} locale={locale}/></div></div></section>
