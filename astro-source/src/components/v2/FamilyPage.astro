---
import type { ProductDefinition, SiteLocale } from '../../data/products';
import { simplify } from '../../data/simplified-map';
import { getFamilyProducts } from '../../data/products';
import ProductCard from './ProductCard.astro';
import SafetyNotice from './SafetyNotice.astro';
import CTA from './CTA.astro';
import PageHeroVisual from './PageHeroVisual.astro';
interface Props { locale: SiteLocale; family: ProductDefinition['family']; digitalLine?: 'knowledge-service' | 'operations-workflow' }
const { locale, family, digitalLine } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/,''); const prefix = locale === 'en' ? `${base}/en/` : locale === 'zh-CN' ? `${base}/zh-cn/` : `${base}/`;
const t=(zh:string,en:string)=>locale==='en'?en:locale==='zh-CN'?simplify(zh):zh; const digital=family==='digital'; const list=getFamilyProducts(family);
const knowledgeProducts=list.filter((product)=>['elias-knowledge','elias-care'].includes(product.slug));
const operationsProducts=list.filter((product)=>['elias-flow','elias-ops'].includes(product.slug));
const lineProducts=digitalLine==='knowledge-service'?knowledgeProducts:digitalLine==='operations-workflow'?operationsProducts:[];
const lineTitle=digitalLine==='knowledge-service'?t('知識與客服','Knowledge & Service'):t('系統與流程','Systems & Workflow');
const lineHeadline=digitalLine==='knowledge-service'?t('更快找到答案，更懂每一次需求。','Find answers faster. Understand every need.'):t('流程看得清楚，工作走得更順。','Clearer workflows. Smoother work.');
const lineIntro=digitalLine==='knowledge-service'?t('Elias Knowledge 整理公司知識；Elias Care 協助客服理解需求。','Elias Knowledge organizes company knowledge. Elias Care helps service teams understand requests.'):t('Elias Flow 整理工作流程；Elias System 協助團隊看懂系統異常。','Elias Flow organizes workflows. Elias System helps teams understand system issues.');
---
<section class="v2-page-hero"><div class="v2-shell v2-page-hero-grid"><div class="v2-reveal"><p class="v2-eyebrow">{digitalLine?`DIGITAL INTELLIGENCE / ${digitalLine==='knowledge-service'?'KNOWLEDGE + SERVICE':'SYSTEMS + WORKFLOW'}`:digital?'DIGITAL INTELLIGENCE':'AI ROBOTICS'}</p><h1>{digitalLine?lineHeadline:digital?t('兩條產品線，找到適合的智慧協助。','Two product lines. One clear place to begin.'):t('讓智慧走進生活，也走進需要幫助的現場。','Intelligence for daily life and the moments that need help most.')}</h1><p>{digitalLine?lineIntro:digital?t('選擇知識與客服，或系統與流程。','Choose Knowledge & Service or Systems & Workflow.'):t('Elias Home 陪伴日常生活；Elias Rescue 支援危險現場。兩個方向都從人的需要出發，目前仍在概念研究階段。','Elias Home supports daily life. Elias Rescue supports dangerous environments. Both begin with human needs and remain research concepts.')}</p></div><PageHeroVisual pageKey={digitalLine??(digital?'digital-intelligence':'ai-robots')} alt={digital?t('工作人員與人工智慧共同整理營運資訊','A professional and artificial intelligence organizing operational information together'):t('人與友善的人工智慧機器人並肩同行','A person moving forward beside a friendly AI robot')}/></div></section>
{digital && !digitalLine ? <section class="v2-section v2-digital-line-index"><div class="v2-shell"><div class="v2-line-index-grid">
  <a href={`${prefix}digital-intelligence/knowledge-service/`}><div class="v2-line-icon is-knowledge" aria-hidden="true"><svg viewBox="0 0 64 64"><path d="M14 12h27a5 5 0 0 1 5 5v30H19a5 5 0 0 0-5 5V12Z"/><path d="M20 21h18M20 29h14M20 37h10"/><circle cx="47" cy="45" r="9"/><path d="m53 51 6 6"/></svg></div><p class="v2-eyebrow">KNOWLEDGE + SERVICE</p><h2>{t('知識與客服','Knowledge & Service')}</h2><p>{t('可靠知識更容易找到，客戶需求更快被理解。','Reliable knowledge is easier to find and customer needs are understood faster.')}</p><span>{t('查看產品線','Explore this product line')} →</span></a>
  <a href={`${prefix}digital-intelligence/operations-workflow/`}><div class="v2-line-icon is-operations" aria-hidden="true"><svg viewBox="0 0 64 64"><circle cx="13" cy="21" r="5"/><circle cx="51" cy="16" r="5"/><circle cx="48" cy="48" r="5"/><path d="M18 21h12l7-5h9M13 26v13l9 9h21M28 34h17M36 28l8 6-8 6"/></svg></div><p class="v2-eyebrow">SYSTEMS + WORKFLOW</p><h2>{t('系統與流程','Systems & Workflow')}</h2><p>{t('看清工作進度與系統異常，下一步更明確。','See progress and system issues clearly, with a clearer next step.')}</p><span>{t('查看產品線','Explore this product line')} →</span></a>
</div></div></section> : digitalLine ? <section class="v2-section v2-digital-lines"><div class="v2-shell">
  <section class="v2-digital-line v2-reveal">
    <header><div class:list={['v2-line-icon',digitalLine==='knowledge-service'?'is-knowledge':'is-operations']} aria-hidden="true">{digitalLine==='knowledge-service'?<svg viewBox="0 0 64 64"><path d="M14 12h27a5 5 0 0 1 5 5v30H19a5 5 0 0 0-5 5V12Z"/><path d="M20 21h18M20 29h14M20 37h10"/><circle cx="47" cy="45" r="9"/><path d="m53 51 6 6"/></svg>:<svg viewBox="0 0 64 64"><circle cx="13" cy="21" r="5"/><circle cx="51" cy="16" r="5"/><circle cx="48" cy="48" r="5"/><path d="M18 21h12l7-5h9M13 26v13l9 9h21M28 34h17M36 28l8 6-8 6"/></svg>}</div><div><p class="v2-eyebrow">{digitalLine==='knowledge-service'?'KNOWLEDGE + SERVICE':'SYSTEMS + WORKFLOW'}</p><h2>{lineTitle}</h2><p>{lineIntro}</p></div></header>
    <div class="v2-product-grid">{lineProducts.map((product)=><ProductCard product={product} locale={locale} basePath={prefix}/>)}</div>
  </section>
</div></section> : <section class="v2-section"><div class="v2-shell"><div class="v2-product-grid">{list.map((product)=><ProductCard product={product} locale={locale} basePath={prefix}/>)}</div></div></section>}
<section class="v2-section v2-tint"><div class="v2-shell v2-split v2-reveal"><div><p class="v2-eyebrow">{t('如何一起工作','HOW WE WORK TOGETHER')}</p><h2>{digital?t('AI 先準備，我們決定下一步。','AI prepares. People decide what comes next.'):t('AI 先感知，我們決定如何行動。','AI senses. People decide how to act.')}</h2></div><p>{digital?t('看得到資料來源，重要步驟由人確認，完成後留下紀錄。','Sources stay visible, people confirm important steps and completed work leaves a record.'):t('每個任務都有清楚範圍、停止方式與負責人。我們會逐步測試安全、互動與實際用途。','Every task has a clear scope, a way to stop and a person in charge. We test safety, interaction and real-world value step by step.')}</p></div></section>
<section class="v2-section"><div class="v2-shell"><SafetyNotice locale={locale}><ul class="v2-check-list"><li>{digital?t('先確認可用資料與使用權限','Confirm approved data and access first'):t('Home 重視隱私、自主與實體急停','Home prioritizes privacy, autonomy and physical emergency stop')}</li><li>{digital?t('重要操作先由負責人確認','Important actions require responsible review'):t('Rescue 採遠端優先、失聯安全與非武器化','Rescue is remote-first, fail-safe and non-weaponized')}</li><li>{t('研發進度以實際測試為準','Research progress follows real testing')}</li></ul></SafetyNotice><div class="v2-inline-cta"><CTA href={`${prefix}contact/`} label={digital?t('洽談合作','Talk with us'):t('查看研發方向','Explore the research direction')} locale={locale}/></div></div></section>
