---
import type { SiteLocale } from '../../data/products'; import { products, l } from '../../data/products'; import { enterpriseServices, enterpriseServiceSlugs } from '../../data/enterprise-services'; import ProductStatus from './ProductStatus.astro'; import SafetyNotice from './SafetyNotice.astro'; import CTA from './CTA.astro'; import PageHeroVisual from './PageHeroVisual.astro';
import { simplify } from '../../data/simplified-map';
interface Props { locale: SiteLocale; page: 'technology'|'safety'|'research'|'about'|'contact' }
const { locale,page }=Astro.props; const base=import.meta.env.BASE_URL.replace(/\/$/,''); const prefix=locale==='en'?`${base}/en/`:locale==='zh-CN'?`${base}/zh-cn/`:`${base}/`; const t=(zh:string,en:string)=>locale==='en'?en:locale==='zh-CN'?simplify(zh):zh;
const data={
  technology:{eyebrow:t('技術方向','TECHNOLOGY'),title:t('讓 AI 看懂資訊，也學會與人合作。','AI that understands information and learns to work with people.'),intro:t('這是 Elias Net 的 AI 技術方向：理解資訊、支援協作、感知環境與受控行動；各項能力依產品與驗證階段導入。','These are Elias Net’s AI technology directions: understanding information, supporting collaboration, perceiving environments and acting under control. Capabilities are introduced according to product and validation stage.')},
 safety:{eyebrow:t('信任與選擇','TRUST & CHOICE'),title:t('清楚理解，始終保有選擇。','Stay informed. Stay in control.'),intro:t('資料範圍清楚、提示容易理解，也能依服務與產品階段規劃停止或調整方式。信任是每次合作的起點。','Clear data boundaries, understandable guidance, and stop or adjustment controls designed for each service and product stage. Trust is where every engagement begins.')},
 research:{eyebrow:t('研發進度','RESEARCH PROGRESS'),title:t('做到哪裡，就誠實說到哪裡。','We say clearly how far each idea has come.'),intro:t('概念、原型與測試是不同階段。我們只依現有證據標示進度，不把想像說成已經完成。','Concepts, prototypes and tests are different stages. We label progress from evidence and never present an idea as a finished product.')},
 about:{eyebrow:t('關於我們','ABOUT ELIAS NET'),title:t('讓智慧與人同行，走向更好的未來。','Intelligence alongside humanity, for a better future.'),intro:t('Elias Net 研發人工智慧與機器人，讓科技自然走進工作、生活與真實世界。','Elias Net develops AI and robotics that fit naturally into work, daily life and the real world.')},
 contact:{eyebrow:t('合作與聯絡','COLLABORATION'),title:t('從一個想改善的問題開始。','Start with something you want to improve.'),intro:t('告訴我們哪裡卡住了，或你希望科技幫上什麼忙。我們會一起找出適合的起點。','Tell us what is getting in the way or where technology could help. We will find a practical starting point together.')}
}[page];
---
<section class="v2-page-hero"><div class="v2-shell v2-page-hero-grid"><div class="v2-reveal"><p class="v2-eyebrow">{data.eyebrow}</p><h1>{data.title}</h1><p>{data.intro}</p>{page==='contact'&&<div class="v2-actions"><CTA href="mailto:natsuki12089212@gmail.com?subject=Elias%20Net%20collaboration" label={t('開始交流','Start a conversation')} locale={locale}/></div>}</div><PageHeroVisual pageKey={page} alt={t('人與人工智慧共同理解資訊、討論方向並準備下一步','People and artificial intelligence understanding information and preparing the next step together')}/></div></section>
{page==='technology' && <><section class="v2-section"><div class="v2-shell v2-four-grid">{[
 [t('理解','Understand'),t('從核准資料與環境訊號建立可查證的脈絡。','Build verifiable context from approved data and environmental signals.'),t('資料索引、模型選擇、來源與版本','Data indexing, model selection, sources and versions')],
 [t('協作','Collaborate'),t('把建議、停止點與人員確認放進工作。','Place suggestions, stop points and human review inside the work.'),t('Agent、工作流、API、介面狀態','Agents, workflows, APIs and interface states')],
 [t('感知','Perceive'),t('透過感測器理解環境，並顯示不確定性。','Use sensors to understand environments and expose uncertainty.'),t('感測融合、空間定位、資料品質','Sensor fusion, localization and data quality')],
 [t('行動','Act'),t('只在明確任務、權限與安全界線內準備或執行。','Prepare or act only within explicit tasks, permissions and safety boundaries.'),t('遠端控制、執行預覽、急停與回復','Remote control, execution preview, emergency stop and recovery')]
].map(([title,plain,deep])=><article class="v2-value-card v2-reveal"><h2>{title}</h2><p>{plain}</p><details><summary>{t('技術層','Technical layer')}</summary><p>{deep}</p></details></article>)}</div></section></>}
{page==='safety' && <section class="v2-section"><div class="v2-shell"><SafetyNotice locale={locale}><div class="v2-three-grid">{[
 [t('最小權限','Least privilege'),t('資料、工具、空間與時間只開放完成任務所需範圍。','Data, tools, space and time are limited to what the task requires.')],
 [t('人工確認','Human review'),t('敏感內容、高影響更新與救援決定，都由指定人員確認。','Designated people review sensitive content, high-impact updates and rescue decisions.')],
 [t('停止與回復','Stop and recovery'),t('依服務與產品階段納入暫停、撤回、急停、失聯處理與必要紀錄。','Pause, rollback, emergency stop, communications-loss handling and records are introduced according to each service and product stage.')]
].map(([title,copy])=><article><h3>{title}</h3><p>{copy}</p></article>)}</div></SafetyNotice><section class="v2-prose"><h2>{t('清楚說明限制','Clear about limitations')}</h2><p>{t('系統可能遺漏、誤解，也可能受到感測器或連線影響。各服務與產品頁依實際研究與驗證狀態，說明目前限制與進度。','Systems can miss or misunderstand information and may be affected by sensors or connectivity. Service and product pages describe current limitations and progress according to actual research and validation status.')}</p></section></div></section>}
{page==='research' && <section class="v2-section"><div class="v2-shell"><p class="v2-research-scope">{t('以下為目前內部研發階段說明，不代表已完成第三方驗證、量產或正式部署。','These labels describe current internal research stages and do not imply third-party validation, production readiness or deployment.')}</p><div class="v2-research-table">{products.map((product)=><article><div><h2>{product.name}</h2><span>{locale === 'en' ? product.subtitleEn : locale === 'zh-CN' ? simplify(product.chineseName) : product.chineseName}</span></div><ProductStatus status={product.status} locale={locale} note={l(product.statusNote,locale)}/><p>{l(product.statusNote,locale)}</p><strong>{t('下一步：','Next: ')}{l(product.next,locale)}</strong></article>)}</div><section class="v2-research-services"><header><p class="v2-eyebrow">ENTERPRISE DIGITAL SERVICES</p><h2>{t('企業數位服務的提供方式','How enterprise digital services are delivered')}</h2><p>{t('Build、Data 與 Chain 為專案型服務，不使用概念或原型標籤判斷成熟度；實際內容依需求、環境、風險與驗收條件確認。','Build, Data and Chain are project-based services rather than products classified by concept or prototype stage. Scope follows requirements, environment, risk and acceptance criteria.')}</p></header><div>{enterpriseServiceSlugs.map((slug)=><article><h3>{enterpriseServices[slug].name}</h3><span>{locale==='en'?enterpriseServices[slug].label.en:locale==='zh-CN'?simplify(enterpriseServices[slug].label.zh):enterpriseServices[slug].label.zh}</span><p>{t('專案型服務｜範圍依需求與驗收確認','Project-based service | Scope follows requirements and acceptance')}</p><a href={`${prefix}services/${slug}/`}>{t('查看服務內容','Explore service')} →</a></article>)}</div></section></div></section>}
{page==='about' && <section class="v2-section"><div class="v2-shell v2-two-grid"><article class="v2-prose"><p class="v2-eyebrow">{t('公司使命','MISSION')}</p><h2>{t('研發能理解、學習並與人協作的智慧系統。','Develop intelligent systems that understand, learn and collaborate with people.')}</h2><p>{t('我們從企業工作中的真實問題出發，也探索智慧系統如何在家庭與高風險環境中安全運作。','We begin with real enterprise work problems and explore how intelligent systems can operate safely in homes and high-risk environments.')}</p></article><article class="v2-prose"><p class="v2-eyebrow">{t('工作原則','WORKING PRINCIPLES')}</p><ul class="v2-check-list"><li>{t('先說價值，再說技術','Explain value before technology')}</li><li>{t('先界定權限，再讓系統行動','Define permissions before action')}</li><li>{t('用證據標示研發狀態','Use evidence to label status')}</li><li>{t('不以 AI 取代人的責任','Do not use AI to replace human responsibility')}</li></ul></article></div></section>}
{page==='contact' && <section class="v2-section"><div class="v2-shell v2-two-grid"><article class="v2-prose"><h2>{t('適合帶來的內容','What to bring')}</h2><ul class="v2-check-list"><li>{t('一個需要改善的工作問題','A work problem that needs improvement')}</li><li>{t('一個需要驗證的研究題目','A research question to validate')}</li><li>{t('一個具體的使用情境與限制','A concrete scenario and its constraints')}</li></ul></article><article class="v2-prose"><h2>{t('第一次交流會確認','What the first conversation covers')}</h2><ul class="v2-check-list"><li>{t('誰會使用、現在怎麼工作','Who will use it and how work happens today')}</li><li>{t('可使用的資料或環境範圍','Available data or environmental scope')}</li><li>{t('重要風險、停止點與成功條件','Key risks, stop points and success criteria')}</li></ul></article></div><div class="v2-shell"><nav class="v2-contact-options" aria-label={t('選擇合作方式','Choose how to begin')}><h2>{t('選擇適合你的開始方式','Choose the right way to begin')}</h2><div>{[
 [t('討論 AI 應用','Discuss an AI application'),'ai-application'],
 [t('討論軟體開發','Discuss software development'),'software-development'],
 [t('討論資料整合','Discuss data integration'),'data-integration'],
 [t('討論區塊鏈應用','Discuss a blockchain application'),'blockchain-application'],
 [t('其他合作','Other collaboration'),'other-collaboration'],
 [t('人才交流','Talent conversations'),'talent']
].map(([label,subject])=><a href={`mailto:natsuki12089212@gmail.com?subject=Elias%20Net%20${subject}`}>{label}<span aria-hidden="true">→</span></a>)}</div></nav></div></section>}
{page!=='contact' && <section class="v2-section v2-contact"><div class="v2-shell v2-contact-inner"><h2>{t('想進一步了解？','Want to explore further?')}</h2><CTA href={`${prefix}contact/`} label={t('洽談合作','Talk with us')} locale={locale}/></div></section>}
