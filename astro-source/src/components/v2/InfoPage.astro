---
import type { SiteLocale } from '../../data/products'; import { products, l } from '../../data/products'; import { enterpriseServices, enterpriseServiceSlugs } from '../../data/enterprise-services'; import ProductStatus from './ProductStatus.astro'; import SafetyNotice from './SafetyNotice.astro'; import CTA from './CTA.astro'; import PageHeroVisual from './PageHeroVisual.astro'; import ContactInquiryForm from './ContactInquiryForm.astro';
import { simplify } from '../../data/simplified-map';
interface Props { locale: SiteLocale; page: 'technology'|'safety'|'research'|'about'|'contact' }
const { locale,page }=Astro.props; const base=import.meta.env.BASE_URL.replace(/\/$/,''); const prefix=locale==='en'?`${base}/en/`:locale==='zh-CN'?`${base}/zh-cn/`:`${base}/`; const t=(zh:string,en:string)=>locale==='en'?en:locale==='zh-CN'?simplify(zh):zh;
const data={
  technology:{eyebrow:t('技術能力','CAPABILITIES'),title:t('讓公司資料能被搜尋、整理，並接進現有工作流程。','Search and organize company data, then connect it to existing workflows.'),intro:t('Elias Net 將資料理解、人機協作、環境感知與受控行動，應用在不同產品與服務中。','Elias Net applies data understanding, human-AI collaboration, environmental perception and controlled action across its products and services.')},
 safety:{eyebrow:t('控制機制','CONTROL MECHANISMS'),title:t('看得到資料來源，也能隨時停止或交由人處理。','See the source. Stop the system. Hand control to a person.'),intro:t('資料來源、操作權限與停止方式，都應在使用前被看見；敏感內容與高影響操作由指定人員核准。','Sources, permissions and stop controls should be visible before use. Designated people approve sensitive content and high-impact actions.')},
 research:{eyebrow:t('服務狀態','SERVICE STATUS'),title:t('哪些能直接導入，哪些需要配置或開發。','What is ready to adopt, configure or develop.'),intro:t('本頁分開標示可直接採用、需要配置，以及仍待驗證的項目；功能與驗收條件以實際合作範圍為準。','This page separates ready-to-adopt capabilities, configurable work and items still being validated. Functions and acceptance criteria follow the agreed scope.')},
 about:{eyebrow:t('關於我們','ABOUT ELIAS NET'),title:t('讓智慧有用，讓服務可靠。','Useful intelligence. Reliable delivery.'),intro:t('Elias Net 結合 AI、應用軟體與資料整合，協助組織把複雜資訊轉化為可持續運作的數位服務。','Elias Net combines AI, application software and data integration to turn complex information into digital services designed for lasting operations.')},
 contact:{eyebrow:t('需求摘要','INQUIRY BRIEF'),title:t('說明目前卡住的工作，以及希望改善的結果。','Describe the work that is stuck and the result you need.'),intro:t('填入現況、系統與限制，頁面會在你的裝置上整理成可複製的需求摘要，不會上傳資料。','Add the current process, systems and constraints. The page creates a copyable brief on your device without uploading the data.')},
}[page];
---
<section class:list={['v2-page-hero',`is-${page}`]}><div class="v2-shell v2-page-hero-grid"><div class="v2-reveal"><p class="v2-eyebrow">{data.eyebrow}</p><h1>{data.title}</h1><p>{data.intro}</p>{page==='contact'&&<div class="v2-actions"><CTA href="#contact-form" label={t('整理需求摘要','Prepare an inquiry brief')} locale={locale}/></div>}</div><PageHeroVisual pageKey={page} alt={t('人與人工智慧共同理解資訊、討論方向並準備下一步','People and artificial intelligence understanding information and preparing the next step together')}/></div></section>
{page==='technology' && <><section class="v2-section"><div class="v2-shell v2-four-grid">{[
 [t('理解','Understand'),t('從核准資料與環境訊號建立可查證的脈絡。','Build verifiable context from approved data and environmental signals.'),t('資料索引、模型選擇、來源與版本','Data indexing, model selection, sources and versions')],
 [t('協作','Collaborate'),t('把建議、停止點與人員確認放進工作。','Place suggestions, stop points and human review inside the work.'),t('Agent、工作流、API、介面狀態','Agents, workflows, APIs and interface states')],
 [t('感知','Perceive'),t('透過感測器理解環境，並顯示不確定性。','Use sensors to understand environments and expose uncertainty.'),t('感測融合、空間定位、資料品質','Sensor fusion, localization and data quality')],
 [t('行動','Act'),t('只在明確任務、權限與安全界線內準備或執行。','Prepare or act only within explicit tasks, permissions and safety boundaries.'),t('遠端控制、執行預覽、急停與回復','Remote control, execution preview, emergency stop and recovery')]
].map(([title,plain,deep])=><article class="v2-value-card v2-reveal"><h2>{title}</h2><p>{plain}</p><details><summary>{t('技術層','Technical layer')}</summary><p>{deep}</p></details></article>)}</div></section></>}
{page==='safety' && <section class="v2-section"><div class="v2-shell"><SafetyNotice locale={locale}><div class="v2-three-grid">{[
 [t('最小權限','Least privilege'),t('資料、工具、空間與時間只開放完成任務所需範圍。','Data, tools, space and time are limited to what the task requires.')],
 [t('人工確認','Human review'),t('敏感資料的使用、重要資料更新與關鍵操作，都須經指定人員確認。','Designated people must approve the use of sensitive data, important data updates and critical operations.')],
 [t('停止與回復','Stop and recovery'),t('依服務與產品階段納入暫停、撤回、急停、失聯處理與必要紀錄。','Pause, rollback, emergency stop, communications-loss handling and records are introduced according to each service and product stage.')]
].map(([title,copy])=><article><h3>{title}</h3><p>{copy}</p></article>)}</div></SafetyNotice><section class="v2-prose"><h2>{t('清楚說明限制','Clear about limitations')}</h2><p>{t('系統可能遺漏、誤解，也可能受到感測器或連線影響。各服務與產品頁依實際研究與驗證狀態，說明目前限制與進度。','Systems can miss or misunderstand information and may be affected by sensors or connectivity. Service and product pages describe current limitations and progress according to actual research and validation status.')}</p></section></div></section>}
{page==='research' && <section class="v2-section"><div class="v2-shell"><p class="v2-research-scope">{t('服務可採直接導入、配置導入或客製整合；實際功能、部署方式與驗收條件依合作範圍確認。','Services support direct adoption, configured deployment or custom integration. Functions, deployment and acceptance criteria follow the agreed scope.')}</p><div class="v2-research-table">{products.filter((product)=>product.family==='digital').map((product)=><article><div><h2>{product.name}</h2><span>{locale === 'en' ? product.subtitleEn : locale === 'zh-CN' ? simplify(product.chineseName) : product.chineseName}</span></div><ProductStatus status={product.status} locale={locale} note={l(product.statusNote,locale)}/><p>{l(product.statusNote,locale)}</p><strong>{t('導入確認：','Adoption review: ')}{l(product.next,locale)}</strong></article>)}</div><section class="v2-research-services"><header><p class="v2-eyebrow">ENTERPRISE DIGITAL SERVICES</p><h2>{t('企業數位服務的提供方式','How enterprise digital services are delivered')}</h2><p>{t('Build、Data 與 Chain 依需求、環境、風險與驗收條件，採配置導入或客製整合。','Build, Data and Chain use configured deployment or custom integration based on requirements, environment, risk and acceptance criteria.')}</p></header><div>{enterpriseServiceSlugs.map((slug)=><article><h3>{enterpriseServices[slug].name}</h3><span>{locale==='en'?enterpriseServices[slug].label.en:locale==='zh-CN'?simplify(enterpriseServices[slug].label.zh):enterpriseServices[slug].label.zh}</span><p>{t('配置導入或客製整合｜範圍依需求與驗收確認','Configured deployment or custom integration | Scope follows requirements and acceptance')}</p><a href={`${prefix}services/${slug}/`}>{t('查看服務內容','Explore service')} →</a></article>)}</div></section></div></section>}
{page==='about' && <section class="v2-section"><div class="v2-shell v2-two-grid"><article class="v2-prose"><p class="v2-eyebrow">{t('公司使命','MISSION')}</p><h2>{t('研發能理解、學習並與人協作的智慧系統。','Develop intelligent systems that understand, learn and collaborate with people.')}</h2><p>{t('我們從企業工作中的真實問題出發，也探索智慧系統如何在家庭與高風險環境中安全運作。','We begin with real enterprise work problems and explore how intelligent systems can operate safely in homes and high-risk environments.')}</p></article><article class="v2-prose"><p class="v2-eyebrow">{t('工作原則','WORKING PRINCIPLES')}</p><ul class="v2-check-list"><li>{t('先說價值，再說技術','Explain value before technology')}</li><li>{t('先界定權限，再讓系統行動','Define permissions before action')}</li><li>{t('用證據標示研發狀態','Use evidence to label status')}</li><li>{t('不以 AI 取代人的責任','Do not use AI to replace human responsibility')}</li></ul></article></div></section>}
{page==='contact' && <><ContactInquiryForm locale={locale}/><section class="v2-section"><div class="v2-shell v2-two-grid"><article class="v2-prose"><h2>{t('建議先準備','Useful context')}</h2><ul class="v2-check-list"><li>{t('現在如何完成這項工作','How this work is handled today')}</li><li>{t('最希望改善的結果','The result that matters most')}</li><li>{t('已知的資料、系統或法規限制','Known data, system or regulatory constraints')}</li></ul></article><article class="v2-prose"><h2>{t('我們會先確認','What we review first')}</h2><ul class="v2-check-list"><li>{t('是否符合目前的服務範圍','Whether it fits the current service scope')}</li><li>{t('適合直接、配置或客製導入','Whether to adopt, configure or customize')}</li><li>{t('驗收方式、風險與需要人確認的步驟','Acceptance, risk and required human review')}</li></ul></article></div><div class="v2-shell"><nav class="v2-contact-options" aria-label={t('選擇需求方向','Choose an area')}><h2>{t('或先選擇需求方向','Or begin by choosing an area')}</h2><div>{[
 [t('AI 應用','AI application'),'ai'],
 [t('軟體開發','Software development'),'build'],
 [t('資料整合','Data integration'),'data'],
 [t('區塊鏈應用','Blockchain application'),'chain'],
 [t('其他合作','Other collaboration'),'other'],
 [t('人才交流','Talent conversations'),'talent']
].map(([label,topic])=><a href={`?topic=${topic}#contact-form`}>{label}<span aria-hidden="true">→</span></a>)}</div></nav></div></section></>}
{page!=='contact' && <section class="v2-section v2-contact"><div class="v2-shell v2-contact-inner"><h2>{t('想進一步了解？','Want to explore further?')}</h2><CTA href={`${prefix}contact/`} label={t('洽談合作','Talk with us')} locale={locale}/></div></section>}
