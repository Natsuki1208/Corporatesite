---
import type { SiteLocale } from '../../data/products';
import { simplify } from '../../data/simplified-map';
import { careerRoles, careerText } from '../../data/careers';
import PageHeroVisual from './PageHeroVisual.astro';
const { locale }=Astro.props as {locale:SiteLocale};
const t=(zh:string,en:string)=>locale==='en'?en:locale==='zh-CN'?simplify(zh):zh;
const roleTitle=(role:typeof careerRoles[number])=>careerText(role,'title',locale) as string;
---
<div class="v2-careers">
  <section class="v2-page-hero v2-careers-hero"><div class="v2-shell v2-page-hero-grid"><div class="v2-reveal"><p class="v2-eyebrow">TALENT / {t('人才招募','CAREERS')}</p><h1>{t('一起打造，人與 AI 同行的未來。','Build a future where people and AI move forward together.')}</h1><p>{t('我們尋找能把複雜技術做得可靠、好懂，也真正對人有幫助的夥伴。現階段以人才交流為主。','We are looking for people who can make complex technology reliable, clear and genuinely useful. We are currently focused on meeting future team members.')}</p></div><PageHeroVisual pageKey="careers" alt={t('跨領域團隊共同討論人工智慧產品','A multidisciplinary team discussing artificial intelligence products together')}/></div></section>
  <section class="v2-section"><div class="v2-shell"><header class="v2-section-head v2-reveal"><p class="v2-eyebrow">OPEN DISCUSSIONS</p><h2>{t('我們期待的五種專業夥伴。','Five kinds of expertise we want to meet.')}</h2><p>{t('不只看職稱，也重視你解決問題、與不同專業合作，以及把安全與使用者需要放進設計的方式。','We look beyond titles to how you solve problems, collaborate across disciplines and design for safety and real human needs.')}</p></header><div class="v2-career-list">
    {careerRoles.map((role,index)=><article id={role.slug} class="v2-career-role v2-reveal"><div class="v2-career-role-head"><span>0{index+1}</span><div><p>{locale==='en'?role.titleEn.toUpperCase():t('人才交流','人才交流')}</p><h2>{roleTitle(role)}</h2><p>{careerText(role,'summary',locale)}</p></div></div><div class="v2-career-details"><section><h3>{t('你會參與','WHAT YOU WILL WORK ON')}</h3><ul>{(careerText(role,'responsibilities',locale) as string[]).map(item=><li>{item}</li>)}</ul></section><section><h3>{t('我們期待','SKILLS WE VALUE')}</h3><ul>{(careerText(role,'skills',locale) as string[]).map(item=><li>{item}</li>)}</ul></section></div><a href={`mailto:natsuki12089212@gmail.com?subject=${encodeURIComponent(`Elias Net ${roleTitle(role)} 人才交流`)}`}>{t('聯絡我們','Contact us')} →</a></article>)}
  </div></div></section>
  <section class="v2-section v2-contact"><div class="v2-shell v2-contact-inner"><p class="v2-eyebrow">GROW WITH US</p><h2>{t('還沒有完全符合，也歡迎帶著作品與想法來聊。','Do not match every line? Bring your work and ideas anyway.')}</h2><p>{t('請簡單介紹你的經驗、想投入的方向，以及一項最能代表你的作品或專案。','Tell us about your experience, the direction you want to pursue and one project that best represents your work.')}</p></div></section>
</div>
