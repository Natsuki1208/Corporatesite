---
import type { SiteLocale } from '../../data/products';
import { simplify } from '../../data/simplified-map';
import { careerRoles, careerText } from '../../data/careers';
import PageHeroVisual from './PageHeroVisual.astro';
import CTA from './CTA.astro';
const { locale }=Astro.props as {locale:SiteLocale};
const t=(zh:string,en:string)=>locale==='en'?en:locale==='zh-CN'?simplify(zh):zh;
const roleTitle=(role:typeof careerRoles[number])=>careerText(role,'title',locale) as string;
const base=import.meta.env.BASE_URL.replace(/\/$/,'');
const prefix=locale==='en'?`${base}/en/`:locale==='zh-CN'?`${base}/zh-cn/`:`${base}/`;
---
<div class="v2-careers">
  <section class="v2-page-hero v2-careers-hero"><div class="v2-shell v2-page-hero-grid"><div class="v2-reveal"><p class="v2-eyebrow">TALENT / {t('人才交流','TALENT')}</p><h1>{t('我們想認識能把 AI、軟體與資料做成可靠產品的人。','We want to meet people who turn AI, software and data into reliable products.')}</h1><p>{t('目前以履歷與專業交流為主，尚未開放正式職缺。','We are currently open to professional and resume conversations; no formal vacancies are open yet.')}</p></div><PageHeroVisual pageKey="careers" alt={t('跨領域團隊共同討論人工智慧產品','A multidisciplinary team discussing artificial intelligence products together')}/></div></section>
  <section class="v2-section"><div class="v2-shell"><header class="v2-section-head v2-reveal"><p class="v2-eyebrow">OPEN DISCUSSIONS</p><h2>{t('我們期待的五種專業夥伴。','Five kinds of expertise we want to meet.')}</h2><p>{t('不只看職稱，也重視你解決問題、與不同專業合作，以及把安全與使用者需要放進設計的方式。','We look beyond titles to how you solve problems, collaborate across disciplines and design for safety and real human needs.')}</p></header><div class="v2-career-list">
    {careerRoles.map((role,index)=><article id={role.slug} class="v2-career-role v2-reveal"><div class="v2-career-role-head"><span>0{index+1}</span><div><p>{locale==='en'?role.titleEn.toUpperCase():t('人才交流','人才交流')}</p><h2>{roleTitle(role)}</h2><p>{careerText(role,'summary',locale)}</p></div></div><div class="v2-career-details"><section><h3>{t('你會參與','WHAT YOU WILL WORK ON')}</h3><ul>{(careerText(role,'responsibilities',locale) as string[]).map(item=><li>{item}</li>)}</ul></section><section><h3>{t('我們期待','SKILLS WE VALUE')}</h3><ul>{(careerText(role,'skills',locale) as string[]).map(item=><li>{item}</li>)}</ul></section></div><a href={`${prefix}contact/?topic=talent&role=${encodeURIComponent(roleTitle(role))}#contact-form`}>{t('留下聯絡資訊','Leave your details')} →</a></article>)}
  </div></div></section>
  <section class="v2-section v2-contact"><div class="v2-shell v2-contact-inner"><p class="v2-eyebrow">GROW WITH US</p><h2>{t('不必完全符合每一項條件，也歡迎帶著作品與想法來聊。','You do not need to match every requirement. Bring your work and ideas anyway.')}</h2><p>{t('請簡單介紹你的經驗、想投入的方向，以及一項最能代表你的作品或專案。','Tell us about your experience, the direction you want to pursue and one project that best represents your work.')}</p><CTA href={`${prefix}contact/?topic=talent#contact-form`} label={t('留下聯絡資訊','Leave your details')} locale={locale}/></div></section>
</div>
