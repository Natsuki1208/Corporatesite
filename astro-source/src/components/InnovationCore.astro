---
import type { Locale } from '../data/site';
import { copy, list } from '../data/site';
interface Props { locale: Locale }
const { locale } = Astro.props;
const labels = list(['人員','知識','資料','系統'], ['PEOPLE','KNOWLEDGE','DATA','SYSTEMS'], locale);
---
<div class="innovation-core" data-innovation-core aria-hidden="true">
  <canvas data-core-canvas></canvas>
  <div class="core-labels">{labels.map((label,index) => <span style={`--label-index:${index}`}>{label}</span>)}</div>
  <div class="core-center"><small>ELIAS NET</small><b>AI</b><span>{copy('連接 · 理解 · 參與', 'CONNECT · UNDERSTAND · ENABLE', locale)}</span></div>
  <p>{copy('把企業的人、知識、資料與系統連接起來', 'One connected view of people, knowledge, data and systems', locale)}</p>
</div>
