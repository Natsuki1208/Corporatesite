---
import type { Locale } from '../data/site';
import Header from './Header.astro';
import Hero from './Hero.astro';
import InnovationPromise from './InnovationPromise.astro';
import BusinessProblems from './BusinessProblems.astro';
import Capabilities from './Capabilities.astro';
import WorkScenes from './WorkScenes.astro';
import AdoptionMethod from './AdoptionMethod.astro';
import InnovationCases from './InnovationCases.astro';
import CollaborationEntry from './CollaborationEntry.astro';
import Footer from './Footer.astro';
interface Props { locale: Locale }
const { locale } = Astro.props;
const en = locale === 'en';
---
<a class="skip-link" href="#main">{en ? 'Skip to main content' : '跳到主要內容'}</a>
<Header locale={locale} />
<main id="main">
  <Hero locale={locale} />
  <BusinessProblems locale={locale} />
  <InnovationPromise locale={locale} />
  <WorkScenes locale={locale} />
  <Capabilities locale={locale} />
  <InnovationCases locale={locale} />
  <AdoptionMethod locale={locale} />
  <CollaborationEntry locale={locale} />
</main>
<Footer locale={locale} />
