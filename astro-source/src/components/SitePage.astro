---
import type { Locale } from '../data/site';
import Header from './Header.astro';
import Hero from './Hero.astro';
import Leadership from './Leadership.astro';
import CollaborationEntry from './CollaborationEntry.astro';
import ProductPortfolio from './ProductPortfolio.astro';
import TrustFramework from './TrustFramework.astro';
import Footer from './Footer.astro';
import EnterpriseHome from './EnterpriseHome.astro';
interface Props { locale: Locale }
const { locale } = Astro.props;
const en = locale === 'en';
---
{locale === 'zh-TW' ? <EnterpriseHome /> : <>
  <a class="skip-link" href="#main">{en ? 'Skip to main content' : '跳转到主要内容'}</a>
  <Header locale={locale} />
  <main id="main">
    <Hero locale={locale} />
    <ProductPortfolio locale={locale} />
    <TrustFramework locale={locale} />
    <Leadership locale={locale} />
    <CollaborationEntry locale={locale} />
  </main>
  <Footer locale={locale} />
</>}
