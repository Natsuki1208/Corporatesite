---
import NewSiteLayout from '../layouts/NewSiteLayout.astro'; import InfoPage from '../components/v2/InfoPage.astro';
type PageName='technology'|'safety'|'research'|'about'|'contact';
export function getStaticPaths(){const pageDefs={technology:{title:'技術方向｜Elias Net',description:'理解、協作、感知與行動的技術方向。'},safety:{title:'信任與選擇｜Elias Net',description:'讓人工智慧安心陪伴，並讓每個人保有理解、調整與選擇的空間。'},research:{title:'服務狀態｜Elias Net',description:'說明可直接導入、配置導入與客製整合的適用範圍。'},about:{title:'關於我們｜Elias Net',description:'認識 Elias Net 的 AI 應用、應用軟體、資料整合與合作方式。'},contact:{title:'合作與聯絡｜Elias Net',description:'從工作問題、研究題目或應用情境開始交流。'}};return Object.entries(pageDefs).map(([page,meta])=>({params:{page},props:{page,meta}}))} const {page:rawPage,meta}=Astro.props; const page=rawPage as PageName;
if(page==='about'){const base=import.meta.env.BASE_URL.replace(/\/$/,'');return Astro.redirect(`${base}/company/`,301)}
---
<NewSiteLayout locale="zh-TW" current={page} path={`${page}/`} title={meta.title} description={meta.description}><InfoPage locale="zh-TW" page={page}/></NewSiteLayout>
