---
import NewSiteLayout from '../../../layouts/NewSiteLayout.astro'; import ProductPage from '../../../components/v2/ProductPage.astro'; import { products,l } from '../../../data/products';
export function getStaticPaths(){return products.map((product)=>({params:{slug:product.slug},props:{product}}))} const {product}=Astro.props;
---
<NewSiteLayout locale="zh-CN" path={`products/${product.slug}/`} title={`${product.name}｜Elias Net`} description={l(product.intro,'zh-CN')}><ProductPage product={product} locale="zh-CN"/></NewSiteLayout>
