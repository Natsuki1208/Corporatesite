---
import NewSiteLayout from '../../layouts/NewSiteLayout.astro'; import InfoPage from '../../components/v2/InfoPage.astro';
type PageName='technology'|'safety'|'research'|'about'|'contact';
export function getStaticPaths(){const pageDefs={technology:{title:'技术方向｜Elias Net',description:'理解、协作、感知与行动的技术方向。'},safety:{title:'信任与选择｜Elias Net',description:'让人工智能安心陪伴，并让每个人保有理解、调整与选择的空间。'},research:{title:'服务状态｜Elias Net',description:'说明直接导入、配置部署与定制集成的适用范围。'},about:{title:'关于我们｜Elias Net',description:'认识 Elias Net 的 AI 应用、应用软件、数据集成与合作方式。'},contact:{title:'合作与联系｜Elias Net',description:'从工作问题、研究题目或应用场景开始交流。'}};return Object.entries(pageDefs).map(([page,meta])=>({params:{page},props:{page,meta}}))} const {page:rawPage,meta}=Astro.props; const page=rawPage as PageName;
if(page==='about'){const base=import.meta.env.BASE_URL.replace(/\/$/,'');return Astro.redirect(`${base}/zh-cn/company/`,301)}
---
<NewSiteLayout locale="zh-CN" current={page} path={`${page}/`} title={meta.title} description={meta.description}><InfoPage locale="zh-CN" page={page}/></NewSiteLayout>
